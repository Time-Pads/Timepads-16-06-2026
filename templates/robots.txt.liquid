# we use Shopify as our ecommerce platform

{%- for group in robots.default_groups -%}
  {{- group.user_agent -}}

  {%- for rule in group.rules -%}
    {%- assign rule_val = rule.value -%}
    {%- unless rule.directive == 'Disallow' and rule_val == '/policies' or rule_val == '/policies/' or rule_val == '/*/policies' or rule_val == '/*/policies/' -%}
      {{- rule -}}
    {%- endunless -%}
  {%- endfor -%}

  {%- assign group_is_blocked = false -%}
  {%- for rule in group.rules -%}
    {%- if rule.directive == 'Disallow' and rule.value == '/' -%}
      {%- assign group_is_blocked = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- unless group_is_blocked -%}
    # Extra rules to block standard utility URLs while allowing products/collections
    Disallow: /cart/*
    Disallow: /*add-to-cart*
    Disallow: /account/*
    Disallow: /checkouts/*
    Disallow: /checkout/*
    Disallow: /search
    Disallow: /search/*
    Disallow: /challenge
    Disallow: /challenge/*
    Disallow: /*?*sort_by=
    Disallow: /*?*filter.*
  {%- endunless -%}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{%- endfor -%}