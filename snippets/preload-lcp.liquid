{%- if request.page_type == 'product' -%}
  {%- comment -%}
    LCP preload for product pages.
    The first image is rendered at width: 800 (desktop) / width: 400 (mobile)
    by media.liquid + image.liquid. The preload MUST match these exact URLs.
  {%- endcomment -%}
  {%- assign lcp_img = product.selected_or_first_available_variant.featured_image
                       | default: product.featured_media.preview_image
                       | default: product.media[0].preview_image
                       | default: product.images[0] -%}

  {%- if lcp_img != blank -%}
    {%- comment -%} Desktop: AVIF preload {%- endcomment -%}
    <link
      rel="preload"
      as="image"
      type="image/avif"
      fetchpriority="high"
      media="(min-width: 768px)"
      href="{{ lcp_img | image_url: width: 800, format: 'avif' }}"
      imagesrcset="{{ lcp_img | image_url: width: 400, format: 'avif' }} 400w,
                   {{ lcp_img | image_url: width: 640, format: 'avif' }} 640w,
                   {{ lcp_img | image_url: width: 800, format: 'avif' }} 800w"
      imagesizes="(max-width: 768px) 100vw, 50vw"
    >
    {%- comment -%} Desktop: WebP preload {%- endcomment -%}
    <link
      rel="preload"
      as="image"
      type="image/webp"
      fetchpriority="high"
      media="(min-width: 768px)"
      href="{{ lcp_img | image_url: width: 800, format: 'webp' }}"
      imagesrcset="{{ lcp_img | image_url: width: 400, format: 'webp' }} 400w,
                   {{ lcp_img | image_url: width: 640, format: 'webp' }} 640w,
                   {{ lcp_img | image_url: width: 800, format: 'webp' }} 800w"
      imagesizes="(max-width: 768px) 100vw, 50vw"
    >
    {%- comment -%} Mobile: AVIF preload {%- endcomment -%}
    <link
      rel="preload"
      as="image"
      type="image/avif"
      fetchpriority="high"
      media="(max-width: 767px)"
      href="{{ lcp_img | image_url: width: 400, format: 'avif' }}"
      imagesrcset="{{ lcp_img | image_url: width: 300, format: 'avif' }} 300w,
                   {{ lcp_img | image_url: width: 400, format: 'avif' }} 400w,
                   {{ lcp_img | image_url: width: 640, format: 'avif' }} 640w"
      imagesizes="100vw"
    >
    {%- comment -%} Mobile: WebP preload {%- endcomment -%}
    <link
      rel="preload"
      as="image"
      type="image/webp"
      fetchpriority="high"
      media="(max-width: 767px)"
      href="{{ lcp_img | image_url: width: 400, format: 'webp' }}"
      imagesrcset="{{ lcp_img | image_url: width: 300, format: 'webp' }} 300w,
                   {{ lcp_img | image_url: width: 400, format: 'webp' }} 400w,
                   {{ lcp_img | image_url: width: 640, format: 'webp' }} 640w"
      imagesizes="100vw"
    >
  {%- endif -%}
{%- elsif request.page_type == 'collection' -%}
  {%- comment -%} Collection LCP preload is handled directly in theme.liquid {%- endcomment -%}
{%- elsif request.page_type == 'index' -%}
  {%- assign lcp_desktop = settings.preload_image_desktop -%}
  {%- assign lcp_mobile = settings.preload_image_mobile -%}
 
  {%- if lcp_desktop != blank or lcp_mobile != blank -%}
    {%- comment -%} Mobile preload (max-width: 767px) {%- endcomment -%}
    {%- if lcp_mobile != blank -%}
      <link
        rel="preload"
        as="image"
        type="image/webp"
        fetchpriority="high"
        media="(max-width: 767px)"
        href="{{ lcp_mobile | image_url: width: 550, format: 'webp', quality: 40 }}"
        imagesrcset="{{ lcp_mobile | image_url: width: 375, format: 'webp', quality: 40 }} 375w, {{ lcp_mobile | image_url: width: 550, format: 'webp', quality: 40 }} 550w, {{ lcp_mobile | image_url: width: 750, format: 'webp', quality: 40 }} 750w"
        imagesizes="100vw"
      >
    {%- endif -%}
 
    {%- comment -%} Desktop preload (min-width: 768px) {%- endcomment -%}
    {%- if lcp_desktop != blank -%}
      <link
        rel="preload"
        as="image"
        type="image/webp"
        fetchpriority="high"
        media="(min-width: 768px)"
        href="{{ lcp_desktop | image_url: width: 1440, format: 'webp', quality: 50 }}"
        imagesrcset="{{ lcp_desktop | image_url: width: 750, format: 'webp', quality: 50 }} 750w, {{ lcp_desktop | image_url: width: 1100, format: 'webp', quality: 50 }} 1100w, {{ lcp_desktop | image_url: width: 1440, format: 'webp', quality: 50 }} 1440w, {{ lcp_desktop | image_url: width: 1920, format: 'webp', quality: 50 }} 1920w"
        imagesizes="100vw"
      >
    {%- endif -%}
  {%- endif -%}

{%- endif -%}
