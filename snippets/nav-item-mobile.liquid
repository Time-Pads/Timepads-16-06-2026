<!-- /snippets/nav-item-mobile.liquid -->

{%- liquid
  assign expands = false
  assign block_count = 0
  assign link_level = link_level | default: 0
  assign link_level_next = link_level | plus: 1

  # we loop through this snippet in the secondary menu, but blocks are not shown there
  assign show_block_content = true
  if secondary_menu
    assign show_block_content = false
  endif

  if section and show_block_content
    assign index = index | append: ""
    for block in section.blocks
      if block.settings.position == index
        assign display = block.settings.display | default: 'all'
        if display == 'desktop'
          continue
        endif

        if block.type == 'collection'
          assign block_count = block_count | plus: block.settings.limit
        else
          assign block_count = block_count | plus: 1
        endif
      endif
    endfor
  endif

  if link.levels > 0 or block_count > 0
    assign expands = true
    assign key = link.url | append: link.title | append: link.levels | append: index | md5
  endif

  assign link_title_handle = link.title | handle
  assign highlight_links = 'general.header.highlight_links' | t | strip | split: ',' | join: '___' | handle | replace: '___-', '___' | replace: '-___', '___' | split: '___'
  assign collections_string = '/collections/'
-%}

{%- capture link_thumbnail -%}
  {%- assign link_title_dc = link.title | downcase -%}
  {%- assign item_bg = '#FAF5F0' -%}
  {%- assign is_shop_all = false -%}

  {%- if link_title_dc contains 'cream' or link_title_dc contains 'cramp' or link_title_dc contains 'pain' -%}
    {%- assign item_bg = '#EDF7F2' -%}
    {%- assign item_image = all_products['period-pain-relief-cream-oil'].featured_image | default: collections['all'].products.first.featured_image -%}
  {%- elsif link_title_dc contains 'cup' -%}
    {%- assign item_bg = '#FAF2EA' -%}
    {%- assign item_image = all_products['menstrual-cup'].featured_image | default: collections['all'].products.first.featured_image -%}
  {%- elsif link_title_dc contains 'best' or link_title_dc contains 'seller' -%}
    {%- assign item_bg = '#FFF1EB' -%}
    {%- assign item_image = collections['cotton-sanitary-pads'].image | default: collections['cotton-sanitary-pads'].products.first.featured_image | default: collections['all'].products.first.featured_image -%}
  {%- elsif link_title_dc contains 'arrival' or link_title_dc contains 'new' or link_title_dc contains 'deal' -%}
    {%- assign item_bg = '#FAF2EA' -%}
    {%- assign item_image = all_products['menstrual-cup'].featured_image | default: collections['all'].products[1].featured_image -%}
  {%- elsif link_title_dc contains 'shop all' or link_title_dc == 'shop all' or link_title_dc contains 'all' -%}
    {%- assign item_bg = '#F2ECFA' -%}
    {%- assign is_shop_all = true -%}
  {%- else -%}
    {%- if link.type == 'product_link' and link.object.featured_image != blank -%}
      {%- assign item_image = link.object.featured_image -%}
    {%- elsif link.type == 'collection_link' -%}
      {%- assign item_image = link.object.image | default: link.object.products.first.featured_image -%}
    {%- elsif link.url contains '/products/' -%}
      {%- assign p_handle = link.url | split: '/products/' | last | split: '?' | split: '#' | first -%}
      {%- assign p_obj = all_products[p_handle] -%}
      {%- if p_obj != blank and p_obj.featured_image != blank -%}
        {%- assign item_image = p_obj.featured_image -%}
      {%- endif -%}
    {%- elsif link.url contains '/collections/' -%}
      {%- assign c_handle = link.url | split: '/collections/' | last | split: '?' | split: '#' | first -%}
      {%- assign c_obj = collections[c_handle] -%}
      {%- if c_obj != blank -%}
        {%- assign item_image = c_obj.image | default: c_obj.products.first.featured_image -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- if is_shop_all -%}
    <span class="sliderow__thumb" style="background-color: {{ item_bg }};">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#A855F7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M12 11.5c-.8-.8-2 0-2 .8 0 1.2 2 2.7 2 2.7s2-1.5 2-2.7c0-.8-1.2-1.6-2-.8z" fill="#EC4899" stroke="#EC4899"></path>
      </svg>
    </span>
  {%- elsif item_image != blank -%}
    <span class="sliderow__thumb" style="background-color: {{ item_bg }};">
      <img src="{{ item_image | image_url: width: 100, height: 100, crop: 'center' }}"
           alt="{{ link.title | escape }}"
           class="sliderow__thumb-img"
           loading="lazy"
           width="48"
           height="48">
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- capture link_content_inner -%}
  <div class="sliderow__content">
    {{ link_thumbnail }}
    <div class="sliderow__text-group">
      {%- if link.title == 'New Arrivals' or link.title contains 'Arrival' -%}
        <span class="combo-highlight-tag">BEST DEALS</span>
      {%- endif -%}
      <span class="sliderow__title-text">{{ link.title | strip_html | escape }}</span>
    </div>
  </div>
  <span class="sliderow__arrow" aria-hidden="true">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </span>
{%- endcapture -%}

<div class="sliderule__wrapper {% if link.title == "Subscription" %} Subscription-menu {% endif %}{% if secondary_menu %} sliderule__wrapper--secondary{% endif %}">
  {%- if expands -%}
    <button class="sliderow{% if secondary_menu %} sliderow--secondary{% endif %}"
      data-animates="{{ link_level }}"
      data-sliderule-open="sliderule-{{ key }}">
      {{ link_content_inner }}
    </button>

    <div class="mobile__menu__dropdown sliderule__panel"
      data-sliderule
      id="sliderule-{{ key }}">

      {%- assign image_html = '' -%}
      {%- if link_level_next == 2 and section.settings.show_collection_images and link.url contains collections_string -%}
        {%- assign collection_string = link.url | split: collections_string | last -%}
        {%- assign collection_obj = collections[collection_string] -%}

        {%- if collection_obj.image != blank -%}
          {%- capture image_html -%}
            <div class="sliderule__image" data-animates>
              {%- render 'image',
                cover: true,
                img_object: collection_obj.image,
                wh_ratio: section.settings.collection_wh_ratio,
                sizes: '100vw',
                loading: 'lazy'
              -%}
            </div>
          {%- endcapture -%}
        {%- endif -%}
      {%- endif -%}

      <div class="sliderow{% if image_html != '' %} sliderow--borderless{% endif %} sliderow__back" data-animates="{{ link_level_next }}">
        <button class="drawer__button"
          data-sliderule-close="sliderule-{{ key }}">
          <span class="sliderule__chevron--left">
            {% render 'icon-core-chevron-left' %}
            <span class="visually-hidden">{{ 'general.accessibility.hide_menu' | t }}</span>
          </span>
        </button>
        <span class="sliderow__title-text">{{ link.title | strip_html | escape }}</span>
      </div>

      {%- if image_html != '' -%}
        {{ image_html }}
      {%- endif -%}

      <div class="sliderow__links" data-links>
        {% for link in link.links %}
          {% assign index_recursive = index | append: 'x' | append: forloop.index %}
          {% render 'nav-item-mobile', link: link, index: index_recursive, link_level: link_level_next %}
        {% endfor %}
      </div>

      {%- if section and show_block_content -%}
        <div class="sliderule-grid blocks-{{ block_count }}">
          {% for block in section.blocks %}
            {%- if block.settings.position == index -%}
              {% render 'header-block', block: block, mobile: true %}
            {%- endif -%}
          {% endfor %}
        </div>
      {%- endif -%}

    </div>
  {%- else -%}
    {% comment %} Single menu item, no nesting {% endcomment %}
    <a href="{{ link.url }}" class="sliderow {% if link.title == "Subscription" %} Subscription {% endif %}" data-animates="{{ link_level }}" >
      {{ link_content_inner }}
    </a>
  {%- endif -%}
</div>
