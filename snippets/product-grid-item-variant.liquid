<script>
(function(){
  function fmt(c){ var r=c/100; return r%1===0 ? '₹'+r : '₹'+r.toFixed(2).replace(/\.00$/,''); }
  document.addEventListener('change', function(e){
    var input = e.target.closest('.variant-radio-input');
    if(!input) return;
    var card = input.closest('product-grid-item-variant');
    if(!card) return;
    var vid = input.dataset.variantId || input.getAttribute('data-variant-id');
    var jsonEl = card.querySelector('script[data-product-variants]');
    if(!jsonEl) return;
    try{
      var vars = JSON.parse(jsonEl.textContent);
      var v = null;
      for(var i=0;i<vars.length;i++){ if(String(vars[i].id)===String(vid)){ v=vars[i]; break; } }
      if(!v) return;
      var priceEl = card.querySelector('.add-to-cart-button-card .price');
      var compEl = card.querySelector('.add-to-cart-button-card .compare-at');
      var discEl = card.querySelector('.pgiv-discount-pill');
      var saveEl = card.querySelector('.pgiv-save-pill');
      if(priceEl) priceEl.textContent = fmt(v.price);
      if(compEl){
        if(v.compare_at_price && v.compare_at_price>v.price){ compEl.textContent = fmt(v.compare_at_price); compEl.style.display=''; } else if(compEl){ compEl.style.display='none'; }
      }
      if(discEl){
        if(v.compare_at_price && v.compare_at_price>v.price){ var d=Math.round((v.compare_at_price - v.price)*100 / v.compare_at_price); discEl.textContent=d+'% OFF'; discEl.style.display=''; } else { discEl.style.display='none'; }
      }
      if(saveEl){
        if(v.compare_at_price && v.compare_at_price>v.price){ var s=v.compare_at_price - v.price; saveEl.textContent='You Save '+fmt(s); saveEl.style.display=''; } else { saveEl.style.display='none'; }
      }
    }catch(err){}
  });
})();
</script>

