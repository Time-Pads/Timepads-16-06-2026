                <div class="tp-sibling-footer">
                  <span class="tp-sibling-price sibling-price">{{ sib.price | money }}</span>
                  <span class="tp-sibling-btn">View</span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </details>
  {%- endif -%}

