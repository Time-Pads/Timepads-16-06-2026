<!-- /snippets/pdp-additions.liquid -->

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign prod_type_down = product.type | downcase
  assign prod_handle = product.handle

  # Determine product category for dynamic FAQs
  assign cat_pads = false
  assign cat_cup = false
  assign cat_cream = false

  if prod_type_down contains 'cup' or prod_handle contains 'cup'
    assign cat_cup = true
  elsif prod_type_down contains 'cream' or prod_type_down contains 'pain' or prod_handle contains 'cream' or prod_handle contains 'pain'
    assign cat_cream = true
  else
    assign cat_pads = true
  endif
-%}

<style>
  /* Dynamic Accordion & Benefits Styles for pdp-additions */
  .pdp-accordion-item {
    position: relative !important;
    border: 1px solid #ECECEC !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    box-shadow: none !important;
    margin-bottom: 8px !important;
    background: #FFFFFF !important;
    transition: border-color 0.2s ease !important;
  }
  .pdp-accordion-item[open] { border-color: #D5EBDC !important; }
  .product-summary {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 14.5px !important;
    font-weight: 700 !important;
    padding: 13px 16px !important;
    background-color: #FFFFFF !important;
    color: #1A202C !important;
    cursor: pointer !important;
    border: none !important;
    list-style: none !important;
    user-select: none !important;
  }
  .product-summary::-webkit-details-marker { display: none !important; }
  .tp-acc-title-wrap { display: flex !important; align-items: center !important; gap: 10px !important; }
  .tp-acc-icon { display: inline-flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; }
  .tp-acc-chevron {
    transition: transform 0.25s ease !important;
    flex-shrink: 0 !important;
  }
  details[open] .tp-acc-chevron { transform: rotate(180deg) !important; }
  .pdp-accordion-content {
    padding: 14px 16px !important;
    font-size: 13px !important;
    line-height: 1.6 !important;
    color: #444444 !important;
    background: #FFFFFF !important;
    border-top: 1px solid #ECECEC !important;
  }
  .tp-benefits-strip-card {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    background: #EDF7F2 !important;
    border: 1px solid #D9ECE1 !important;
    border-radius: 14px !important;
    padding: 14px 6px !important;
    margin-top: 14px !important;
    margin-bottom: 20px !important;
    box-sizing: border-box !important;
  }
  .tp-benefits-strip-card__col {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    position: relative !important;
    padding: 0 4px !important;
  }
  .tp-benefits-strip-card__col:not(:last-child)::after {
    content: "" !important;
    position: absolute !important;
    right: 0 !important;
    top: 12% !important;
    height: 76% !important;
    width: 1px !important;
    background: #D4E8DC !important;
  }
  .tp-benefits-strip-card__icon-wrap {
    width: 44px !important;
    height: 44px !important;
    border-radius: 50% !important;
    background: #FFFFFF !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-bottom: 8px !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04) !important;
  }
  .tp-benefits-strip-card__label {
    font-size: 11px !important;
    font-weight: 700 !important;
    color: #164A36 !important;
    line-height: 1.25 !important;
  }
</style>

<div class="pdp-additions-wrapper" style="margin-top: 10px;">
  
  <!-- 1. Specification Table -->
  <details class="product-details pdp-accordion-item">
    <summary class="product-summary">
      <span class="tp-acc-title-wrap">
        <span class="tp-acc-icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            <line x1="9" y1="11" x2="15" y2="11"></line>
            <line x1="9" y1="15" x2="15" y2="15"></line>
          </svg>
        </span>
        Product Specifications
      </span>
      <svg class="tp-acc-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <div class="pdp-accordion-content">
      <table class="spec-table" style="width: 100%; border-collapse: collapse;">
        {%- if product.vendor != blank -%}
          <tr style="border-bottom: 1px solid #f4f4f4;">
            <td class="spec-label" style="padding: 8px 0; font-weight: 600; color: #555; width: 45%;">Brand</td>
            <td class="spec-val" style="padding: 8px 0; color: #222;">{{ product.vendor }}</td>
          </tr>
        {%- endif -%}
        {%- if product.type != blank -%}
          <tr style="border-bottom: 1px solid #f4f4f4;">
            <td class="spec-label" style="padding: 8px 0; font-weight: 600; color: #555;">Category</td>
            <td class="spec-val" style="padding: 8px 0; color: #222;">{{ product.type }}</td>
          </tr>
        {%- endif -%}
        {%- if current_variant.sku != blank -%}
          <tr style="border-bottom: 1px solid #f4f4f4;">
            <td class="spec-label" style="padding: 8px 0; font-weight: 600; color: #555;">SKU</td>
            <td class="spec-val" style="padding: 8px 0; color: #222;">{{ current_variant.sku }}</td>
          </tr>
        {%- endif -%}
        
        {%- liquid
          assign material_val = product.metafields.custom.material.value | default: product.metafields.custom.material
          if material_val == blank
            if cat_pads
              assign material_val = "Premium organic cotton top cover, super-absorbent core"
            elsif cat_cup
              assign material_val = "100% Medical-grade liquid silicone"
            elsif cat_cream
              assign material_val = "Natural Ayurvedic formulation"
            endif
          endif
        -%}
        {%- if material_val != blank -%}
          <tr style="border-bottom: 1px solid #f4f4f4;">
            <td class="spec-label" style="padding: 8px 0; font-weight: 600; color: #555;">Material</td>
            <td class="spec-val" style="padding: 8px 0; color: #222;">{{ material_val }}</td>
          </tr>
        {%- endif -%}

        {%- liquid
          assign size_val = ""
          for option in product.options_with_values
            assign opt_name = option.name | downcase
            if opt_name contains 'size' or opt_name contains 'dimension'
              assign size_val = current_variant.options[forloop.index0]
            endif
          endfor
        -%}
        {%- if size_val != blank -%}
          <tr style="border-bottom: 1px solid #f4f4f4;">
            <td class="spec-label" style="padding: 8px 0; font-weight: 600; color: #555;">Size / Dimension</td>
            <td class="spec-val" style="padding: 8px 0; color: #222;">{{ size_val }}</td>
          </tr>
        {%- endif -%}

        {%- liquid
          assign usage_val = product.metafields.custom.usage.value | default: product.metafields.custom.usage
          if usage_val == blank
            if cat_pads
              if product.title contains 'Overnight' or product.title contains 'XXL'
                assign usage_val = "Heavy Flow (Overnight & Day Wear)"
              else
                assign usage_val = "Medium to Regular Flow (Day Wear)"
              endif
            elsif cat_cup
              assign usage_val = "12 Hours Leak-Proof Protection"
            elsif cat_cream
              assign usage_val = "External application for cramp relief"
            endif
          endif
        -%}
        {%- if usage_val != blank -%}
          <tr>
            <td class="spec-label" style="padding: 8px 0; font-weight: 600; color: #555;">Recommended Usage</td>
            <td class="spec-val" style="padding: 8px 0; color: #222;">{{ usage_val }}</td>
          </tr>
        {%- endif -%}
      </table>
    </div>
  </details>

  <!-- 2. "Who This Is For" Section -->
  <details class="product-details pdp-accordion-item">
    <summary class="product-summary">
      <span class="tp-acc-title-wrap">
        <span class="tp-acc-icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#164A36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
        </span>
        Who This Is For
      </span>
      <svg class="tp-acc-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <div class="pdp-accordion-content">
      <ul class="who-list" style="list-style: none; padding: 0; margin: 0;">
        {%- if cat_pads -%}
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Skin-friendly, completely rash-free period experience.</li>
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Heavy flows requiring secure leak-proof protection.</li>
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Active comfort with breathable, ultra-soft layers.</li>
        {%- elsif cat_cup -%}
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Transition to an eco-friendly, zero-waste period.</li>
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Active users requiring 12 hours of secure hold.</li>
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Chemical-free protection respecting natural pH.</li>
        {%- elsif cat_cream -%}
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Individuals suffering from painful menstrual cramps.</li>
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Fast-acting Ayurvedic relief without pills.</li>
          <li style="margin-bottom: 10px; padding-left: 20px; position: relative;">✓ Portable, mess-free cramp relief solution.</li>
        {%- endif -%}
      </ul>
    </div>
  </details>

  <!-- 3. Dynamic FAQ Section -->
  {%- liquid
    if cat_pads
      assign q1 = "What is this product?"
      assign a1 = "Premium, rash-free sanitary pads designed with an ultra-soft cotton cover for high comfort and superior leak protection."
      assign q2 = "Who is it suitable for?"
      assign a2 = "Suitable for women and teens of all age groups, specifically optimized to protect sensitive skin from friction rashes."
      assign q3 = "How should it be used?"
      assign a3 = "Peel the paper backing, press the pad firmly into undergarment. Change every 4 to 6 hours for optimal hygiene."
      assign q4 = "What makes it different?"
      assign a4 = "Features an ultra-breathable organic cotton top-sheet and specialized absorbency layers to prevent rash and irritation."
      assign q5 = "Can it be worn overnight?"
      assign a5 = "Yes, our XL+ and XXL+ sizes feature wider back wings that are designed specifically to prevent leakages during sleep."
    elsif cat_cup
      assign q1 = "What is this product?"
      assign a1 = "A reusable menstrual cup made of 100% medical-grade silicone that offers safe, leak-proof period protection."
      assign q2 = "Who is it suitable for?"
      assign a2 = "Suitable for all menstruators looking for a comfortable, cost-effective, and environmentally friendly period solution."
      assign q3 = "How should it be used?"
      assign a3 = "Sterilize in boiling water first. Fold, insert gently, and let it pop open to form a seal. Empty every 8 to 12 hours."
      assign q4 = "What makes it different?"
      assign a4 = "Made of medical-grade silicone, reusable for up to 10 years, and contains absolutely zero toxins or bleaching agents."
      assign q5 = "How do I choose the right size?"
      assign a5 = "S is for teenagers, M is for women who haven't given birth, and L is for mothers or heavy flow."
    elsif cat_cream
      assign q1 = "What is this product?"
      assign a1 = "A fast-acting Ayurvedic cramp relief cream formulated specifically to alleviate menstrual cramps and backaches."
      assign q2 = "Who is it suitable for?"
      assign a2 = "Suitable for anyone experiencing lower abdomen or back pain during their menstrual cycle."
      assign q3 = "How should it be used?"
      assign a3 = "Apply a thin layer to lower abdomen or back, and massage gently until absorbed."
      assign q4 = "What makes it different?"
      assign a4 = "Uses a natural Ayurvedic blend of herbal extracts that provides warmth and relief without any greasy residue."
      assign q5 = "Is it safe to use daily?"
      assign a5 = "Yes, completely safe and natural. We recommend a patch test before first use."
    endif
  -%}

  <details class="product-details pdp-accordion-item">
    <summary class="product-summary">
      <span class="tp-acc-title-wrap">
        <span class="tp-acc-icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </span>
        Frequently Asked Questions
      </span>
      <svg class="tp-acc-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>
    <div class="pdp-accordion-content" style="padding: 10px 15px;">
      <div class="faq-accordion-group">
        <div class="faq-accordion" style="border-bottom: 1px solid #eee; padding: 10px 0;">
          <h4 style="margin: 0 0 6px 0; font-size: 14px; font-weight: 700;">{{ q1 }}</h4>
          <p style="margin: 0; font-size: 13px; color: #555;">{{ a1 }}</p>
        </div>
        <div class="faq-accordion" style="border-bottom: 1px solid #eee; padding: 10px 0;">
          <h4 style="margin: 0 0 6px 0; font-size: 14px; font-weight: 700;">{{ q2 }}</h4>
          <p style="margin: 0; font-size: 13px; color: #555;">{{ a2 }}</p>
        </div>
        <div class="faq-accordion" style="border-bottom: 1px solid #eee; padding: 10px 0;">
          <h4 style="margin: 0 0 6px 0; font-size: 14px; font-weight: 700;">{{ q3 }}</h4>
          <p style="margin: 0; font-size: 13px; color: #555;">{{ a3 }}</p>
        </div>
        <div class="faq-accordion" style="border-bottom: 1px solid #eee; padding: 10px 0;">
          <h4 style="margin: 0 0 6px 0; font-size: 14px; font-weight: 700;">{{ q4 }}</h4>
          <p style="margin: 0; font-size: 13px; color: #555;">{{ a4 }}</p>
        </div>
        <div class="faq-accordion" style="padding: 10px 0 0 0;">
          <h4 style="margin: 0 0 6px 0; font-size: 14px; font-weight: 700;">{{ q5 }}</h4>
          <p style="margin: 0; font-size: 13px; color: #555;">{{ a5 }}</p>
        </div>
      </div>
    </div>
  </details>

  <!-- 4. Sibling Cross-links -->
  {%- liquid
    assign related_col = product.collections | first
    assign sibling_count = 0
  -%}
  {%- if related_col.products.size > 1 -%}
    <details class="product-details pdp-accordion-item">
      <summary class="product-summary">
        <span class="tp-acc-title-wrap">
          <span class="tp-acc-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </span>
          Explore Sibling Products
        </span>
        <svg class="tp-acc-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </summary>
      <div class="pdp-accordion-content">
        <div class="siblings-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
          {%- for sib in related_col.products -%}
            {%- if sib.handle != product.handle and sibling_count < 3 -%}
              {%- assign sibling_count = sibling_count | plus: 1 -%}
              <a href="{{ sib.url }}" class="sibling-card" style="text-align: center; text-decoration: none; display: block; border: 1px solid #eee; border-radius: 6px; padding: 6px; background: #fafafa;">
                <div class="sibling-img-wrapper" style="position: relative; padding-bottom: 100%; overflow: hidden; border-radius: 4px;">
                  <img src="{{ sib.featured_image | image_url: width: 400 }}" alt="{{ sib.title | escape }}" style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;" loading="lazy">
                </div>
                <h5 style="font-size: 11px; margin: 4px 0; color: #333; height: 32px; overflow: hidden;">{%- render 'clean-product-title', product: sib -%}</h5>
                <span class="sibling-price" style="font-size: 11px; font-weight: bold; color: #ee3d43;">{{ sib.price | money }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </details>
  {%- endif -%}

  <!-- 5. Product Benefits Strip Card (Item 11) -->
  {% comment %} <div class="tp-benefits-strip-card">
    <div class="tp-benefits-strip-card__col">
      <div class="tp-benefits-strip-card__icon-wrap">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11c0 4.5 3.5 8 8 8s8-3.5 8-8H4z"></path>
          <line x1="3" y1="11" x2="21" y2="11"></line>
          <line x1="12" y1="11" x2="12" y2="5"></line>
          <path d="M12 8c-2-2-3.5-1-4.5 1 2 1 3.5 0 4.5-1z"></path>
          <path d="M12 7c2-2 3.5-1 4.5 1-2 1-3.5 0-4.5-1z"></path>
        </svg>
      </div>
      <span class="tp-benefits-strip-card__label">Ayurvedic<br>Care</span>
    </div>
    <div class="tp-benefits-strip-card__col">
      <div class="tp-benefits-strip-card__icon-wrap">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3c-1.5 2-3 3.8-3 5.5a3 3 0 0 0 6 0c0-1.7-1.5-3.5-3-5.5z"></path>
          <path d="M4 14c2.5-1 5.5-1 8 0s5.5 1 8 0"></path>
          <path d="M4 17c2.5-1 5.5-1 8 0s5.5 1 8 0"></path>
          <circle cx="7" cy="20" r="1" fill="#164A36"></circle>
          <circle cx="12" cy="20" r="1" fill="#164A36"></circle>
          <circle cx="17" cy="20" r="1" fill="#164A36"></circle>
        </svg>
      </div>
      <span class="tp-benefits-strip-card__label">Skin<br>Friendly</span>
    </div>
    <div class="tp-benefits-strip-card__col">
      <div class="tp-benefits-strip-card__icon-wrap">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="14" cy="13" r="7"></circle>
          <polyline points="14 10 14 13 16.5 14.5"></polyline>
          <line x1="14" y1="4" x2="14" y2="6"></line>
          <line x1="12" y1="4" x2="16" y2="4"></line>
          <line x1="2" y1="9" x2="6" y2="9"></line>
          <line x1="1" y1="13" x2="5" y2="13"></line>
          <line x1="3" y1="17" x2="6" y2="17"></line>
        </svg>
      </div>
      <span class="tp-benefits-strip-card__label">Instant<br>Relief</span>
    </div>
    <div class="tp-benefits-strip-card__col">
      <div class="tp-benefits-strip-card__icon-wrap">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
          <path d="M15 9c-3 0-5 2-6 5 2.5 0 5-1.5 6-5z"></path>
          <path d="M9 14l3-3"></path>
        </svg>
      </div>
      <span class="tp-benefits-strip-card__label">Moody<br>Free Days</span>
    </div>
  </div> {% endcomment %}

</div>

<!-- 5. Dynamic FAQ Structured Data (Schema JSON-LD) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": {{ q1 | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ a1 | json }}
      }
    },
    {
      "@type": "Question",
      "name": {{ q2 | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ a2 | json }}
      }
    },
    {
      "@type": "Question",
      "name": {{ q3 | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ a3 | json }}
      }
    },
    {
      "@type": "Question",
      "name": {{ q4 | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ a4 | json }}
      }
    },
    {
      "@type": "Question",
      "name": {{ q5 | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ a5 | json }}
      }
    }
  ]
}
</script>
