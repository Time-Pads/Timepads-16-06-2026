{% javascript %}
  document.addEventListener('theme:variant:change', (event) => {
    const section = event.target.closest('[data-section-type="product"]');
    const variant = event.detail?.variant;
    if (!section || !variant) return;

    const specs = section.querySelector('[data-pad-specifications]');
    const template = specs?.querySelector(`template[data-pad-spec-variant="${variant.id}"]`);
    if (!template) return;

    specs.querySelector('[data-pad-spec-rows]').replaceChildren(template.content.cloneNode(true));
    section.querySelectorAll('.tp-pad-guide [data-pad-length]').forEach((option) => {
      if (option.dataset.padLength === template.dataset.padLength) {
        option.setAttribute('aria-current', 'true');
      } else {
        option.removeAttribute('aria-current');
      }
    });
  });
{% endjavascript %}
