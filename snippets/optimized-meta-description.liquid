{%- liquid
  assign description = page_description
  if description == blank
    case request.page_type
      when 'product'
        assign description = product.description
      when 'collection'
        assign description = collection.description
      when 'article'
        assign description = article.excerpt_or_content
      when 'blog'
        assign description = blog.title
      when 'page'
        assign description = page.content
      when 'index'
        assign description = shop.description
    endcase
    assign description = description | strip_html | strip_newlines | strip | default: page_title | default: shop.name | truncate: 160
  endif
  echo description | strip_html | strip
-%}
