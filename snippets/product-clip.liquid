<!-- /snippets/product-clip.liquid -->

{% comment %}
  *  Mini landscape card for upsell and complimentary products.
{% endcomment %}

{%- assign card_product = card_product | default: product -%}
{%- assign card_variant = card_product.selected_or_first_available_variant -%}
{%- assign image = card_product.featured_media.preview_image -%}

<div class="quickview" x-data="productQuickViewButton({{ card_product.id }}, '{{ card_product.handle }}')">
  <div data-quickview-holder="{{ card_product.id }}" data-add-action-wrapper data-error-boundary>
    <div class="product-clip">
      <!-- Left side: Product Image + Save Badge -->
      <div class="product-clip__media">
        {%- if card_variant.compare_at_price > card_variant.price -%}
          {%- assign save_diff = card_variant.compare_at_price | minus: card_variant.price -%}
          {%- assign discount_percent = card_variant.compare_at_price | minus: card_variant.price | times: 100.0 | divided_by: card_variant.compare_at_price | round -%}
          <div class="product-clip__save-badge">{{ discount_percent }}% off</div>
        {%- endif -%}
        
        <a href="{{ card_product.url }}" onclick="window.location.href='{{ card_product.url }}'; return false;" style="pointer-events: auto; cursor: pointer; display: block; width: 100%; height: 100%;">
          {%- if image -%}
            {% assign image_width = 300 | at_most: image.width %}
            {% assign alt = image.alt | default: card_product.title %}
            <img src="{{ image | image_url: width: image_width }}" alt="{{ alt | escape }}" class="product-clip__image__inner" loading="lazy">
          {%- endif -%}
        </a>
      </div>

      <!-- Right side: Product Details, Badges & Action -->
      <div class="product-clip__content">
        <a href="{{ card_product.url }}" onclick="window.location.href='{{ card_product.url }}'; return false;" style="pointer-events: auto; cursor: pointer; text-decoration: none; color: inherit;">
          <div class="product-clip__meta-badges">
            <span class="product-clip__badge-rating">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="#F5A623" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              4.8
            </span>
            <span class="product-clip__badge-count">21 pads</span>
          </div>

          <h3 class="product-clip__title">{{ card_product.title | strip_html }}</h3>

          <div class="product-clip__price">
            {%- if card_variant.compare_at_price > card_variant.price -%}
              <span class="old-price">
                {% if settings.currency_code_enable %}
                  {{ card_variant.compare_at_price | money_with_currency }}
                {% else %}
                  {{ card_variant.compare_at_price | money }}
                {% endif %}
              </span>
            {%- endif -%}
            <span class="new-price">
              {% if settings.currency_code_enable %}
                {{ card_variant.price | money_with_currency }}
              {% else %}
                {{ card_variant.price | money }}
              {% endif %}
            </span>
          </div>
        </a>

        <a href="{{ card_product.url }}" onclick="window.location.href='{{ card_product.url }}'; return false;" class="product-clip__atc-btn" style="text-decoration: none;">
          ADD TO CART
        </a>
      </div>
    </div>
  </div>
</div>
