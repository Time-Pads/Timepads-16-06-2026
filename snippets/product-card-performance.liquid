{%- comment -%}
  TIMEPADS - Performance Product Card Component
  Redesigned to match reference design exactly (Image 2)
  Zero CLS, Lightning Fast & 100% AJAX Add-to-Cart Compatible
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_img = current_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.featured_image
  
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  elsif product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign sold_out = true
  if product.available
    assign sold_out = false
  endif

  assign discount_percent = 0
  if on_sale
    assign comp_price = current_variant.compare_at_price | default: product.compare_at_price
    assign curr_price = current_variant.price | default: product.price
    if comp_price > curr_price
      assign diff = comp_price | minus: curr_price
      assign discount_percent = diff | times: 100 | divided_by: comp_price | round
    endif
  endif
-%}

<dynamic-card class="tp-perf-card{% if sold_out %} tp-perf-card--sold-out{% endif %}" data-product-id="{{ product.id }}">
  <script type="application/json" data-product-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"available":{{ v.available | json }},"price":{{ v.price }},"compare_at_price":{% if v.compare_at_price %}{{ v.compare_at_price }}{% else %}null{% endif %},"options":{{ v.options | json }},"option1":{{ v.option1 | json }},"option2":{{ v.option2 | json }},"option3":{{ v.option3 | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>

  <div class="tp-perf-card__image-container">
    <a href="{{ product.url }}" class="tp-perf-card__image-link" aria-label="{{ product.title | escape }}">
      {%- if featured_img != blank -%}
        {%- assign img_alt = featured_img.alt | default: product.title | escape -%}
        <img
          src="{{ featured_img | image_url: width: 220, format: 'webp', quality: 80 }}"
          srcset="
            {{ featured_img | image_url: width: 180, format: 'webp', quality: 80 }} 180w,
            {{ featured_img | image_url: width: 220, format: 'webp', quality: 80 }} 220w,
            {{ featured_img | image_url: width: 260, format: 'webp', quality: 80 }} 260w,
            {{ featured_img | image_url: width: 300, format: 'webp', quality: 80 }} 300w,
            {{ featured_img | image_url: width: 360, format: 'webp', quality: 80 }} 360w,
            {{ featured_img | image_url: width: 480, format: 'webp', quality: 80 }} 480w
          "
          sizes="(min-width: 1200px) 260px, (min-width: 992px) 220px, (min-width: 768px) 33vw, 110px"
          width="{{ featured_img.width | default: 260 }}"
          height="{{ featured_img.height | default: 260 }}"
          style="width: 100%; height: 100%; aspect-ratio: 1 / 1; object-fit: cover;"
          alt="{{ img_alt }}"
          class="tp-perf-card__image"
          decoding="async"
          {% if eagerload %}
            loading="eager"
            fetchpriority="high"
          {% else %}
            loading="lazy"
          {% endif %}
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'tp-perf-card__image tp-perf-card__image--placeholder' }}
      {%- endif -%}
    </a>

    {%- if sold_out -%}
      <span class="tp-perf-card__badge tp-perf-card__badge--sold">Sold Out</span>
    {%- elsif discount_percent > 0 -%}
    {%- endif -%}
  </div>

  <div class="tp-perf-card__details">
    <a href="{{ product.url }}" class="tp-perf-card__title-link">
      <h3 class="tp-perf-card__title">{{ product.title | escape }}</h3>
    </a>

    <div class="tp-perf-card__options">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="tp-perf-card__option-group" data-option-position="{{ forloop.index }}">
            <span class="tp-perf-card__option-title">
              {%- if option.name contains 'Size' or option.name contains 'size' -%}
                Size
              {%- else -%}
                Available In
              {%- endif -%}
            </span>
            <fieldset class="tp-perf-card__radio-fieldset">
              <legend class="visually-hidden">{{ option.name }}</legend>
              <div class="tp-perf-card__radio-list">
                {%- for value in option.values -%}
                  {%- assign option_index = 'option' | append: forloop.parentloop.index -%}
                  {%- assign variant = product.variants | where: option_index, value | first -%}
                  <span class="tp-perf-card__radio-item">
                    <input
                      type="radio"
                      name="opt-{{ option.name | handleize }}-{{ product.id }}"
                      value="{{ value | escape }}"
                      id="opt-{{ product.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                      data-variant-id="{{ variant.id }}"
                      {% if forloop.first %}checked="checked"{% endif %}
                      class="variant-radio-input tp-perf-card__radio-input"
                    >
                    <label
                      for="opt-{{ product.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                      class="variant-label tp-perf-card__radio-label"
                    >
                      <span>{{ value }}</span>
                    </label>
                  </span>
                {%- endfor -%}
              </div>
            </fieldset>
          </div>
        {%- endfor -%}
      {%- endunless -%}
    </div>

    <div class="tp-perf-card__footer">
      <div class="tp-split-btn-group">
        <div class="tp-split-price">
          <div class="variant-price-wrapper">
            <span class="current-price">
              ₹{{ current_variant.price | divided_by: 100 }}
            </span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="compare-at-price">
                ₹{{ current_variant.compare_at_price | divided_by: 100 }}
              </span>
            {%- endif -%}
          </div>
        </div>

        <div class="tp-split-atc" x-data="productAddButtonForm()">
          {%- form 'product', product, class: 'tp-perf-card__form', data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" class="tp-perf-card__hidden-id">
            
            <button
              type="submit"
              name="add"
              add-to-cart
              data-add-to-cart
              class="add-to-cart-button-for-product-card tp-perf-card__atc-btn"
              data-selected-value-data-value="{{ current_variant.id }}"
              {% if sold_out %}disabled="disabled"{% endif %}
              aria-label="{% if sold_out %}Sold Out{% else %}Add to Cart{% endif %}"
            >
              <span class="btn-state-ready">
                {% if sold_out %}Sold Out{% else %}<span class="mobile-hide">Add to Cart</span><span class="desktop-hide">Add</span>{% endif %}
              </span>
              <span class="btn-state-loading" style="display: none;">
                Adding...
              </span>
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</dynamic-card>

<style>
  .tp-perf-card {
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #E2D3C7;
    padding: 0 0 14px 0;
    position: relative;
    height: 100%;
    box-sizing: border-box;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    overflow: hidden;
    transition: box-shadow 0.15s ease;
    contain-intrinsic-size: 260px 420px;
  }
  .tp-perf-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  /* Full Bleed Image Header */
  .tp-perf-card__image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #F8F8F8;
    contain-intrinsic-size: 260px 260px;
  }
  .tp-perf-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .tp-perf-card__image {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  .tp-perf-card__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 4px;
    text-transform: uppercase;
    z-index: 2;
    line-height: 1;
  }
  .tp-perf-card__badge--sale {
    background-color: #890303;
    color: #FFFFFF;
  }
  .tp-perf-card__badge--sold {
    background-color: #767676;
    color: #FFFFFF;
  }

  /* Card Body */
  .tp-perf-card__details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 14px 14px 0 14px;
  }
  .tp-perf-card__title-link {
    text-decoration: none;
    color: inherit;
  }
  .tp-perf-card__title {
    font-size: 15px;
    font-weight: 600;
    color: #1A1A1A;
    line-height: 1.35;
    margin: 0 0 10px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
  }
@media only screen and (max-width: 749px){
  .tp-perf-card__title{
       font-size: 12px;
    font-weight: 500;
 
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.7em;
  }
}
  /* Variant Options & Pills */
  .tp-perf-card__options {
    margin-bottom: 14px;
    min-height: 48px;
  }
  .tp-perf-card__option-group {
    margin-bottom: 8px;
  }
  .tp-perf-card__option-title {
    font-size: 11px;
    font-weight: 600;
    color: #777777;
    display: block;
    margin-bottom: 4px;
  }
  .tp-perf-card__radio-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }
  .tp-perf-card__radio-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tp-perf-card__radio-item {
    position: relative;
    display: inline-block;
  }
  .tp-perf-card__radio-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    margin: 0;
    pointer-events: none;
  }
  .tp-perf-card__radio-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 6px;
    background-color: #B59E85;
    color: #0f0c0c;
    border: none;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.15s ease;
  }
  .tp-perf-card__radio-input:checked + .tp-perf-card__radio-label {
    background-color: #B59E85 !important;
    color: #070606 !important;
  }

  /* Footer & Unified Split Price / Add-To-Cart Button */
  .tp-perf-card__footer {
    margin-top: auto;
    padding: 0 14px;
  }
  .tp-split-btn-group {
    display: flex;
    align-items: stretch;
    width: 100%;
    height: 44px;
    border-radius: 25px;
    border: 1.5px solid #000000;
    overflow: hidden;
    box-sizing: border-box;
    background-color: #FFFFFF;
  }
  .tp-split-price {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
    border-right: 1.5px solid #000000;
    padding: 0 8px;
    white-space: nowrap;
  }
  .tp-split-price .variant-price-wrapper {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 4px !important;
    width: 100% !important;
    border: none !important;
    background: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #000000 !important;
  }
  .tp-split-price .current-price {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #000000 !important;
    display: inline-block !important;
    width: auto !important;
    font-family: Inter, -apple-system, sans-serif !important;
  }
  .tp-split-price .compare-at-price {
    font-size: 12px !important;
    font-weight: 500 !important;
    color: #888888 !important;
    text-decoration: line-through !important;
    display: inline-block !important;
    margin-left: 3px !important;
    font-family: Inter, -apple-system, sans-serif !important;
  }
  .tp-split-price .offer-percentage {
    display: none !important;
  }

  .tp-split-atc {
    flex: 1.2;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tp-split-atc form {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }
  .tp-perf-card__atc-btn {
    width: 100%;
    height: 100%;
    background-color: #000000;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: Inter, -apple-system, sans-serif;
    transition: background-color 0.15s ease;
  }
  .tp-perf-card__atc-btn:hover:not([disabled]) {
    background-color: #222222;
  }
  .tp-perf-card__atc-btn[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
    background-color: #555555;
  }
</style>

<script>
  (function() {
    if (window.tpPerfCardInit) return;
    window.tpPerfCardInit = true;

    document.addEventListener('change', function(e) {
      if (e.target && e.target.classList.contains('tp-perf-card__radio-input')) {
        var card = e.target.closest('dynamic-card');
        if (!card) return;
        var variantId = e.target.getAttribute('data-variant-id');
        var hiddenInput = card.querySelector('.tp-perf-card__hidden-id');
        var atcBtn = card.querySelector('.tp-perf-card__atc-btn');

        if (hiddenInput && variantId) {
          hiddenInput.value = variantId;
        }
        if (atcBtn && variantId) {
          atcBtn.setAttribute('data-selected-value-data-value', variantId);
        }
      }
    });
  })();
</script>
