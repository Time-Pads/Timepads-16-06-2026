{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Timepads - Sanitary Pads",
      "@id": "https://timepads.in/",
      "url": "https://timepads.in/",
      "telephone": "+91-7975421029",
      "priceRange": "₹40 - ₹525",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "108/H, Bhoomi RMV Stage 2, MLA Layout, Bhoopasandra",
        "addressLocality": "Bangalore",
        "addressRegion": "Karnataka",
        "postalCode": "560094",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 13.0422174,
        "longitude": 77.5700444
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          "opens": "09:30",
          "closes": "18:30"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/timepads",
        "https://www.instagram.com/timepads.in"
      ],
      "description": "Timepads is a Bangalore-based local brand providing premium sanitary pads for women. Our sanitary pads are ultra-thin, rash-free, and made with skin-safe materials. Buy the best sanitary pads online or in-store with doorstep delivery across India."
    }
  </script>
{%- endif -%}

{%- if page.title contains 'FAQs' and page.handle != 'faqs' -%}
  {%- render 'faq-schema' -%}
{%- endif -%}

{%- if request.page_type == 'collection' and collection -%}
  {%- assign faq_questions = collection.metafields.custom.faq_questions.value -%}
  {%- assign faq_answers = collection.metafields.custom.faq_answers.value -%}
  {%- if faq_questions != blank and faq_answers != blank -%}
    {%- assign q_size = faq_questions.size -%}
    {%- assign a_size = faq_answers.size -%}
    {%- assign min_size = q_size -%}
    {%- if a_size < q_size -%}
      {%- assign min_size = a_size -%}
    {%- endif -%}
    {%- if min_size > 0 -%}
      {%- assign limit = min_size | minus: 1 -%}
      {%- assign output_count = 0 -%}
      {%- capture faq_entities -%}
        {%- for i in (0..limit) -%}
          {%- assign q = faq_questions[i] | strip -%}
          {%- assign a = faq_answers[i] | strip -%}
          {%- if q != blank and a != blank -%}
            {%- if output_count > 0 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ q | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ a | json }}
              }
            }
            {%- assign output_count = output_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if output_count > 0 -%}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {{ faq_entities }}
          ]
        }
        </script>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
