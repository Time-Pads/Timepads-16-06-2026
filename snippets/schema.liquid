    {%- if request.page_type == 'article' and article -%}
      {% comment %}
        Article/BlogPosting schema has been relocated to sections/article.liquid to support rich fields (e.g. medical reviewer, FAQs, references) without duplication.
      <script type="application/ld+json">
        {
          "@context":"https://schema.org",
          "@type":"BlogPosting",
          "mainEntityOfPage":{"@type":"WebPage","@id":"{{ article.url | absolute_url }}"},
          "headline":{{ article.title | json }},
          "description":{{ article.excerpt_or_content | strip_html | truncatewords: 50 | json }},
          "image":{"@type":"ImageObject","url":"{{ article.image | img_url: '800x' | absolute_url }}"},
          "author":{"@type":"Organization","name":"Timepads"},
          "publisher":{"@type":"Organization","name":"Timepads","logo":{"@type":"ImageObject","url":"{{ 'timepads_logo.png' | asset_url }}"}},
          "datePublished":"{{ article.published_at | date: "%Y-%m-%d" }}"
        }
      </script>
      {% endcomment %}
    {%- endif -%}

