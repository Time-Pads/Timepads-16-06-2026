    {%- if request.page_type == 'collection' and collection -%}
      {%- assign faq_questions = collection.metafields.custom.faq_questions.value -%}
      {%- assign faq_answers = collection.metafields.custom.faq_answers.value -%}
      {%- if faq_questions != blank and faq_answers != blank -%}
        {%- assign q_size = faq_questions.size -%}
        {%- assign a_size = faq_answers.size -%}
        {%- assign min_size = q_size -%}
        {%- if a_size < q_size -%}
          {%- assign min_size = a_size -%}
        {%- endif -%}
        {%- if min_size > 0 -%}
          {%- assign limit = min_size | minus: 1 -%}
          {%- assign output_count = 0 -%}
          {%- capture faq_entities -%}
            {%- for i in (0..limit) -%}
              {%- assign q = faq_questions[i] | strip -%}
              {%- assign a = faq_answers[i] | strip -%}
              {%- if q != blank and a != blank -%}
                {%- if output_count > 0 -%},{%- endif -%}
                {
                  "@type": "Question",
                  "name": {{ q | json }},
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": {{ a | json }}
                  }
                }
                {%- assign output_count = output_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if output_count > 0 -%}
            <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": [
                {{ faq_entities }}
              ]
            }
            </script>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
