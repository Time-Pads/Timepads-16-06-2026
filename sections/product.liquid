{%- comment -%} All JS in ONE deferred block at the bottom ── {%- endcomment -%}
<script>
(function () {
  'use strict';

  /* ── Product description accordion (description-product block) ── */
  var detailsBtn = document.querySelector('#product-details .read-more-btn');
  if (detailsBtn) {
    detailsBtn.addEventListener('click', function () {
      var excerpt = document.querySelector('#product-details .tp-description-card__excerpt');
      var full = document.querySelector('#product-details .tp-description-card__full-content');
      var expanded = this.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        if (excerpt) excerpt.style.display = 'block';
        if (full) full.style.display = 'none';
        this.innerHTML = 'Read More <span class="arrow">→</span>';
        this.setAttribute('aria-expanded', 'false');
      } else {
        if (excerpt) excerpt.style.display = 'none';
        if (full) full.style.display = 'block';
        this.innerHTML = 'Read Less <span class="arrow">↑</span>';
        this.setAttribute('aria-expanded', 'true');
      }
    });
  }

  /* ── Extra info collapsible (Extrainfo block) ── */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExtras, { once: true });
  } else {
    initExtras();
  }

  function initExtras() {
    var btn = document.querySelector('.collapsible-toggle');
    var desc = document.querySelector('.product-description-text');
    if (!btn || !desc) return;

    btn.addEventListener('click', function () {
      var isCollapsed = this.getAttribute('aria-expanded') === 'false';
      var colText = desc.getAttribute('data-collapsed-text');
      var expText = desc.getAttribute('data-expanded-text');
      var btnSpan = this.closest('span');

      desc.innerHTML = isCollapsed ? expText : colText;
      desc.appendChild(btnSpan);

      this.setAttribute('aria-expanded', isCollapsed ? 'true' : 'false');
      this.textContent = isCollapsed
        ? this.getAttribute('data-expanded-label')
        : this.getAttribute('data-collapsed-label');
    });
  }

  /* ── LiveView custom element ── */
  if (!customElements.get('live-view')) {
    customElements.define('live-view', class extends HTMLElement {
      connectedCallback() {
        this._min      = parseInt(this.dataset.min)  || 10;
        this._max      = parseInt(this.dataset.max)  || 40;
        this._interval = parseInt(this.dataset.interval) || 10;
        this._msg      = this.dataset.message || '[count] people are viewing this right now';
        this._tick();
        this._timer = setInterval(() => this._tick(), this._interval * 1000);
      }
      disconnectedCallback() {
        clearInterval(this._timer); // no memory leak
      }
      _tick() {
        var count = Math.floor(Math.random() * (this._max - this._min + 1)) + this._min;
        this.textContent = this._msg.replace('[count]', count);
      }
    });
  }

  /* ── Judge.me review count display ── */
  function formatJudgemeReviewCount() {
    var badges = document.querySelectorAll('.jdgm-prev-badge, .jdgm-preview-badge');
    badges.forEach(function(badge) {
      var prevBadge = badge.classList.contains('jdgm-prev-badge') ? badge : badge.querySelector('.jdgm-prev-badge');
      if (!prevBadge) return;
      var numReviews = prevBadge.getAttribute('data-number-of-reviews') || prevBadge.dataset.numberOfReviews;
      if (!numReviews) {
        var widget = prevBadge.closest('.jdgm-widget');
        if (widget) numReviews = widget.getAttribute('data-number-of-reviews') || widget.dataset.numberOfReviews;
      }
      if (!numReviews) {
        // Fallback for main product badge
        numReviews = {{ product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 0 | json }};
      }
      
      var textEl = prevBadge.querySelector('.jdgm-prev-badge__text');
      if (numReviews && parseInt(numReviews, 10) > 0) {
        var count = parseInt(numReviews, 10);
        var label = '(' + count + (count === 1 ? ' review' : ' reviews') + ')';
        if (!textEl) {
          textEl = document.createElement('span');
          textEl.className = 'jdgm-prev-badge__text';
          prevBadge.appendChild(textEl);
        }
        if (!textEl.textContent || !textEl.textContent.trim() || textEl.textContent.trim() === 'No reviews') {
          textEl.textContent = label;
        }
        textEl.style.setProperty('display', 'inline-block', 'important');
        textEl.style.setProperty('visibility', 'visible', 'important');
        textEl.style.setProperty('opacity', '1', 'important');
        textEl.style.setProperty('color', '#555555', 'important');
        textEl.style.setProperty('font-size', '13px', 'important');
        textEl.style.setProperty('font-weight', '500', 'important');
        textEl.style.setProperty('margin-left', '4px', 'important');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', formatJudgemeReviewCount);
  } else {
    formatJudgemeReviewCount();
  }
  document.addEventListener('jdgm.doneSetup', formatJudgemeReviewCount);

  if (window.MutationObserver) {
    var jmObserver = new MutationObserver(function() {
      formatJudgemeReviewCount();
    });
    var jmTarget = document.querySelector('.product-section');
    if (jmTarget) {
      jmObserver.observe(jmTarget, { childList: true, subtree: true });
    }
  }

}());
</script>

