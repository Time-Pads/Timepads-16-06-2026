    padding: 9px 14px !important;
    gap: 8px !important;
  }
  .tp-delivery-strip__label {
    font-size: 9px !important;
    letter-spacing: 0 !important;
  }
  .tp-delivery-strip__val {
    font-size: 13px !important;
    letter-spacing: 0 !important;
  }
  .tp-delivery-strip__trust-icon-wrap {
