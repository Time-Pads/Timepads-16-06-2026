                          <circle cx="12" cy="12" r="3" fill="#D32F2F"></circle>
                        </svg>
                      </span>
                      <span class="tp-live-view-strip__text"><live-view data-min="10" data-max="40" data-interval="10" data-message="[count] people are viewing this right now">23 people are viewing this right now</live-view></span>
                    </div>
                    <div class="tp-live-view-strip__divider"></div>
                    <div class="tp-live-view-strip__right">
                      <span class="tp-live-view-strip__badge">Only few left in stock!</span>
                    </div>
