<!-- /sections/product.liquid -->

{%- comment -%} ── JSON-LD structured data — ONE clean block, no duplicates ── {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- liquid
    assign seo_variant = product.selected_or_first_available_variant
    assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
    assign rating_value = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "@id": {{ product.url | absolute_url | json }},
    "name": {{ product.title | json }},
    "image": [
      {%- if product.images.size > 0 -%}
        {%- for img in product.images -%}
          {{ img | image_url: width: 1400 | prepend: "https:" | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- elsif product.featured_image -%}
        {{ product.featured_image | image_url: width: 1400 | prepend: "https:" | json }}
      {%- endif -%}
    ],
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "sku": {{ seo_variant.sku | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: shop.name | json }}
    },
    "offers": {
      "@type": "Offer",
      "url": {{ product.url | absolute_url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ seo_variant.price | divided_by: 100.00 | json }},
      "priceValidUntil": {{ price_valid_until | json }},
      "availability": "{% if seo_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }
    {%- if rating_value != blank and rating_count != blank and rating_count > 0 -%}
    ,
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ rating_value }}",
      "ratingCount": "{{ rating_count }}",
      "bestRating": "{{ rating_value.scale_max | default: 5 }}",
      "worstRating": "{{ rating_value.scale_min | default: 1 }}"
    }
    {%- endif -%}
  }
  </script>
{%- endif -%}

{%- comment -%} ── ALL scoped styles in ONE block at the top ── {%- endcomment -%}
{% style %}
/* Badge */
.badge-bestseller {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgb(255,229,164);
  color: #000;
  font-size: 13px;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 999px;
  line-height: 1;
}

/* Benefit pills continuous scrolling ticker */
.product-benefits {
  width: 100% !important;
  max-width: 100% !important;
  overflow: hidden !important;
  margin: 12px 0 !important;
  position: relative !important;
  padding: 4px 0 !important;
  box-sizing: border-box !important;
  mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent) !important;
  -webkit-mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent) !important;
}
.product-benefits__track {
  display: flex !important;
  flex-wrap: nowrap !important;
  gap: 10px !important;
  width: max-content !important;
  animation: benefitsMarqueeLoop 20s linear infinite !important;
  will-change: transform !important;
}
.product-benefits:hover .product-benefits__track {
  animation-play-state: paused !important;
}
@keyframes benefitsMarqueeLoop {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-50%, 0, 0); }
}
.product-benefits.cup .benefit-pill { font-size: 12px; }
.benefit-pill {
  flex: 0 0 auto !important;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap !important;
  border: 1px solid transparent;
}
.pill-1 { color: #b91c1c; border-color: #f5b5b5; }
.pill-2 { color: #0369a1; border-color: #bae6fd; }
.pill-3 { color: #15803d; border-color: #bbf7d0; }
.pill-4 { color: #6d28d9; border-color: #ddd6fe; }
.pill-5 { color: #c2410c; border-color: #fed7aa; }
.pill-6 { color: #9d174d; border-color: #fbcfe8; }

/* Certificates */
.product-certificates-block { margin: 20px 0; }
.product-certificates-block .certificates-heading { font-size: 16px; font-weight: 600; margin-bottom: 12px; }
.product-certificates-block .certificates-grid { display: flex; gap: 24px; }
.product-certificates-block .certificate-item img { max-width: 80px; height: auto; }

/* Title */
.product__align-left .product__title { font-weight: 500; }

/* ── Urgency Cards ── */
.tp-sales-card {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  background: #FFF8F3 !important;
  border: 1px solid #FFE4CD !important;
  border-radius: 12px !important;
  padding: 8px 10px !important;
  margin-bottom: 8px !important;
  box-sizing: border-box !important;
  cursor: pointer;
  white-space: nowrap !important;
  overflow: hidden !important;
  width: 100% !important;
  gap: 4px !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.tp-sales-card:hover { box-shadow: 0 3px 10px rgba(229, 87, 26, 0.08); }
.tp-sales-card__content { display: flex !important; align-items: center !important; gap: 6px !important; white-space: nowrap !important; flex: 1 !important; min-width: 0 !important; }
.tp-sales-card__icon { font-size: 16px !important; line-height: 1 !important; flex-shrink: 0 !important; }
.tp-sales-card__text { display: flex !important; flex-direction: row !important; align-items: center !important; gap: 4px !important; line-height: 1.15 !important; text-align: left !important; white-space: nowrap !important; flex: 1 !important; min-width: 0 !important; }
.tp-sales-card__title { font-size: clamp(9.5px, 2.6vw, 11.5px) !important; font-weight: 700 !important; color: #D9531E !important; white-space: nowrap !important; letter-spacing: -0.2px !important; }
.tp-sales-card__sub { font-size: clamp(9px, 2.4vw, 10.5px) !important; color: #7A6960 !important; font-weight: 500 !important; margin-top: 0 !important; white-space: nowrap !important; letter-spacing: -0.2px !important; }
.tp-sales-card__arrow { font-size: 15px !important; font-weight: 600 !important; color: #9C8C84 !important; line-height: 1 !important; flex-shrink: 0 !important; }

.tp-stock-card {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  background: #FFF0F2 !important;
  border: 1px solid #FFD6DC !important;
  border-radius: 12px !important;
  padding: 8px 10px !important;
  margin-bottom: 10px !important;
  box-sizing: border-box !important;
  cursor: pointer;
  white-space: nowrap !important;
  overflow: hidden !important;
  width: 100% !important;
  gap: 4px !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.tp-stock-card:hover { box-shadow: 0 3px 10px rgba(229, 40, 70, 0.08); }
.tp-stock-card__content { display: flex !important; align-items: center !important; gap: 6px !important; white-space: nowrap !important; flex: 1 !important; min-width: 0 !important; }
.tp-stock-card__icon { font-size: 15px !important; line-height: 1 !important; flex-shrink: 0 !important; }
.tp-stock-card__title { font-size: clamp(9.5px, 2.7vw, 11.5px) !important; font-weight: 700 !important; color: #E52846 !important; line-height: 1.15 !important; white-space: nowrap !important; letter-spacing: -0.2px !important; }
.tp-stock-card__arrow { font-size: 15px !important; font-weight: 600 !important; color: #E52846 !important; line-height: 1 !important; flex-shrink: 0 !important; }

/* ── Product Description Card ── */
.tp-description-card {
  background: #FFFFFF !important;
  border: 1px solid #E2EFE7 !important;
  border-radius: 14px !important;
  overflow: hidden !important;
  margin-bottom: 12px !important;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02) !important;
}
.tp-description-card__header {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 13px 16px !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  color: #164A36 !important;
  background: #FFFFFF !important;
  cursor: pointer !important;
  list-style: none !important;
  user-select: none !important;
}
.tp-description-card__header::-webkit-details-marker { display: none !important; }
.tp-description-card__chevron {
  transition: transform 0.25s ease !important;
}
details:not([open]) .tp-description-card__chevron {
  transform: rotate(180deg) !important;
}
.tp-description-card__body {
  padding: 0 16px 16px 16px !important;
  background: #FFFFFF !important;
  margin: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}
.tp-description-card__grid {
  display: grid !important;
  grid-template-columns: 1fr 135px !important;
  gap: 12px !important;
  align-items: center !important;
}
.tp-description-card__info {
  flex: 1 !important;
  text-align: left !important;
}
.tp-description-card__heading {
  font-size: 18px !important;
  font-weight: 800 !important;
  color: #164A36 !important;
  margin: 0 0 8px 0 !important;
  line-height: 1.25 !important;
}
.tp-description-card__excerpt,
.tp-description-card__full-content {
  font-size: 12px !important;
  color: #555555 !important;
  line-height: 1.5 !important;
}
.tp-description-card__read-more {
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  margin-top: 12px !important;
  padding: 7px 18px !important;
  background: #DDF2E4 !important;
  color: #164A36 !important;
  border-radius: 999px !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  border: none !important;
  cursor: pointer !important;
  width: auto !important;
  text-decoration: none !important;
}
.tp-description-card__read-more:hover { background: #CBEAD4 !important; }
.tp-description-card__media {
  flex-shrink: 0 !important;
  width: 135px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
.tp-description-card__media img {
  width: 100% !important;
  height: auto !important;
  max-width: 135px !important;
  object-fit: contain !important;
}

