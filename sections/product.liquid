                {%- when 'vendor' -%}
                  {%- if product.vendor != blank -%}
                    <div class="product__block__text" style="--PB:{{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
                      {%- if block.settings.add_vendor_link -%}
                        <p><a href="{{ product.vendor | url_for_vendor }}" class="product__form__link">{{ product.vendor | escape }}</a></p>
                      {%- else -%}
                        <p class="product__form__link">{{ product.vendor | escape }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                {%- when 'spacer' -%}
                  <div class="product__block__spacer {{ block.settings.target_device }}" style="--PT:{{ block.settings.padding_top }}px;--PB:{{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
                    {%- if block.settings.show_line -%}<hr class="hr--none">{%- endif -%}
                  </div>

                {%- when 'liquid' -%}
                  {{ block.settings.custom_liquid }}

                {%- when 'upsell' -%}
                  <div class="product__block__upsell" style="--PB:{{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
                    {%- case block.settings.upsell_type -%}
                      {%- when 'product_single' -%}{%- assign upsell_product_first = all_products[block.settings.product] -%}
                      {%- when 'product_grouping' -%}{%- assign upsell_product_first = block.settings.upsell_product_list | first -%}
                    {%- endcase -%}
                    {%- if upsell_product_first and upsell_product_first.title != '' and upsell_product_first.selected_or_first_available_variant != nil -%}
                      <div class="upsell__holder">
                        <div class="upsell__holder__title">
                          <div class="upsell__header-main upsell__header-centered">
                            <h2 class="upsell__holder__title__text-centered">
                              To make your care
                              <span class="upsell__title-script">feel complete</span>
                            </h2>
                          </div>
                        </div>
                        <div class="upsell__cards-scroll-track">
                          {%- case block.settings.upsell_type -%}
                            {%- when 'product_single' -%}{%- render 'product-clip', card_product: upsell_product_first -%}
                            {%- when 'product_grouping' -%}
                              {%- for upsell_product in block.settings.upsell_product_list limit: block.settings.upsell_list_limit -%}
                                {%- render 'product-clip', card_product: upsell_product -%}
                              {%- endfor -%}
                          {%- endcase -%}
                        </div>
                        <div class="upsell__dots-indicator">
                          <span class="upsell__dot active"></span>
                          <span class="upsell__dot"></span>
                        </div>
                      </div>
                    {%- elsif request.design_mode -%}
                      <div class="upsell__holder">
                        <div class="upsell__holder__title"><h2 class="upsell__holder__title__text">{{ block.settings.title }}</h2></div>
                        {%- render 'onboarding-product-clip' -%}
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'complimentary' -%}
                  <div style="--PB:{{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
                    <div class="upsell__holder js-unloaded" data-product-complimentary-loaded>
                      <div class="upsell__holder__title">
                        <div class="upsell__header-main upsell__header-centered">
                          <h2 class="upsell__holder__title__text-centered">
                            To make your care
                            <span class="upsell__title-script">feel complete</span>
                          </h2>
                        </div>
                      </div>
                      <product-complimentary data-url="{{ routes.product_recommendations_url }}?section_id=api-product-upsell-item&product_id={{ product.id }}&limit={{ block.settings.complimentary_list_limit }}&intent=complementary"></product-complimentary>
                    </div>
                  </div>

                {%- when 'icon' -%}
                  <div class="tp-delivery-strip" {{ block.shopify_attributes }}>
                    <div class="tp-delivery-strip__item tp-delivery-strip__item--main">
                      <div class="tp-delivery-strip__icon-wrap">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#164A36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="1" y="3" width="15" height="13"></rect>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                          <circle cx="5.5" cy="18.5" r="2.5"></circle>
                          <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                      </div>
                      <div class="tp-delivery-strip__text">
                        <span class="tp-delivery-strip__label">Estimated Delivery Time</span>
                        <strong class="tp-delivery-strip__val">2–3 days</strong>
                      </div>
                    </div>
                    <div class="tp-delivery-strip__divider"></div>
                    <div class="tp-delivery-strip__trust-group">
                      <div class="tp-delivery-strip__trust-item">
                        <div class="tp-delivery-strip__trust-icon-wrap">
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#164A36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <polyline points="9 12 11 14 15 10"></polyline>
                          </svg>
                        </div>
                        <span class="tp-delivery-strip__trust-label">Secure<br>Packaging</span>
                      </div>
                      <div class="tp-delivery-strip__trust-item">
                        <div class="tp-delivery-strip__trust-icon-wrap">
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#164A36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                          </svg>
                        </div>
                        <span class="tp-delivery-strip__trust-label">Discreet<br>Delivery</span>
                      </div>
                      <div class="tp-delivery-strip__trust-item">
                        <div class="tp-delivery-strip__trust-icon-wrap">
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="#164A36" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                          </svg>
                        </div>
                        <span class="tp-delivery-strip__trust-label">Pan India<br>Delivery</span>
                      </div>
                    </div>
                  </div>

                {%- when 'image' -%}
                  <div class="product__block__image {{ block.settings.alignment }}" style="--PB:{{ block.settings.padding_bottom }}px;" {{ block.shopify_attributes }}>
                    <div style="max-width:{{ block.settings.image_max_limit }}px;">
                      {%- assign blk_img    = block.settings.image -%}
                      {%- assign blk_img_w  = blk_img.width | at_most: block.settings.image_max_limit -%}
                      {%- assign blk_img_w2 = blk_img_w | times: 2 -%}
                      {%- capture blk_srcset -%}{{ blk_img | image_url: width: blk_img_w2 }} 2x, {{ blk_img | image_url: width: blk_img_w }}{%- endcapture -%}
                      {%- render 'image', img_object: blk_img, srcset: blk_srcset, width: blk_img_w -%}
                    </div>
                  </div>

              {%- endcase -%}
            {%- endfor -%}

            {%- assign add_buttons_block = section.blocks | where: 'type', 'add-buttons' | first -%}
            {%- if add_buttons_block == nil -%}
              {%- render 'product-buttons', product: product, uniq_id: product_form_id, hidden: true -%}
            {%- endif -%}
          </div>
        </div>

      </div>

      {%- comment -%} PDP Additions & Recommendations rendered below 2-column buy box section {%- endcomment -%}
      <div class="pdp-additions-full-width">
        {%- render 'pdp-additions', product: product -%}

        {%- assign recommended_product = product.metafields.custom.product_recommendation.value -%}
        {%- if recommended_product != blank -%}
          <div class="product-recommendation-offer" style="margin-top: 25px;">
            <div class="recommendation-grid">
              <div class="recommended-item">
                <a href="{{ recommended_product.url }}">
                  {%- if recommended_product.featured_image != blank -%}
                    <img
                      src="{{ recommended_product.featured_image | image_url: width: 300 }}"
                      alt="{{ recommended_product.title | escape }}"
                      width="150"
                      height="150"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- endif -%}
                  <div>
                    <h3>🔥 Buy 2 Get 1 Free (Exclusive Offer)</h3>
                    <p>{{ recommended_product.title | escape }}</p>
                    <button type="button">ADD</button>
                  </div>
                </a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- render 'product-info', product: product -%}
{%- if section.settings.zoom_enable -%}{%- render 'zoom-pswp' -%}{%- endif -%}

<script type="application/json" id="ModelJson-{{ section.id }}">
