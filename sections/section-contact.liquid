<!-- /sections/section-contact.liquid -->

<section
  class="section-contact {{ section.settings.text_color }} {{ section.settings.height }} {{ section.settings.bg }}"
  data-section-id="{{ section.id }}"
  data-section-type="contact"
  style="--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ section.settings.width }} section-padding page-{{ page.title | handleize }}">
    <div class="text__standard {{ section.settings.align_text }}">
      <!-- Contact Heading -->
      <div class="contact-header">
        <h2 class="contact-main-title">We’re here for all your comfort queries.</h2>

        <p class="contact-intro">
          Have questions about your period, our products, your order, or anything else? We’re always happy to help.
          Reach out to us and our team will be here for you.
        </p>

        <!-- Direct Contact Information -->
        <div class="contact-direct-info">
          <div class="contact-direct-item">
            <strong>Email:</strong>
            <a href="mailto:info@bioweal.com">info@bioweal.com</a>
          </div>

          <div class="contact-direct-item">
            <strong>Call us:</strong>
            <a href="tel:+917975421029">+91 79754 21029</a>
          </div>

          <div class="contact-direct-item">
            <strong>Working Hours:</strong>
            <span>Monday – Saturday, 10:00 AM – 6:00 PM (excluding public holidays)</span>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-wrapper">
        {% form 'contact', id: 'contact-us-page' %}
          <!-- Success Message -->
          {% if form.posted_successfully? %}
            <div class="contact-form-success">
              {{ 'contact.form.post_success' | t }}
            </div>
          {% endif %}

          <!-- Form Errors -->
          {% if form.errors %}
            <div class="contact-form-errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <!-- Name -->
          <div class="float__wrapper contact-field contact-field-name">
            <label for="ContactFormName"> Name </label>

            <input
              type="text"
              id="ContactFormName"
              name="contact[name]"
              placeholder="Name"
              autocomplete="name"
              autocapitalize="words"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <!-- Email -->
          <div class="float__wrapper contact-field contact-field-email">
            <label for="ContactFormEmail"> E-mail </label>

            <input
              type="email"
              id="ContactFormEmail"
              name="contact[email]"
              placeholder="E-mail"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required
            >
          </div>

          <!-- Phone Number -->
          <div class="float__wrapper contact-field contact-field-phone">
            <label for="ContactFormPhone"> Phone Number </label>

            <input
              type="tel"
              id="ContactFormPhone"
              name="contact[phone]"
              placeholder="Phone Number"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% endif %}"
            >
          </div>

          <!-- Message -->
          <div class="float__wrapper contact-field contact-field-message">
            <label for="ContactFormMessage"> Message </label>

            <textarea
              rows="5"
              id="ContactFormMessage"
              name="contact[body]"
              placeholder="Message"
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="contact-submit-button"
          >
            Send message
          </button>
        {% endform %}
      </div>
    </div>

    <!-- Optional Existing Contact Details -->
    {% if section.settings.show_contact_details %}
      <div class="location_info">
        {% if section.settings.Contact_details != blank %}
          <p class="standard__kicker kicker__line">Contact Details</p>

          <div class="contact-location-text">
            {{ section.settings.Contact_details }}
          </div>
        {% endif %}

        {% if section.settings.mobile_number != blank %}
          <p class="contactus_svg">
            <span>
              {% render 'phone-icon' %}
            </span>

            <a
              href="tel:{{ section.settings.mobile_number | remove: ' ' }}"
              target="_self"
            >
              {{ section.settings.mobile_number }}
            </a>
          </p>
        {% endif %}

        {% if section.settings.email_address != blank %}
          <p class="contactus_svg">
            <span>
              {% render 'email-icon' %}
            </span>

            <a
              class="gamil_text"
              href="mailto:{{ section.settings.email_address }}"
            >
              {{ section.settings.email_address }}
            </a>
          </p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  .contact-direct-info {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 10px 32px;
    max-width: 1100px;
    margin: 0 auto 30px;
    text-align: center;
  }

  .contact-direct-item {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 6px;
    color: #111;
    font-size: 15px;
    line-height: 1.5;
    white-space: nowrap;
  }

  .contact-direct-item strong {
    font-weight: 700;
  }

  .contact-direct-item a {
    color: inherit;
    text-decoration: none;
  }

  .contact-direct-item a:hover {
    text-decoration: underline;
  }

  @media only screen and (max-width: 767px) {
    .contact-direct-info {
      flex-direction: column;
      align-items: center;
      gap: 8px;
      width: 100%;
      margin-bottom: 28px;
    }

    .contact-direct-item {
      white-space: normal;
      text-align: center;
      line-height: 1.5;
    }
  }
  /* =========================================================
   TIMEPADS CONTACT SECTION
   ========================================================= */

  .section-contact {
    --contact-black: #231f20;
    --contact-text: #111111;
    --contact-muted: #555555;
    --contact-border: #d9d9d9;
    --contact-white: #ffffff;
  }

  /* =========================================================
   MAIN CONTAINER
   ========================================================= */

  .section-contact .text__standard {
    width: 100%;
  }

  /* =========================================================
   HEADER
   ========================================================= */

  .contact-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-main-title {
    margin: 0 0 12px;
    font-size: 30px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: var(--contact-text);
  }

  .contact-intro {
    max-width: 800px;
    margin: 0 auto 18px;
    color: var(--contact-text);
    font-size: 16px;
    line-height: 1.6;
  }

  /* =========================================================
   DIRECT CONTACT INFORMATION
   ========================================================= */

  .contact-direct-info {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 26px;
    row-gap: 8px;
    margin: 0 auto 32px;
    color: var(--contact-text);
    font-size: 15px;
    line-height: 1.5;
  }

  .contact-direct-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--contact-text);
    text-decoration: none;
  }

  .contact-direct-item:hover {
    color: var(--contact-black);
    text-decoration: underline;
  }

  .contact-direct-label {
    font-weight: 600;
  }

  .contact-hours {
    cursor: default;
  }

  .contact-hours:hover {
    text-decoration: none;
  }

  /* =========================================================
   FORM
   ========================================================= */

  .contact-form-wrapper {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
  }

  #contact-us-page {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 18px;
    width: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
  }

  /* =========================================================
   FORM FIELDS
   ========================================================= */

  #contact-us-page .contact-field {
    width: 100%;
    margin: 0;
  }

  #contact-us-page .contact-field-name,
  #contact-us-page .contact-field-email {
    grid-column: span 1;
  }

  #contact-us-page .contact-field-phone,
  #contact-us-page .contact-field-message {
    grid-column: 1 / -1;
  }

  #contact-us-page .contact-field label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #contact-us-page input,
  #contact-us-page textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--contact-border);
    border-radius: 14px;
    background: var(--contact-white);
    color: var(--contact-text);
    font-family: inherit;
    font-size: 16px;
    line-height: 1.4;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  #contact-us-page input {
    height: 56px;
    padding: 0 16px;
  }

  #contact-us-page textarea {
    min-height: 116px;
    padding: 16px;
    resize: vertical;
  }

  #contact-us-page input::placeholder,
  #contact-us-page textarea::placeholder {
    color: #777777;
    opacity: 1;
  }

  #contact-us-page input:focus,
  #contact-us-page textarea:focus {
    border-color: #222222;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.04);
  }

  /* =========================================================
   SUCCESS / ERROR
   ========================================================= */

  #contact-us-page .contact-form-success,
  #contact-us-page .contact-form-errors {
    grid-column: 1 / -1;
    width: 100%;
    box-sizing: border-box;
    padding: 14px 16px;
    margin: 0;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
  }

  #contact-us-page .contact-form-success {
    background: #f1f7ef;
    color: #31512b;
  }

  #contact-us-page .contact-form-errors {
    background: #fff2f2;
    color: #8a1f1f;
  }

  /* =========================================================
   SUBMIT BUTTON
   ========================================================= */

  #contact-us-page .contact-submit-button {
    grid-column: 1 / -1;
    width: 100%;
    min-height: 56px;
    padding: 14px 24px;
    margin: 0;
    border: none;
    border-radius: 30px;
    background: var(--contact-black);
    color: #ffffff;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
  }

  #contact-us-page .contact-submit-button:hover {
    transform: translateY(-1px);
    opacity: 0.94;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
  }

  #contact-us-page .contact-submit-button:active {
    transform: translateY(0);
  }

  #contact-us-page .contact-submit-button:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 3px;
  }

  /* =========================================================
   EXISTING CONTACT DETAILS
   ========================================================= */

  .location_info {
    max-width: 850px;
    margin: 45px auto 0;
  }

  .location_info .standard__kicker {
    margin-bottom: 12px;
  }

  .contact-location-text {
    margin-bottom: 15px;
  }

  .contactus_svg {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0;
  }

  .contactus_svg svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .contactus_svg a {
    color: inherit;
    text-decoration: none;
  }

  .contactus_svg a:hover {
    text-decoration: underline;
  }

  /* =========================================================
   DESKTOP SPACING
   ========================================================= */

  .page-contact {
    width: 90%;
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  /* =========================================================
   TABLET
   ========================================================= */

  @media only screen and (max-width: 900px) {
    .contact-main-title {
      font-size: 28px;
    }

    .contact-direct-info {
      column-gap: 18px;
    }
  }

  /* =========================================================
   MOBILE
   ========================================================= */

  @media only screen and (max-width: 767px) {
    .section-contact {
      --PT: 30px;
      --PB: 30px;
    }

    .contact-header {
      padding: 0 5px;
    }

    .contact-main-title {
      font-size: 25px;
      line-height: 1.3;
      letter-spacing: -0.2px;
    }

    .contact-intro {
      font-size: 15px;
      line-height: 1.55;
      margin-bottom: 18px;
    }

    .contact-direct-info {
      flex-direction: column;
      align-items: center;
      gap: 9px;
      margin-bottom: 28px;
      font-size: 14px;
    }

    .contact-direct-item {
      justify-content: center;
      text-align: center;
    }

    #contact-us-page {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    #contact-us-page .contact-field-name,
    #contact-us-page .contact-field-email,
    #contact-us-page .contact-field-phone,
    #contact-us-page .contact-field-message {
      width: 100%;
    }

    #contact-us-page input {
      height: 54px;
      font-size: 15px;
    }

    #contact-us-page textarea {
      min-height: 120px;
      font-size: 15px;
    }

    #contact-us-page .contact-submit-button {
      min-height: 54px;
      font-size: 15px;
    }

    .location_info {
      margin-top: 35px;
    }

    .page-contact {
      flex-direction: column;
      width: 100%;
    }
  }

  /* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

  @media only screen and (max-width: 480px) {
    .contact-main-title {
      font-size: 23px;
    }

    .contact-intro {
      font-size: 14px;
    }

    .contact-direct-info {
      font-size: 13px;
    }

    #contact-us-page input,
    #contact-us-page textarea {
      border-radius: 12px;
    }

    #contact-us-page .contact-submit-button {
      border-radius: 28px;
    }
  }

  .wrapper.section-padding.page-contact {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .contact-direct-info {
    padding-bottom: 1rem;
  }
{% endstyle %}

