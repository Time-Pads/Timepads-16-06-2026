<!-- /sections/subfooter.liquid -->

{% style %}
.tp-subfooter-master {
  display: none !important;
}

.tp-subfooter-container {
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.tp-subfooter-left {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--time-white);
  font-weight: 500;
  font-size: 12.5px;
}

.tp-subfooter-center {
  display: flex;
  align-items: center;
  gap: 16px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 11px;
  font-weight: 600;
  color: var(--time-primary-light);
  opacity: 0.85;
}

.tp-subfooter-tick {
  width: 1px;
  height: 15px;
  background: rgba(255, 255, 255, 0.25);
}

.tp-subfooter-right {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.tp-payment-logos-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.tp-payment-logo-svg {
  display: inline-flex;
  align-items: center;
}

.tp-secure-tag {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--time-white);
  font-weight: 600;
  font-size: 12px;
  margin-left: 6px;
}

@media (max-width: 900px) {
  .tp-subfooter-container {
    flex-direction: column;
    text-align: center;
    gap: 12px;
  }
}
{% endstyle %}

<section class="tp-subfooter-master" data-section-id="{{ section.id }}" data-section-type="subfooter">
  <div class="tp-subfooter-container">
    
    <!-- LEFT: Copyright -->
    <div class="tp-subfooter-left">
      &copy; {{ 'now' | date: "%Y" }} <strong>TIME</strong>. All rights reserved.
    </div>

    <!-- CENTER: Tagline -->
    <div class="tp-subfooter-center">
      <div class="tp-subfooter-tick"></div>
      <div>MORE THAN A PAD, A BETTER PERIOD</div>
      <div class="tp-subfooter-tick"></div>
    </div>

    <!-- RIGHT: Payment Logos & Security Tag -->
    <div class="tp-subfooter-right">
      <div class="tp-payment-logos-row">
        <!-- VISA -->
        <span class="tp-payment-logo-svg" title="VISA">
          <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
            <rect width="38" height="24" rx="3" fill="#1A1F71"/>
            <path d="M14.5 17L16.8 7H19.2L16.9 17H14.5ZM24.6 7.3C24.1 7.1 23.3 6.9 22.3 6.9C19.8 6.9 18.1 8.2 18.1 10C18.1 11.4 19.3 12.1 20.3 12.6C21.3 13.1 21.6 13.4 21.6 13.9C21.6 14.6 20.8 14.9 20 14.9C18.9 14.9 18.2 14.6 17.6 14.3L17 17.1C17.8 17.5 19 17.7 20.2 17.7C22.9 17.7 24.6 16.4 24.6 14.4C24.6 12.1 21.4 11.8 21.4 10.7C21.4 10.3 21.8 9.8 22.8 9.8C23.5 9.8 24.2 9.9 24.7 10.2L24.6 7.3ZM30.2 7H28.3C27.6 7 27.1 7.2 26.8 7.9L22.9 17H25.4L25.9 15.6H29L29.3 17H31.5L30.2 7ZM26.6 13.6L27.9 9.8L28.6 13.6H26.6ZM13.8 7L11.5 13.8L11.2 12.4C10.7 10.7 9.2 8.8 7.4 7.9L10.3 17H12.8L16.3 7H13.8Z" fill="#FFFFFF"/>
            <path d="M9 7H5.2L5 7.2C8 7.9 10 9.8 10.8 11.9L9.8 7.9C9.6 7.3 9.4 7 9 7Z" fill="#F79E1B"/>
          </svg>
        </span>

        <!-- Mastercard -->
        <span class="tp-payment-logo-svg" title="Mastercard">
          <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
            <rect width="38" height="24" rx="3" fill="#1F1B24"/>
            <circle cx="14" cy="12" r="7" fill="#EB001B"/>
            <circle cx="24" cy="12" r="7" fill="#F79E1B" opacity="0.95"/>
          </svg>
        </span>

        <!-- RuPay -->
        <span class="tp-payment-logo-svg" title="RuPay">
          <svg viewBox="0 0 46 24" width="46" height="24" fill="none">
            <rect width="46" height="24" rx="3" fill="#0C2340"/>
            <text x="23" y="16" fill="#00A550" font-size="10.5" font-weight="900" font-family="sans-serif" text-anchor="middle" letter-spacing="0.5">RuPay</text>
          </svg>
        </span>

        <!-- AMEX -->
  

        <!-- UPI -->
        <span class="tp-payment-logo-svg" title="UPI">
          <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
            <rect width="38" height="24" rx="3" fill="#3D203A" stroke="rgba(255,255,255,0.2)"/>
            <path d="M12 7L17 17H14L12 13H10L12 7Z" fill="#078438"/>
            <path d="M26 17L21 7H24L26 11H28L26 17Z" fill="#E65A28"/>
            <text x="19" y="16" fill="#FFFFFF" font-size="8.5" font-weight="800" font-family="sans-serif" text-anchor="middle">UPI</text>
          </svg>
        </span>
      </div>

      <!-- Security Lock Tag -->
      <div class="tp-secure-tag">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--time-white)" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span>100% Secure Payments</span>
      </div>
    </div>

  </div>
</section>
