<!-- /sections/section-logos.liquid -->

{%- capture lazy_load_section -%}{%- render 'lazy-load-section-validations' -%}{%- endcapture -%}

{%- assign sid = section.id -%}
{%- assign is_product_or_collection = false -%}
{%- if product or collection -%}{%- assign is_product_or_collection = true -%}{%- endif -%}

{% style %}
  #shopify-section-{{ sid }} {
    background-color: var(--time-background, #FFFFFF) !important;
    padding-top: {{ section.settings.padding_top | default: 24 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 24 }}px !important;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 18 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 18 }}px !important;
    }
  }

  .tp-logos-container-{{ sid }} {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
  }

  .tp-logos-heading-{{ sid }} {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 28px !important;
    font-weight: 700 !important;
    color: var(--time-text, #3D3329) !important;
    text-align: center !important;
    margin: 0 0 24px 0 !important;
    line-height: 1.2 !important;
  }
  @media (min-width: 768px) {
    .tp-logos-heading-{{ sid }} {
      font-size: 38px !important;
    }
  }

  .tp-logos-grid-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    flex-wrap: wrap;
    margin: 0 auto;
    padding: 4px 0;
    list-style: none;
    box-sizing: border-box;
  }

  .tp-logo-item-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .tp-logo-item-{{ sid }}:hover {
    transform: translateY(-2px);
  }

  .tp-logo-link-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .tp-logo-img-{{ sid }} {
    max-height: 46px;
    max-width: 150px;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
    display: block;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.04));
  }

  @media (max-width: 767px) {
    .tp-logos-container-{{ sid }} {
      padding: 0 10px !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .tp-logos-heading-{{ sid }} {
      font-size: 18px !important;
      margin-bottom: 14px !important;
      text-align: center !important;
    }
    .tp-logos-grid-{{ sid }} {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: space-between !important;
      align-items: center !important;
      gap: 6px !important;
      padding: 0 !important;
      width: 100% !important;
      box-sizing: border-box !important;
      overflow-x: auto !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }
    .tp-logos-grid-{{ sid }}::-webkit-scrollbar {
      display: none !important;
    }
    .tp-logo-item-{{ sid }} {
      flex: 1 1 0 !important;
      min-width: 0 !important;
      max-width: none !important;
      height: 32px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    }
    .tp-logo-item-{{ sid }} picture {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      max-width: 100% !important;
      max-height: 100% !important;
      width: 100% !important;
    }
    .tp-logo-link-{{ sid }} {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 100% !important;
    }
    .tp-logo-img-{{ sid }} {
      max-height: 25px !important;
      max-width: 100% !important;
      width: auto !important;
      height: auto !important;
      object-fit: contain !important;
    }
  }
{% endstyle %}

{%- if lazy_load_section != blank -%}<lazy-section style="display: block; min-height: 100px;">{%- endif -%}

{%- if lazy_load_section == blank -%}

  {%- assign has_block_with_image = false -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.image != blank -%}
      {%- assign has_block_with_image = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign hide_section = false -%}
  {%- if is_product_or_collection and has_block_with_image == false and request.design_mode == false -%}
    {%- assign hide_section = true -%}
  {%- endif -%}

  {%- unless hide_section -%}

    {%- capture logo_items_markup -%}
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image -%}
        {%- assign show_item = true -%}
        {%- if is_product_or_collection and img == blank -%}{%- assign show_item = false -%}{%- endif -%}

        {%- if show_item -%}
          <div
            class="tp-logo-item-{{ sid }} logo-bar__item"
            data-slide="{{ block.id }}"
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="tp-logo-link-{{ sid }} logo-bar__link"
                {%- if block.settings.new_tab %} target="_blank" rel="noopener noreferrer"{%- endif %}
                aria-label="{{ block.settings.alt_text | default: section.settings.title | escape }}"
              >
            {%- endif -%}

            {%- if img != blank -%}
              {%- assign img_w = block.settings.width | default: 140 -%}
              {%- assign img_w2x = img_w | times: 2 -%}
              {%- assign img_alt = block.settings.alt_text | default: section.settings.title | escape -%}
              <picture>
                <source
                  type="image/webp"
                  srcset="{{ img | image_url: width: img_w, format: 'webp' }} 1x, {{ img | image_url: width: img_w2x, format: 'webp' }} 2x"
                >
                <img
                  src="{{ img | image_url: width: img_w }}"
                  srcset="{{ img | image_url: width: img_w }} 1x, {{ img | image_url: width: img_w2x }} 2x"
                  alt="{{ img_alt }}"
                  class="tp-logo-img-{{ sid }} logo-bar__image"
                  width="{{ img_w }}"
                  height="46"
                  loading="lazy"
                  fetchpriority="low"
                  decoding="async"
                >
              </picture>
            {%- else -%}
              {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}

            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <div
      class="section-logos section-logos-{{ sid }} {{ section.settings.bg }}"
      data-section-id="{{ sid }}"
      data-section-type="logos"
    >
      <div class="tp-logos-container-{{ sid }}">

        {%- if section.settings.title != blank -%}
          {%- assign logo_words = section.settings.title | split: ' ' -%}
          <h2 class="tp-logos-heading-{{ sid }}">
            {%- for word in logo_words -%}
              {%- if forloop.last -%}
                <span style="color: var(--time-primary, #B7A487);">{{ word }}</span>
              {%- else -%}
                {{ word }} 
              {%- endif -%}
            {%- endfor -%}
          </h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          {%- if section.settings.enable_marquee -%}
            <div class="logo-bar__wrapper">
              <div class="logo-bar__outer">
                <div class="logo-bar__holder">
                  <div class="logo-bar logo-bar--marquee">
                    <div data-ticker-frame class="logo-bar__message">
                      <div data-ticker-scale class="ticker--unloaded logo-bar__scale" style="--animation-duration:{{ section.settings.marquee_speed }}s;">
                        <div data-ticker-text class="logo-bar__text tp-logos-grid-{{ sid }}">
                          {{ logo_items_markup }}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {%- else -%}
            <div class="tp-logos-grid-{{ sid }} {{ section.settings.extra_class }}">
              {{ logo_items_markup }}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="text-center">{{ 'home_page.onboarding.no_content' | t }}</div>
        {%- endif -%}

        {%- if is_product_or_collection and has_block_with_image == false and request.design_mode -%}
          <div class="text-center">{{ 'home_page.onboarding.no_content' | t }}</div>
        {%- endif -%}

      </div>
    </div>

  {%- endunless -%}

{%- else -%}
  <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg" width="66" height="66">
    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
  </svg>
{%- endif -%}

{%- if lazy_load_section != blank -%}</lazy-section>{%- endif -%}

{% schema %}
{
  "name": "Logo list",
  "settings": [
    { "type": "header", "content": "Padding settings" },
    { "type": "range", "id": "padding_top",          "min": 0, "max": 100, "default": 24, "step": 2, "unit": "px", "label": "Padding Top" },
    { "type": "range", "id": "padding_bottom",        "min": 0, "max": 100, "default": 24, "step": 2, "unit": "px", "label": "Padding Bottom" },
    { "type": "range", "id": "padding_top_mobile",    "min": 0, "max": 100, "default": 18, "step": 2, "unit": "px", "label": "Padding Top Mobile" },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "default": 18, "step": 2, "unit": "px", "label": "Padding Bottom Mobile" },
    { "type": "text",   "id": "title",       "label": "Title",           "default": "Available Across India's Leading Platforms" },
    { "type": "text",   "id": "extra_class", "label": "Add Extra class" },
    {
      "type": "select", "id": "bg", "label": "Background color", "default": "palette--light bg--neutral",
      "options": [
        { "value": "palette--light bg--neutral",         "label": "Default" },
        { "value": "palette--light bg--accent",          "label": "Light" },
        { "value": "palette--dark bg--invert",           "label": "Dark" },
        { "value": "palette--dark bg--invert--accent",   "label": "Dark accent" },
        { "value": "palette--bright bg--bright",         "label": "Bright" },
        { "value": "palette--bright bg--bright--accent", "label": "Bright accent" }
      ]
    },
    { "type": "header",   "content": "Marquee" },
    { "type": "checkbox", "id": "enable_marquee",   "label": "Enable animated marquee", "default": false },
    { "type": "range",    "id": "marquee_speed",    "label": "Marquee animation speed", "unit": "s", "min": 2, "max": 60, "step": 1, "default": 30 },
    { "type": "header",   "content": "Section spacing" },
    {
      "type": "select", "id": "width", "label": "Width", "default": "wrapper--none",
      "options": [
        { "value": "wrapper--none",   "label": "Full width" },
        { "value": "wrapper--full",   "label": "Full width padded" },
        { "value": "wrapper",         "label": "Page width" },
        { "value": "wrapper--narrow", "label": "Page width narrow" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image",   "label": "Image", "info": "640 x 640px .png recommended" },
        { "type": "text",         "id": "alt_text", "label": "Alt Text" },
        { "type": "url",          "id": "link",     "label": "Link", "info": "Optional" },
        { "type": "checkbox",     "id": "new_tab",  "label": "Open in new window", "default": true },
        { "type": "range",        "id": "width",    "label": "Width",   "unit": "px", "min": 50,  "max": 300, "step": 5,  "default": 140 },
        { "type": "range",        "id": "spacing",  "label": "Spacing", "unit": "px", "min": 0,   "max": 100, "step": 5,  "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "category": "Image",
      "blocks": [
        { "type": "logo_image" },
        { "type": "logo_image" },
        { "type": "logo_image" },
        { "type": "logo_image" },
        { "type": "logo_image" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside"]
  }
}
{% endschema %}
