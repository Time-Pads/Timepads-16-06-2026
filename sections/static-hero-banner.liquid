{% comment %}
  Static Hero Banner Section
  File: sections/static-hero-banner.liquid
  Purpose: Lightweight static hero banner replacing carousel slideshow to optimize LCP & eliminate CLS.
{% endcomment %}

{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign link_url = section.settings.link

  assign desktop_aspect = desktop_image.aspect_ratio | default: 2.35
  assign mobile_aspect = mobile_image.aspect_ratio | default: desktop_aspect | default: 1.2
  assign is_lcp_banner = false
  if section.index == 1
    assign is_lcp_banner = true
  elsif template.name == 'index' and section.index == 2
    assign is_lcp_banner = true
  endif
-%}

{% style %}
  .static-hero-banner-{{ section.id }} {
    display: block;
    width: 100%;
    position: relative;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .static-hero-banner__container-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0 auto;
  }

  .static-hero-banner__picture-{{ section.id }} {
    display: block;
    width: 100%;
    aspect-ratio: {{ mobile_aspect }};
    overflow: hidden;
  }

  .static-hero-banner__image-{{ section.id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (min-width: 768px) {
    .static-hero-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .static-hero-banner__picture-{{ section.id }} {
      aspect-ratio: {{ desktop_aspect }};
    }
  }
{% endstyle %}
{% if is_lcp_banner %}
  {% if mobile_image != blank %}
    <link rel="preload" as="image" media="(max-width: 767px)" href="{{ mobile_image | image_url: width: 412, format: 'webp', quality: 60 }}" imagesrcset="{{ mobile_image | image_url: width: 375, format: 'webp', quality: 60 }} 375w, {{ mobile_image | image_url: width: 412, format: 'webp', quality: 60 }} 412w, {{ mobile_image | image_url: width: 550, format: 'webp', quality: 60 }} 550w, {{ mobile_image | image_url: width: 750, format: 'webp', quality: 60 }} 750w" imagesizes="100vw" fetchpriority="high" type="image/webp">
  {% endif %}
  {% if desktop_image != blank %}
    <link rel="preload" as="image" media="(min-width: 768px)" href="{{ desktop_image | image_url: width: 1440, format: 'webp', quality: 60 }}" imagesrcset="{{ desktop_image | image_url: width: 750, format: 'webp', quality: 60 }} 750w, {{ desktop_image | image_url: width: 1100, format: 'webp', quality: 60 }} 1100w, {{ desktop_image | image_url: width: 1440, format: 'webp', quality: 60 }} 1440w, {{ desktop_image | image_url: width: 1920, format: 'webp', quality: 60 }} 1920w" imagesizes="100vw" fetchpriority="high" type="image/webp">
  {% endif %}
{% endif %}

<div class="static-hero-banner-{{ section.id }}">
  <div class="static-hero-banner__container-{{ section.id }}">
    {%- if link_url != blank -%}
      <a href="{{ link_url }}" class="static-hero-banner__link block w-full h-full text-decoration-none">
    {%- endif -%}

    {%- if desktop_image != blank or mobile_image != blank -%}
      <picture class="static-hero-banner__picture-{{ section.id }}">
        {%- if desktop_image != blank -%}
          <!-- Desktop WebP Source (min-width: 768px) -->
          <source
            media="(min-width: 768px)"
            type="image/webp"
            srcset="
              {{ desktop_image | image_url: width: 750, format: 'webp' }} 750w,
              {{ desktop_image | image_url: width: 1100, format: 'webp' }} 1100w,
              {{ desktop_image | image_url: width: 1440, format: 'webp' }} 1440w,
              {{ desktop_image | image_url: width: 1920, format: 'webp' }} 1920w
            "
            sizes="100vw"
            width="{{ desktop_image.width }}"
            height="{{ desktop_image.height }}"
          >
        {%- endif -%}

        <!-- Mobile / Primary Fallback Image -->
        {%- liquid
          assign main_image = mobile_image | default: desktop_image
          assign image_alt = main_image.alt | default: shop.name | escape
          assign image_class = 'static-hero-banner__image static-hero-banner__image-' | append: section.id
          assign is_lcp = is_lcp_banner
        -%}
        <img
          src="{{ main_image | image_url: width: 412, format: 'webp', quality: 60 }}"
          srcset="{{ main_image | image_url: width: 375, format: 'webp', quality: 60 }} 375w, {{ main_image | image_url: width: 412, format: 'webp', quality: 60 }} 412w, {{ main_image | image_url: width: 550, format: 'webp', quality: 60 }} 550w, {{ main_image | image_url: width: 750, format: 'webp', quality: 60 }} 750w"
          sizes="100vw"
          width="{{ main_image.width }}"
          height="{{ main_image.height }}"
          class="{{ image_class }}"
          alt="{{ image_alt }}"
          {% if is_lcp %}loading="eager" fetchpriority="high" decoding="sync"{% else %}loading="lazy" fetchpriority="low" decoding="async"{% endif %}
        >
      </picture>
    {%- else -%}
      <div class="static-hero-banner__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg w-full h-auto' }}
      </div>
    {%- endif -%}

    {%- if link_url != blank -%}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Static Hero Banner",
  "tag": "section",
  "class": "static-hero-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Banner Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image",
      "info": "Recommended aspect ratio ~ 16:9 or 21:9 (e.g. 1920x800px)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Recommended aspect ratio ~ 4:5 or 1:1 (e.g. 750x937px)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link URL"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Static Hero Banner"
    }
  ]
}
{% endschema %}
