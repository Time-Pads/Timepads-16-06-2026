{% comment %}
  TIMEPADS - Stay in the Loop (Newsletter & Perks)
  File: sections/newsletter-stay-in-loop.liquid
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Stay in the Loop'
  assign subheading = section.settings.subheading | default: 'Get updates on offers, new launches & period care tips.'
  assign placeholder_text = section.settings.placeholder_text | default: 'Enter your email'
  assign button_text = section.settings.button_text | default: 'SUBSCRIBE'

  assign bg_color = section.settings.bg_color | default: '#EFEFE8'
  assign heading_color = section.settings.heading_color | default: '#1F1E1B'
  assign subheading_color = section.settings.subheading_color | default: '#52504C'
  assign btn_bg_color = section.settings.btn_bg_color | default: '#4B5E3E'
  assign btn_text_color = section.settings.btn_text_color | default: '#FFFFFF'

  assign pad_top = section.settings.padding_top | default: 36
  assign pad_bottom = section.settings.padding_bottom | default: 36
  assign pad_top_m = section.settings.padding_top_mobile | default: 24
  assign pad_bottom_m = section.settings.padding_bottom_mobile | default: 24
-%}

{%- style -%}
  .tp-newsletter-{{ section.id }} {
    background-color: {{ bg_color }};
    padding-top: {{ pad_top_m }}px;
    padding-bottom: {{ pad_bottom_m }}px;
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
  }

  @media (min-width: 768px) {
    .tp-newsletter-{{ section.id }} {
      padding-top: {{ pad_top }}px;
      padding-bottom: {{ pad_bottom }}px;
    }
  }

  .tp-newsletter__container {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .tp-newsletter__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    width: 100%;
  }

  /* Left Side: Form & Copy */
  .tp-newsletter__left {
    flex: 0 1 480px;
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: auto;
    min-height: 0;
  }

  .tp-newsletter__heading {
    font-size: 22px;
    font-weight: 700;
    color: {{ heading_color }};
    line-height: 1.2;
    margin: 0 0 6px 0;
    font-family: 'Poppins', 'Outfit', sans-serif;
    letter-spacing: -0.01em;
  }

  .tp-newsletter__subheading {
    font-size: 13px;
    color: {{ subheading_color }};
    line-height: 1.4;
    margin: 0 0 16px 0;
  }

  .tp-newsletter__form-wrap {
    width: 100%;
  }

  .tp-newsletter__form {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .tp-newsletter__input {
    flex: 1 1 auto;
    height: 42px;
    background: #FFFFFF;
    border: 1px solid #D8D6CE;
    border-radius: 8px;
    padding: 0 14px;
    font-size: 13.5px;
    color: #1F1E1B;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .tp-newsletter__input:focus {
    border-color: {{ btn_bg_color }};
    box-shadow: 0 0 0 2px rgba(75, 94, 62, 0.15);
  }

  .tp-newsletter__input::placeholder {
    color: #9C9A93;
  }

  .tp-newsletter__btn {
    height: 42px;
    background-color: {{ btn_bg_color }};
    color: {{ btn_text_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 18px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  .tp-newsletter__btn:hover {
    background-color: #3B4B31;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
  }

  .tp-newsletter__msg {
    font-size: 13px;
    font-weight: 600;
    margin-top: 8px;
  }

  .tp-newsletter__msg--success {
    color: #2E6B38;
  }

  .tp-newsletter__msg--error {
    color: #C23333;
  }

  /* Right Side: Perks */
  .tp-newsletter__perks {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
  }

  .tp-newsletter-perk {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tp-newsletter-perk__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #FAF8F4;
    border: 1px solid #E0DDD4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #333333;
  }

  .tp-newsletter-perk__icon svg {
    width: 22px;
    height: 22px;
  }

  .tp-newsletter-perk__text {
    font-size: 12.5px;
    font-weight: 700;
    color: #1F1E1B;
    line-height: 1.25;
    white-space: pre-line;
  }

  /* Mobile Responsive */
  @media (max-width: 991px) {
    .tp-newsletter__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .tp-newsletter__left {
      max-width: 100%;
      width: 100%;
    }

    .tp-newsletter__perks {
      justify-content: space-between;
      gap: 12px;
      width: 100%;
    }
  }

  @media (max-width: 767px) {
    .tp-newsletter-{{ section.id }},
    .tp-newsletter {
      padding-top: 22px !important;
      padding-bottom: 22px !important;
    }

    .tp-newsletter__container {
      padding: 0 16px !important;
    }

    .tp-newsletter__inner {
      gap: 16px !important;
    }

    .tp-newsletter__heading {
      font-size: 19px !important;
      font-weight: 700 !important;
      color: {{ heading_color }} !important;
      margin: 0 0 4px 0 !important;
      line-height: 1.2 !important;
    }

    .tp-newsletter__subheading {
      font-size: 12.5px !important;
      color: {{ subheading_color }} !important;
      margin: 0 0 12px 0 !important;
      line-height: 1.35 !important;
    }

    .tp-newsletter__form {
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      width: 100% !important;
    }

    .tp-newsletter__input {
      flex: 1 1 auto !important;
      height: 42px !important;
      font-size: 13px !important;
      padding: 0 12px !important;
      border-radius: 8px !important;
      background: #FFFFFF !important;
    }

    .tp-newsletter__btn {
      flex: 0 0 auto !important;
      height: 42px !important;
      font-size: 11.5px !important;
      font-weight: 700 !important;
      padding: 0 16px !important;
      border-radius: 8px !important;
      letter-spacing: 0.03em !important;
    }

    /* 3-Column Responsive Grid for Perks on Mobile */
    .tp-newsletter__perks {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 8px !important;
      width: 100% !important;
      padding-top: 14px !important;
      border-top: 1px solid rgba(0, 0, 0, 0.08) !important;
      overflow: visible !important;
    }

    .tp-newsletter-perk {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: flex-start !important;
      text-align: center !important;
      gap: 6px !important;
      min-width: 0 !important;
      width: 100% !important;
    }

    .tp-newsletter-perk__icon {
      width: 36px !important;
      height: 36px !important;
      border-radius: 50% !important;
      background: #FAF8F4 !important;
      border: 1px solid #E2DED4 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      margin: 0 auto !important;
      flex-shrink: 0 !important;
    }

    .tp-newsletter-perk__icon svg {
      width: 17px !important;
      height: 17px !important;
    }

    .tp-newsletter-perk__text {
      font-size: 10.5px !important;
      font-weight: 600 !important;
      color: #2B2927 !important;
      line-height: 1.25 !important;
      text-align: center !important;
      white-space: normal !important;
      word-break: normal !important;
    }
  }
{%- endstyle -%}

<section
  id="tp-newsletter-{{ section.id }}"
  class="tp-newsletter tp-newsletter-{{ section.id }}"
  aria-label="{{ heading | escape }}"
>
  <div class="tp-newsletter__container">
    <div class="tp-newsletter__inner">
      
      <!-- Left: Heading, Subtitle & Form -->
      <div class="tp-newsletter__left">
        {%- if heading != blank -%}
          <h2 class="tp-newsletter__heading">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="tp-newsletter__subheading">{{ subheading | escape }}</p>
        {%- endif -%}

        <div class="tp-newsletter__form-wrap">
          {%- form 'customer', class: 'tp-newsletter__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              id="tp-newsletter-email-{{ section.id }}"
              class="tp-newsletter__input"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              placeholder="{{ placeholder_text | escape }}"
              aria-label="{{ placeholder_text | escape }}"
              autocorrect="off"
              autocapitalize="off"
              required
            >
            <button type="submit" class="tp-newsletter__btn">
              {{ button_text | escape }}
            </button>

            {%- if form.posted_successfully? -%}
              <p class="tp-newsletter__msg tp-newsletter__msg--success" role="status">
                {{ 'general.newsletter_form.confirmation' | t | default: 'Thank you for subscribing!' }}
              </p>
            {%- elsif form.errors -%}
              <p class="tp-newsletter__msg tp-newsletter__msg--error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

      <!-- Right: 3 Perks -->
      <div class="tp-newsletter__perks">
        
        <!-- Perk 1: Exclusive Offers -->
        <div class="tp-newsletter-perk">
          <div class="tp-newsletter-perk__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div class="tp-newsletter-perk__text">{{ section.settings.perk_1_text | default: 'Exclusive
Offers' }}</div>
        </div>

        <!-- Perk 2: Early Access -->
        <div class="tp-newsletter-perk">
          <div class="tp-newsletter-perk__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div class="tp-newsletter-perk__text">{{ section.settings.perk_2_text | default: 'Early Access to
New Launches' }}</div>
        </div>

        <!-- Perk 3: Period Care Tips -->
        <div class="tp-newsletter-perk">
          <div class="tp-newsletter-perk__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
          </div>
          <div class="tp-newsletter-perk__text">{{ section.settings.perk_3_text | default: 'Tips for Better
Period Care' }}</div>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stay in the Loop",
  "tag": "section",
  "class": "tp-newsletter-section",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get updates on offers, new launches & period care tips."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "header",
      "content": "Perks Text"
    },
    {
      "type": "textarea",
      "id": "perk_1_text",
      "label": "Perk 1 Text",
      "default": "Exclusive\nOffers"
    },
    {
      "type": "textarea",
      "id": "perk_2_text",
      "label": "Perk 2 Text",
      "default": "Early Access to\nNew Launches"
    },
    {
      "type": "textarea",
      "id": "perk_3_text",
      "label": "Perk 3 Text",
      "default": "Tips for Better\nPeriod Care"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#EFEFE8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1F1E1B"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#52504C"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#4B5E3E"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Stay in the Loop"
    }
  ]
}
{% endschema %}
