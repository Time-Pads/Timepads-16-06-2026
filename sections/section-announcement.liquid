{%- comment -%}
  TIMEPADS - Ultra-Fast Pure CSS Scrolling Promotion Bar
  Target: Lighthouse 95+ Mobile | CLS = 0 | LCP Unaffected | 0 KB JS | HTML < 2 KB | CSS < 2 KB
{%- endcomment -%}

{%- liquid
  assign bg_color = section.settings.bg_color | default: '#46543E'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign desktop_size = section.settings.desktop_font_size | default: 16
  assign mobile_size = section.settings.mobile_font_size | default: 14
  assign speed = section.settings.animation_speed | default: 25
  assign pause_hover = section.settings.pause_on_hover
  assign pad_top = section.settings.padding_top | default: 0
  assign pad_bottom = section.settings.padding_bottom | default: 0

  assign items = section.blocks
-%}

{%- style -%}
  .tp-promo-{{ section.id }} {
    --tp-promo-bg: {{ bg_color }};
    --tp-promo-text: {{ text_color }};
    --tp-promo-size-desktop: {{ desktop_size }}px;
    --tp-promo-size-mobile: {{ mobile_size }}px;
    --tp-promo-speed: {{ speed }}s;
    --tp-promo-pt: {{ pad_top }}px;
    --tp-promo-pb: {{ pad_bottom }}px;
  }
{%- endstyle -%}

<section
  id="shopify-section-promo-{{ section.id }}"
  class="tp-promo tp-promo-{{ section.id }}"
  role="region"
  aria-label="Scrolling Promotion"
>
  <div class="tp-promo__container{% if pause_hover %} tp-promo__container--pause-hover{% endif %}">
    <div class="tp-promo__track">
      {%- comment -%} Render items twice via Liquid for seamless CSS infinite scroll {%- endcomment -%}
      {%- for loop_index in (1..2) -%}
        <div class="tp-promo__group" aria-hidden="{% if loop_index == 2 %}true{% else %}false{% endif %}">
          {%- if items.size > 0 -%}
            {%- for block in items -%}
              {%- liquid
                assign item_text = block.settings.text | default: block.settings.title | default: block.settings.message | strip_html
                assign item_link = block.settings.link | default: block.settings.url
                assign item_svg = block.settings.svg_icon | default: block.settings.icon_svg
              -%}

              {%- if item_text != blank -%}
                <div class="tp-promo__item" {{ block.shopify_attributes }}>
                  {%- if item_link != blank -%}
                    <a href="{{ item_link }}" class="tp-promo__link">
                  {%- endif -%}

                  {%- if item_svg != blank -%}
                    <span class="tp-promo__icon">{{ item_svg }}</span>
                  {%- else -%}
                    <span class="tp-promo__icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                  {%- endif -%}

                  <span class="tp-promo__text">{{ item_text }}</span>

                  {%- if item_link != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <!-- Default Preset Items if No Blocks Configured -->
            <div class="tp-promo__item">
              <span class="tp-promo__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
              <span class="tp-promo__text">Clinically Tested</span>
            </div>
            <div class="tp-promo__item">
              <span class="tp-promo__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></span>
              <span class="tp-promo__text">100% Rash Free</span>
            </div>
            <div class="tp-promo__item">
              <span class="tp-promo__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg></span>
              <span class="tp-promo__text">Fast Delivery</span>
            </div>
            <div class="tp-promo__item">
              <span class="tp-promo__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg></span>
              <span class="tp-promo__text">Leak Proof</span>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .tp-promo-{{ section.id }} {
    background-color: #b7a487 !important;
    color: var(--tp-promo-text);
    padding-top: var(--tp-promo-pt);
    padding-bottom: var(--tp-promo-pb);
    width: 100%;
    min-height: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    z-index: 40;
    font-family: 'Poppins', sans-serif;
  }
  @media (min-width: 768px) {
    .tp-promo-{{ section.id }} {
      min-height: 52px;
      height: 52px;
    }
  }

  .tp-promo-{{ section.id }} .tp-promo__container {
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .tp-promo-{{ section.id }} .tp-promo__track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: tp-marquee var(--tp-promo-speed) linear infinite;
  }

  .tp-promo-{{ section.id }} .tp-promo__container--pause-hover:hover .tp-promo__track {
    animation-play-state: paused;
  }

  .tp-promo-{{ section.id }} .tp-promo__group {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-right: 32px;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .tp-promo-{{ section.id }} .tp-promo__group {
      gap: 48px;
      padding-right: 48px;
    }
  }

  .tp-promo-{{ section.id }} .tp-promo__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: var(--tp-promo-size-mobile);
    font-weight: 600;
    letter-spacing: 0.3px;
    color: inherit;
  }
  @media (min-width: 768px) {
    .tp-promo-{{ section.id }} .tp-promo__item {
      font-size: var(--tp-promo-size-desktop);
    }
  }

  .tp-promo-{{ section.id }} .tp-promo__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }
  .tp-promo-{{ section.id }} .tp-promo__link:hover {
    text-decoration: underline;
  }

  .tp-promo-{{ section.id }} .tp-promo__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    flex-shrink: 0;
  }
  .tp-promo-{{ section.id }} .tp-promo__icon svg {
    width: 18px;
    height: 18px;
    display: block;
    stroke: currentColor;
  }

  @keyframes tp-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-promo-{{ section.id }} .tp-promo__track {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Scrolling Promotion",
  "tag": "section",
  "class": "tp-scrolling-promo-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#46543E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Animation Speed",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Enable Pause On Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Promotion Item (Text)",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Safe & Reliable"
        },
        {
          "type": "html",
          "id": "svg_icon",
          "label": "Custom SVG Icon HTML (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    },
    {
      "type": "icon_block",
      "name": "Promotion Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Clinically Tested"
        },
        {
          "type": "html",
          "id": "svg_icon",
          "label": "Custom SVG Icon HTML"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    },
    {
      "type": "message",
      "name": "Promotion Item (Message)",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "custom",
      "name": "Promotion Item (Custom)",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling Promotion"
    }
  ]
}
{% endschema %}
