<!-- /sections/gif-images-usp.liquid -->

{%- capture lazy_load_section -%}{%- render 'lazy-load-section-validations' -%}{%- endcapture -%}

{%- assign sid = section.id -%}
{%- assign pt  = section.settings.padding_top -%}
{%- assign pb  = section.settings.padding_bottom -%}
{%- assign mpt = section.settings.padding_top_mobile -%}
{%- assign mpb = section.settings.padding_bottom_mobile -%}

{% style %}
  #shopify-section-{{ sid }} {
    padding-top: {{ pt }}px !important;
    padding-bottom: {{ pb }}px !important;
    contain-intrinsic-size: 1px 180px;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ sid }} {
      padding-top: {{ mpt }}px !important;
      padding-bottom: {{ mpb }}px !important;
    }
  }
  {%- if section.settings.heading_text != blank -%}
    .gif-usp-{{ sid }} h2 {
      font-size: {{ section.settings.font_size }}px;
      font-weight: {{ section.settings.font_weight }};
      {%- if section.settings.text_color != blank and section.settings.text_color != 'rgba(0,0,0,0)' -%}
        color: {{ section.settings.text_color }};
      {%- endif -%}
    }
  {%- endif -%}

  body.template-product h2.kicker-flourished {
    margin-bottom: 0;
    padding-bottom: 0;
  }

  #shopify-section-{{ sid }} .gif-section--main-content {
    position: relative;
  }

  #shopify-section-{{ sid }} .gif-section--image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 45px;
    padding: 10px 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #shopify-section-{{ sid }} .gif-section--image-wrapper::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ sid }} .gif-section--image-wrapper img {
    padding: 10px;
    width: 210px;
    height: auto;
    padding-bottom: 0;
    display: block;
  }

  @media (max-width: 770px) {
    #shopify-section-{{ sid }} .gif-section--main-content {
      margin-bottom: 1rem;
    }

    #shopify-section-{{ sid }} .gif-section--image-wrapper {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0;
      padding: 0;
    }

    #shopify-section-{{ sid }} .gif-section--image-wrapper picture {
      flex: 0 0 30%;
    }

    #shopify-section-{{ sid }} .gif-section--image-wrapper img {
      width: 100%;
      padding: 0;
    }
  }
{% endstyle %}

{%- if lazy_load_section != blank -%}<lazy-section style="display: block; min-height: 180px;">{%- endif -%}

{%- if lazy_load_section == blank -%}
  <div class="page-width gif-usp-{{ sid }}">
    <div class="gif-section--main-content">

      {%- if section.settings.heading_text != blank -%}
        <h2 class="kicker-flourished mb-r11">{{ section.settings.heading_text | escape }}</h2>
      {%- endif -%}

      <div class="tp-benefits-strip-card">
        <div class="tp-benefits-strip-card__col">
          <div class="tp-benefits-strip-card__icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11c0 4.5 3.5 8 8 8s8-3.5 8-8H4z"></path>
              <line x1="3" y1="11" x2="21" y2="11"></line>
              <line x1="12" y1="11" x2="12" y2="5"></line>
              <path d="M12 8c-2-2-3.5-1-4.5 1 2 1 3.5 0 4.5-1z"></path>
              <path d="M12 7c2-2 3.5-1 4.5 1-2 1-3.5 0-4.5-1z"></path>
            </svg>
          </div>
          <span class="tp-benefits-strip-card__label">Ayurvedic<br>Care</span>
        </div>
        <div class="tp-benefits-strip-card__col">
          <div class="tp-benefits-strip-card__icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3c-1.5 2-3 3.8-3 5.5a3 3 0 0 0 6 0c0-1.7-1.5-3.5-3-5.5z"></path>
              <path d="M4 14c2.5-1 5.5-1 8 0s5.5 1 8 0"></path>
              <path d="M4 17c2.5-1 5.5-1 8 0s5.5 1 8 0"></path>
              <circle cx="7" cy="20" r="1" fill="#164A36"></circle>
              <circle cx="12" cy="20" r="1" fill="#164A36"></circle>
              <circle cx="17" cy="20" r="1" fill="#164A36"></circle>
            </svg>
          </div>
          <span class="tp-benefits-strip-card__label">Skin<br>Friendly</span>
        </div>
        <div class="tp-benefits-strip-card__col">
          <div class="tp-benefits-strip-card__icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="14" cy="13" r="7"></circle>
              <polyline points="14 10 14 13 16.5 14.5"></polyline>
              <line x1="14" y1="4" x2="14" y2="6"></line>
              <line x1="12" y1="4" x2="16" y2="4"></line>
              <line x1="2" y1="9" x2="6" y2="9"></line>
              <line x1="1" y1="13" x2="5" y2="13"></line>
              <line x1="3" y1="17" x2="6" y2="17"></line>
            </svg>
          </div>
          <span class="tp-benefits-strip-card__label">Instant<br>Relief</span>
        </div>
        <div class="tp-benefits-strip-card__col">
          <div class="tp-benefits-strip-card__icon-wrap">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#164A36" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"></path>
              <path d="M15 9c-3 0-5 2-6 5 2.5 0 5-1.5 6-5z"></path>
              <path d="M9 14l3-3"></path>
            </svg>
          </div>
          <span class="tp-benefits-strip-card__label">Moody<br>Free Days</span>
        </div>
      </div>

    </div>
  </div>
{%- else -%}
  <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg" width="66" height="66">
    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
  </svg>
{%- endif -%}

{%- if lazy_load_section != blank -%}</lazy-section>{%- endif -%}

{% schema %}
{
  "name": "Gif Images USP",
  "tag": "section",
  "class": "circular-collection",
  "settings": [
    { "type": "header", "content": "Padding settings" },
    { "type": "range", "id": "padding_top",          "min": 0, "max": 100, "default": 20, "step": 2, "unit": "px", "label": "Padding Top" },
    { "type": "range", "id": "padding_bottom",        "min": 0, "max": 100, "default": 20, "step": 2, "unit": "px", "label": "Padding Bottom" },
    { "type": "range", "id": "padding_top_mobile",    "min": 0, "max": 100, "default": 20, "step": 2, "unit": "px", "label": "Padding Top Mobile" },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "default": 20, "step": 2, "unit": "px", "label": "Padding Bottom Mobile" },
    { "type": "header", "content": "Heading Settings" },
    { "type": "text",  "id": "heading_text",  "label": "Heading" },
    { "type": "range", "id": "font_size",     "min": 12, "max": 50, "default": 12, "step": 2, "unit": "px", "label": "Heading Font Size" },
    { "type": "range", "id": "font_weight",   "min": 400, "max": 900, "default": 400, "step": 100, "label": "Font Weight" },
    { "type": "color", "id": "text_color",    "label": "Text Color" }
  ],
  "blocks": [
    {
      "type": "Collection-Images",
      "name": "Collection Images",
      "settings": [
        { "type": "image_picker", "id": "collection_image", "label": "Collection Image" },
        { "type": "text",         "id": "alt_text",         "label": "Image Alt text" }
      ]
    }
  ],
  "presets": [
    { "name": "Gif Images USP" }
  ]
}
{% endschema %}
