<div data-api-content class="upsell__cards-scroll-track">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- for upsell_product in recommendations.products -%}
      {% render 'product-clip' card_product: upsell_product %}
    {%- endfor -%}
  {%- else -%}
    {%- assign fallback_count = 0 -%}
    {%- for fallback_product in collections.all.products -%}
      {%- if fallback_product.id != product.id and fallback_product.available -%}
        {% render 'product-clip' card_product: fallback_product %}
        {%- assign fallback_count = fallback_count | plus: 1 -%}
        {%- if fallback_count >= 3 -%}
          {%- break -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>