<!-- /sections/footer.liquid -->

{% style %}
  /* Google Fonts loaded async via theme.liquid */

  /* ─── TIME MASTER FOOTER SYSTEM — PERFECT VISUAL REFERENCE MATCH ─── */
  .tp-footer-master {
    background-color: #f6ead7 !important; /* Deep dark plum #241D25 */
    color: black !important;
    border-top: 3px solid var(--time-primary) !important;
    position: relative;
    overflow: hidden;
    font-family: 'Poppins', var(--FONT-STACK-BODY), sans-serif;
    padding-top: 32px;
    padding-bottom: 16px;
  }

  /* Botanical Background SVG Accents */
  .tp-footer-bg-accent {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }

  .tp-bg-leaf-top-left {
    top: -10px;
    left: -10px;
    width: 160px;
    height: 160px;
  }

  .tp-bg-stem-bottom-left {
    bottom: 40px;
    left: 0px;
    width: 90px;
    height: 180px;
  }

  .tp-bg-leaf-bottom-corner {
    bottom: 30px;
    left: -10px;
    width: 100px;
    height: 100px;
  }

  .tp-bg-leaf-top-right {
    top: -10px;
    right: -10px;
    width: 160px;
    height: 160px;
  }

  .tp-bg-heart-right {
    right: 15px;
    top: 45%;
    width: 28px;
    height: 28px;
  }

  .tp-bg-leaf-bottom-right {
    bottom: 40px;
    right: -10px;
    width: 90px;
    height: 90px;
  }

  /* Main Grid Layout */
  .tp-footer-container {
    position: relative;
    z-index: 2;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .tp-footer-grid {
    display: grid;
    grid-template-columns: 2.2fr 1.35fr 1.45fr 1.35fr 3.3fr;
    gap: 0;
    align-items: flex-start;
  }

  /* Column Base Styling */
  .tp-footer-col {
    padding: 0 22px;
    display: flex;
    flex-direction: column;
  }

  .tp-footer-col:first-child {
    padding-left: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    padding-right: 22px;
  }

  .tp-footer-col:last-child {
    padding-right: 0;
  }

  /* Specific Vertical Dividers matching Image 2 */
  .tp-nav-col-2 {
    padding: 0 22px;
  }

  .tp-nav-col-2 .tp-nav-inner {
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    padding-right: 22px;
  }

  .tp-nav-col-3 {
    padding: 0 22px;
  }

  .tp-nav-col-3 .tp-nav-inner {
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    padding-right: 22px;
  }

  .tp-nav-col-4 {
    padding: 0 22px;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    align-self: stretch;
  }

  /* Headings & Accent Bars */
  .tp-footer-heading {
    color: black !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    margin-bottom: 18px !important;
    display: inline-block;
    position: relative;
    line-height: 1.2;
  }

  .tp-footer-heading::after {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background-color: var(--time-primary-light);
    margin-top: 4px;
    border-radius: 2px;
  }

  /* ─── 1. BRAND COLUMN ─── */
  .tp-brand-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .tp-brand-logo-area {
    margin-bottom: 2px;
  }

  .tp-brand-logo-serif {
    font-family: 'Playfair Display', 'Cinzel', Didot, serif;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--time-white);
    line-height: 1;
    display: inline-flex;
    align-items: flex-start;
  }

  .tp-trademark {
    font-size: 12px;
    font-weight: 600;
    margin-left: 2px;
    top: -4px;
    position: relative;
  }

  .tp-brand-logo-sub {
    font-family: 'Poppins', sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.42em;
    color: var(--time-primary-light);
    margin-top: 4px;
    text-transform: uppercase;
  }

  .tp-brand-script-wrap {
    margin: 6px 0 8px;
    text-align: center;
    position: relative;
    display: inline-block;
  }

  .tp-brand-script {
    font-family: 'Caveat', 'Dancing Script', cursive;
    font-size: 26px;
    color: black;
    line-height: 1.05;
  }

  .tp-script-main {
    position: relative;
  }

  .tp-script-heart {
    display: inline-block;
    margin-left: 3px;
    font-size: 20px;
    vertical-align: middle;
  }

  .tp-script-underline {
    width: 125px;
    height: 11px;
    margin-top: -2px;
    display: block;
  }

  .tp-brand-desc {
    font-size: 12px;
    line-height: 1.45;
    color: black;
    max-width: 220px;
    margin-bottom: 16px;
    opacity: 0.9;
  }

  /* Brand Values */
  .tp-brand-values {
    display: flex;
    gap: 12px;
    justify-content: center;
    width: 100%;
    margin-top: 8px;
  }

  .tp-value-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
  }

  .tp-value-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    border: 1.2px solid rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 5px;
  }

  .tp-value-icon-circle svg {
    width: 17px;
    height: 17px;
    stroke: black;
    fill: none;
  }

  .tp-value-label {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: black;
    line-height: 1.2;
  }

  /* ─── 2. NAV COLUMNS (EXPLORE, POLICIES, QUICK LINKS) ─── */
  .tp-nav-inner {
    display: flex;
    flex-direction: column;
  }

  .tp-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tp-nav-list li a {
    color: black !important;
    font-size: 13.5px !important;
    text-decoration: none !important;
    transition: all 0.22s ease !important;
    display: inline-block;
    opacity: 0.9;
  }

  .tp-nav-list li a:hover {
    color: var(--time-white) !important;
    opacity: 1 !important;
    transform: translateX(3px);
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
  }

  /* ─── 3. CONTACT & NEWSLETTER COLUMN ─── */
  .tp-contact-col {
    display: flex;
    flex-direction: column;
  }

  .tp-contact-items {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 12px;
  }

  .tp-contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 9px;
    margin-bottom: 9px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .tp-contact-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .tp-contact-icon-circle {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--time-primary-dark); /* Deep taupe #75614C */
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tp-contact-icon-circle svg {
    width: 15px;
    height: 15px;
    fill: var(--time-white);
    stroke: var(--time-white);
  }

  .tp-contact-text-wrap {
    display: flex;
    flex-direction: column;
  }

  .tp-contact-title {
    color: black;
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.2;
  }

  .tp-contact-detail,
  .tp-contact-detail a {
    color: black !important;
    font-size: 12px !important;
    line-height: 1.35 !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
  }

  .tp-contact-detail a:hover {
    color: var(--time-white) !important;
    text-decoration: underline !important;
  }

  /* Newsletter Area */
  .tp-newsletter-area {
    margin-top: 6px;
    margin-bottom: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .tp-newsletter-subtext {
    font-size: 11.5px;
    color: black;
    margin-bottom: 8px;
    opacity: 0.9;
  }

  .tp-newsletter-box {
    display: flex;
    align-items: center;
    border: 1px solid var(--time-primary-light);
    border-radius: 999px;
    padding: 3px 3px 3px 14px;
    background: var(--time-surface);
    max-width: 380px;
  }

  .tp-newsletter-input {
    background: transparent !important;
    border: none !important;
    outline: none !important;
    color: var(--time-text) !important;
    font-size: 12px !important;
    flex: 1;
    padding: 5px 0;
  }

  .tp-newsletter-input::placeholder {
    color: var(--time-text-secondary) !important;
  }

  .tp-newsletter-btn {
    background: var(--time-primary) !important;
    color: var(--time-text) !important;
    border: none !important;
    border-radius: 999px !important;
    padding: 6px 16px !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    white-space: nowrap;
  }

  .tp-newsletter-btn:hover {
    background: var(--time-white) !important;
    transform: scale(1.02);
  }

  /* Social Media Area */
  .tp-social-area {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .tp-social-icons {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .tp-social-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--time-primary-dark); /* Deep taupe #75614C */
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--time-white);
    text-decoration: none;
    transition: all 0.25s ease;
    font-weight: 700;
    font-size: 13.5px;
  }

  .tp-social-btn:hover {
    background: var(--time-primary);
    border-color: var(--time-primary-light);
    transform: translateY(-2px);
  }

  .tp-social-btn svg {
    width: 14px;
    height: 14px;
    fill: var(--time-white);
  }

  /* Right Edge Tagline */
  .tp-right-tagline {
    position: absolute;
    right: 0;
    bottom: -4px;
    font-family: 'Caveat', 'Dancing Script', cursive;
    font-size: 20px;
    color: var(--time-primary-light);
    text-align: right;
    line-height: 1.1;
    opacity: 0.85;
    pointer-events: none;
  }

  /* ─── INTEGRATED BOTTOM BAR MATCHING IMAGE 2 ─── */
  .tp-footer-bottom-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    margin-top: 24px;
    padding-top: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: black;
    font-size: 12px;
  }

  .tp-bottom-left {
    color: black;
    font-weight: 500;
  }

  .tp-bottom-center {
    display: flex;
    align-items: center;
    gap: 14px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 11px;
    font-weight: 600;
    color: black;
    opacity: 0.9;
  }

  .tp-bottom-tick {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.25);
  }

  .tp-bottom-right {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .tp-payment-logos {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .tp-secure-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    color: black;
    font-weight: 600;
    font-size: 11.5px;
    margin-left: 4px;
  }

  /* Mobile Accordions & Responsiveness */
  @media (max-width: 1024px) {
    .tp-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .tp-footer-col,
    .tp-nav-col-2,
    .tp-nav-col-3,
    .tp-nav-col-4 {
      border-right: none !important;
      padding: 0 !important;
    }
    .tp-nav-inner {
      border-right: none !important;
      padding-right: 0 !important;
    }
    .tp-brand-col {
      grid-column: span 2;
    }
    .tp-contact-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .tp-footer-master {
      padding-top: 24px;
      padding-bottom: 16px;
    }
    .tp-footer-container {
      padding: 0 16px;
    }
    .tp-footer-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 22px 18px !important;
    }
    .tp-brand-col {
      grid-column: 1 / -1 !important;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
      padding-bottom: 20px !important;
    }
    .tp-nav-col-2 {
      grid-column: 1 !important;
      border-right: none !important;
      padding: 0 !important;
    }
    .tp-nav-col-3 {
      grid-column: 2 !important;
      border-right: none !important;
      padding: 0 !important;
    }
    .tp-nav-col-4 {
      grid-column: 1 / -1 !important;
      border-right: none !important;
      padding: 0 !important;
    }
    .tp-contact-col {
      grid-column: 1 / -1 !important;
      border-right: none !important;
      padding: 0 !important;
    }
    .tp-nav-col-2,
    .tp-nav-col-3 {
      border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
      padding-bottom: 16px !important;
    }
    .tp-nav-col-4 {
      border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
      padding-bottom: 16px !important;
    }
    .tp-nav-list {
      gap: 14px !important;
    }
    .tp-footer-heading {
      margin-bottom: 14px !important;
    }
    .tp-right-tagline {
      display: none;
    }
    .tp-footer-bottom-bar {
      flex-direction: column;
      text-align: center;
      gap: 10px;
    }
  }
{% endstyle %}

<footer class="tp-footer-master" data-section-id="{{ section.id }}" data-section-type="footer">
  <!-- Botanical Background Accents matching Reference Image 2 -->
  <svg
    class="tp-footer-bg-accent tp-bg-leaf-top-left"
    viewBox="0 0 200 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M-20 -20 Q40 50 160 110" stroke="#B882A8" stroke-width="2.5" fill="none" opacity="0.65"/>
    <path d="M-20 -20 C30 40 80 80 140 100 C110 70 80 40 20 -20 Z" fill="#9C6B8E" opacity="0.45"/>
    <path d="M10 10 C35 5 60 20 65 45 C45 40 20 30 10 10Z" fill="#B882A8" opacity="0.55"/>
    <path d="M35 35 C65 25 95 45 100 75 C75 65 45 55 35 35Z" fill="#A46E94" opacity="0.55"/>
    <path d="M70 60 C105 50 135 75 145 105 C115 95 85 80 70 60Z" fill="#B882A8" opacity="0.55"/>
    <path d="M25 20 C15 45 30 75 55 80 C50 55 40 30 25 20Z" fill="#9C6B8E" opacity="0.5"/>
    <path d="M55 45 C45 75 65 105 95 110 C85 85 75 55 55 45Z" fill="#A46E94" opacity="0.5"/>
  </svg>

  <svg
    class="tp-footer-bg-accent tp-bg-stem-bottom-left"
    viewBox="0 0 120 250"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M10 240 Q40 140 30 10" stroke="#B882A8" stroke-width="1.8" fill="none" opacity="0.5"/>
    <path d="M26 190 C45 180 55 160 45 145 C35 155 25 175 26 190Z" stroke="#B882A8" stroke-width="1.2" fill="none" opacity="0.5"/>
    <path d="M22 195 C5 185 -5 165 5 150 C15 160 20 180 22 195Z" stroke="#B882A8" stroke-width="1.2" fill="none" opacity="0.5"/>
    <path d="M30 130 C50 120 60 100 50 85 C40 95 30 115 30 130Z" stroke="#B882A8" stroke-width="1.2" fill="none" opacity="0.5"/>
    <path d="M28 135 C10 125 0 105 10 90 C20 100 25 120 28 135Z" stroke="#B882A8" stroke-width="1.2" fill="none" opacity="0.5"/>
  </svg>

  <svg
    class="tp-footer-bg-accent tp-bg-leaf-bottom-corner"
    viewBox="0 0 100 120"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M-10 130 C30 100 40 40 100 0 C60 40 10 70 -10 130Z" fill="#9C6B8E" opacity="0.5"/>
  </svg>

  <svg
    class="tp-footer-bg-accent tp-bg-leaf-top-right"
    viewBox="0 0 200 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M220 -20 Q160 50 40 110" stroke="#B7A487" stroke-width="2.5" fill="none" opacity="0.65"/>
    <path d="M190 10 C165 5 140 20 135 45 C155 40 180 30 190 10Z" fill="#B7A487" opacity="0.55"/>
    <path d="M165 35 C135 25 105 45 100 75 C125 65 155 55 165 35Z" fill="#E8D9C3" opacity="0.55"/>
    <path d="M130 60 C95 50 65 75 55 105 C85 95 115 80 130 60Z" fill="#B7A487" opacity="0.55"/>
  </svg>

  <svg class="tp-footer-bg-accent tp-bg-heart-right" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M20 34 L17.5 31.6 C8.8 23.7 3 18.5 3 12 C3 6.7 7.2 2.5 12.5 2.5 C15.5 2.5 18.4 3.9 20 6.1 C21.6 3.9 24.5 2.5 27.5 2.5 C32.8 2.5 37 6.7 37 12 C37 18.5 31.2 23.7 22.5 31.6 L20 34 Z" stroke="#B7A487" stroke-width="1.6" fill="none" opacity="0.75"/>
  </svg>

  <svg
    class="tp-footer-bg-accent tp-bg-leaf-bottom-right"
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M110 110 C70 80 60 20 0 -10 C40 30 90 60 110 110Z" fill="#E8D9C3" opacity="0.5"/>
  </svg>

  <div class="tp-footer-container">
    <div class="tp-footer-grid">
      <!-- 1. BRAND COLUMN -->
      <div class="tp-footer-col tp-brand-col">
        <div class="tp-brand-logo-area">
          {% if section.settings.footer_image %}
            <a href="{{ routes.root_url }}">
              <img
                src="{{ section.settings.footer_image | image_url: width: 240 }}"
                alt="{{ shop.name }}"
                style="max-width: 150px; height: auto;"
                loading="lazy"
              >
            </a>
          {% else %}
            <a href="{{ routes.root_url }}" style="text-decoration: none;">
              {% comment %}
                <div class="tp-brand-logo-serif">TIME<span class="tp-trademark">™</span></div>
                <div class="tp-brand-logo-sub">SANITARY PADS</div>
              {% endcomment %}
              <img
                src="https://cdn.shopify.com/s/files/1/0845/7886/1371/files/log-1.webp?v=1784808608"
                alt="timepads"
              />
            </a>
          {% endif %}
        </div>

        <div class="tp-brand-script-wrap">
          <div class="tp-brand-script">
            Because Every Woman<br>
            <span class="tp-script-main">Deserves Better Care <span class="tp-script-heart">♡</span></span>
          </div>
          <svg class="tp-script-underline" viewBox="0 0 160 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 12 Q80 18 145 5" stroke="#B7A487" stroke-width="2" stroke-linecap="round" fill="none"/>
          </svg>
        </div>

        <p class="tp-brand-desc">Thoughtfully designed period care for every woman, every day.</p>

        <!-- 3 Brand Values -->
        <div class="tp-brand-values">
          <div class="tp-value-item">
            <div class="tp-value-icon-circle">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 9a9 9 0 0 1-10 9Z"/>
                <path d="M11 20v-8"/>
              </svg>
            </div>
            <div class="tp-value-label">
              Real<br>
              Care
            </div>
          </div>

          <div class="tp-value-item">
            <div class="tp-value-icon-circle">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </div>
            <div class="tp-value-label">
              Real<br>
              Comfort
            </div>
          </div>

          <div class="tp-value-item">
            <div class="tp-value-icon-circle">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3c2.5 3 4.5 6.5 4.5 10.5C16.5 17.5 14.5 20 12 21c-2.5-1-4.5-3.5-4.5-7.5C7.5 9.5 9.5 6 12 3Z"/>
                <path d="M12 21c4-1 8-5 8-10 0-2-1-3.5-2.5-4.5C16 9 14 12 12 15"/>
                <path d="M12 21c-4-1-8-5-8-10 0-2 1-3.5 2.5-4.5C8 9 10 12 12 15"/>
              </svg>
            </div>
            <div class="tp-value-label">
              A Brighter<br>
              You
            </div>
          </div>
