{% comment %}
  Master Reference Implementation: "Why Choose TIME?" Section
  Shopify Section for Timepads theme with Falling Product Cascade & Customizer Options
{% endcomment %}

<style>
  /* Google Fonts loaded async via theme.liquid */

  #WhyChooseTime-{{ section.id }} {
    --color-primary: var(--time-primary);
    --color-primary-dark: var(--time-primary-dark);
    --color-primary-light: var(--time-primary-light);
    --color-background: var(--time-background);
    --color-background-secondary: var(--time-background-secondary);
    --color-surface: var(--time-surface);
    --color-text: var(--time-text);
    --color-text-secondary: var(--time-text-secondary);
    --color-border: var(--time-border);
  }

  .why-choose-time-section {
    position: relative;
    background-color: var(--color-background);
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    overflow: hidden;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--color-text);
    width: 100%;
  }

  /* Soft Background Accent Circles */
  .why-time-bg-blob {
    position: absolute;
    border-radius: 50%;
    background: var(--color-background-secondary);
    pointer-events: none;
    z-index: 1;
    opacity: 0.85;
  }

  .why-time-bg-blob-left {
    width: 340px;
    height: 340px;
    left: -80px;
    bottom: -80px;
  }

  .why-time-bg-blob-right {
    width: 380px;
    height: 380px;
    right: -60px;
    bottom: -100px;
  }

  .why-time-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
    position: relative;
    z-index: 5;
  }

  /* Outer Wrapper for absolute positioning of decorations */
  .why-time-outer-wrapper {
    position: relative;
    max-width: 1380px;
    margin: 0 auto;
    width: 100%;
  }

  /* Header Section */
  .why-time-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 20px auto;
    position: relative;
    z-index: 5;
  }

  .why-time-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .why-time-headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 44px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 12px 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .why-time-accent {
    color: var(--color-primary);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .why-time-headline-heart-img {
    width: 44px;
    height: auto;
    display: inline-block;
    vertical-align: middle;
    margin-left: 4px;
    transform: rotate(3deg) translateY(-2px);
  }

  .why-time-subtitle {
    font-size: 17px;
    font-weight: 400;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Top Right Circular Badge */
  .why-time-badge {
    position: absolute;
    top: 15px;
    right: 320px;
    width: 130px;
    height: 130px;
    border: 1.5px solid var(--color-primary-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    z-index: 6;
    background: rgba(250, 247, 251, 0.7);
    backdrop-filter: blur(4px);
    padding: 3px;
  }

  .why-time-badge-border-inner {
    position: absolute;
    inset: 4px;
    border: 1.5px solid var(--color-primary-light);
    border-radius: 50%;
    pointer-events: none;
  }

  .why-time-badge-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.9px;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .why-time-badge-inner svg {
    margin-top: 4px;
  }

  /* Far Left Handwritten Script */
  .why-time-left-script {
    position: absolute;
    left: 30px;
    top: 90px;
    z-index: 5;
    text-align: left;
    transform: rotate(-6deg);
  }

  .why-time-handwritten {
    font-family: 'Caveat', cursive;
    font-size: 28px;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.15;
    margin: 0 0 4px 0;
  }

  /* Bottom Left Cotton Flower Visual */
  .why-time-cotton-visual {
    position: absolute;
    left: 10px;
    bottom: -30px;
    z-index: 3;
    pointer-events: none;
  }

  .why-time-cotton-visual img {
    width: 175px;
    height: auto;
    display: block;
    object-fit: contain;
    background: transparent;
  }

  /* ── Right-Side Falling Products Cascade ── */
  .why-time-falling-cascade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 320px;
    z-index: 4;
    pointer-events: none;
  }

  .why-time-falling-prod {
    position: absolute;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(123, 63, 109, 0.12));
    transition: transform 0.3s ease;
    will-change: transform;
    animation: whyTimeFloat 6s ease-in-out infinite alternate;
  }

  .why-time-prod-1 {
    top: 10px;
    right: 175px;
    width: 105px;
    height: auto;
    --rot: -15deg;
    transform: rotate(-15deg);
    animation-delay: 0s;
    animation-duration: 5.8s;
  }

  .why-time-prod-2 {
    top: 5px;
    right: 15px;
    width: 135px;
    height: auto;
    --rot: 8deg;
    transform: rotate(8deg);
    animation-delay: 0.9s;
    animation-duration: 6.4s;
  }

  .why-time-prod-3 {
    top: 195px;
    right: 35px;
    width: 145px;
    height: auto;
    --rot: -12deg;
    transform: rotate(-12deg);
    animation-delay: 1.8s;
    animation-duration: 5.4s;
  }

  .why-time-prod-4 {
    top: 385px;
    right: 15px;
    width: 135px;
    height: auto;
    --rot: 16deg;
    transform: rotate(16deg);
    animation-delay: 2.7s;
    animation-duration: 6.2s;
  }

  .why-time-prod-5 {
    bottom: -35px;
    right: -15px;
    width: 225px;
    height: auto;
    --rot: -6deg;
    transform: rotate(-6deg);
    animation-delay: 3.5s;
    animation-duration: 5.6s;
  }

  @keyframes whyTimeFloat {
    0% {
      transform: translateY(0px) rotate(var(--rot, 0deg));
    }
    50% {
      transform: translateY(-8px) rotate(calc(var(--rot, 0deg) + 1.5deg));
    }
    100% {
      transform: translateY(0px) rotate(var(--rot, 0deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-time-falling-prod {
      animation: none !important;
    }
  }

  /* 4 Benefit Cards Grid */
  .why-time-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 36px;
    position: relative;
    z-index: 5;
  }

  .why-time-card {
    background: var(--color-surface);
    border-radius: 16px;
    padding: 32px 18px 28px 18px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(123, 63, 109, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    border: 1px solid var(--color-border);
  }

  .why-time-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(123, 63, 109, 0.1);
  }

  .why-time-icon-wrapper {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--color-background-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .why-time-card-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .why-time-card-desc {
    font-size: 13px;
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* CTA Button */
  .why-time-cta-wrapper {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
    z-index: 5;
  }

  .why-time-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: black;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
    padding: 13px 36px;
    border-radius: 50px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 6px 18px rgba(123, 63, 109, 0.25);
  }

  .why-time-cta-btn:hover {
    background-color: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(123, 63, 109, 0.35);
    color: #FFFFFF;
  }

  /* Bottom Brand Line */
  .why-time-footer-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    position: relative;
    z-index: 5;
  }

  .why-time-divider-line {
    flex: 1;
    max-width: 200px;
    height: 1px;
    background-color: var(--color-border);
  }

  .why-time-footer-text {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .why-time-pipe {
    color: var(--color-primary-light);
    font-weight: 400;
  }

  /* Responsive Design Adjustments */
  @media (max-width: 1320px) {
    .why-time-badge {
      right: 280px;
      width: 110px;
      height: 110px;
    }
    .why-time-prod-1 { width: 90px; right: 140px; }
    .why-time-prod-2 { width: 115px; right: 10px; }
    .why-time-prod-3 { width: 120px; right: 20px; top: 180px; }
    .why-time-prod-4 { width: 110px; right: 10px; top: 350px; }
    .why-time-prod-5 { width: 180px; right: -10px; }
  }

  @media (max-width: 1180px) {
    .why-time-left-script, .why-time-badge {
      display: none;
    }
    .why-time-falling-cascade {
      width: 240px;
    }
    .why-time-prod-1 { display: none; }
  }

  @media (max-width: 991px) {
    .why-time-container {
      max-width: 680px;
    }
    .why-time-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .why-time-falling-cascade, .why-time-cotton-visual {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .wrapper.product__align-left{
      padding: 0 !important;
    }
    .why-choose-time-section {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .why-time-container {
      padding: 0;
    }
    .why-time-header,
    .why-time-cta-wrapper,
    .why-time-footer-line {
      padding-left: 16px;
      padding-right: 16px;
    }
    .why-time-headline {
      font-size: 28px;
    }
    .why-time-subtitle {
      font-size: 14.5px;
    }
    .why-time-cards-grid {
      display: flex !important;
      flex-direction: row !important;
      width: 95% !important;
      margin: auto !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      touch-action: pan-x pan-y !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
      gap: 14px !important;
      padding: 8px 16px 0px 16px !important;
      margin-bottom: 28px !important;
      align-items: stretch !important;
}
    .why-time-cards-grid::-webkit-scrollbar {
      display: none !important;
    }
    .why-time-card {
      flex: 0 0 78% !important;
      max-width: 290px !important;
      scroll-snap-align: start !important;
      box-sizing: border-box !important;
      height: auto !important;
    }
    .why-time-divider-line {
      max-width: 40px;
    }
    .why-time-footer-text {
      font-size: 9px;
      gap: 6px;
    }
  }
</style>

<div class="why-choose-time-section" id="WhyChooseTime-{{ section.id }}">
  <!-- Background Accents -->
  <div class="why-time-bg-blob why-time-bg-blob-left"></div>

  <div class="why-time-outer-wrapper">
    
    <!-- Top-Right Circular Badge (Double Circle Outline) -->
    {% comment %} <div class="why-time-badge">
      <div class="why-time-badge-border-inner"></div>
      <div class="why-time-badge-inner">
        <span>CONFIDENCE</span>
        <span>IN EVERY</span>
        <span>PERIOD</span>
        <svg width="13" height="12" viewBox="0 0 14 13" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 11.875S1.16667 8.08333 1.16667 4.29167C1.16667 2.5 2.625 1.04167 4.41667 1.04167C5.5 1.04167 6.45833 1.58333 7 2.45833C7.54167 1.58333 8.5 1.04167 9.58333 1.04167C11.375 1.04167 12.8333 2.5 12.8333 4.29167C12.8333 8.08333 7 11.875 7 11.875Z" fill="var(--color-primary)"/>
        </svg>
      </div>
    </div> {% endcomment %}

    <!-- Far Left Handwritten Script -->
    <div class="why-time-left-script">
      <p class="why-time-handwritten">
        Comfort<br>
        Through<br>
        Every Cycle
      </p>
      <svg class="why-time-script-heart" width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11 18S2 12 2 6C2 3.2 4.2 1 7 1 C8.8 1 10.3 1.9 11 3.3 C11.7 1.9 13.2 1 15 1 C17.8 1 20 3.2 20 6 C20 12 11 18 11 18Z" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </div>

    <!-- Bottom Left Cotton Flower Visual -->
    <div class="why-time-cotton-visual">
      {% if section.settings.cotton_image != blank %}
        <img src="{{ section.settings.cotton_image | image_url: width: 300 }}" alt="Cotton Flower" loading="lazy" width="175" height="160">
      {% else %}
        <img src="{{ 'why-choose-time-cotton.png' | asset_url }}" alt="Cotton Flower" loading="lazy" width="175" height="160">
      {% endif %}
    </div>

    <!-- ── Right-Side Falling Products Cascade (5 Customizer Configurable Products) ── -->
    <div class="why-time-falling-cascade" aria-hidden="true">
      {% if section.settings.falling_prod_1 != blank %}
        <img src="{{ section.settings.falling_prod_1 | image_url: width: 300 }}" class="why-time-falling-prod why-time-prod-1" alt="Falling Product 1" loading="lazy" width="105" height="160">
      {% else %}
        <img src="{{ 'why-choose-time-prod-1.png' | asset_url }}" class="why-time-falling-prod why-time-prod-1" alt="TIME Cramp Relief Cream" loading="lazy" width="105" height="160">
      {% endif %}

      {% if section.settings.falling_prod_2 != blank %}
        <img src="{{ section.settings.falling_prod_2 | image_url: width: 350 }}" class="why-time-falling-prod why-time-prod-2" alt="Falling Product 2" loading="lazy" width="135" height="150">
      {% else %}
        <img src="{{ 'why-choose-time-prod-2.png' | asset_url }}" class="why-time-falling-prod why-time-prod-2" alt="TIME Ultra Velvet Pads" loading="lazy" width="135" height="150">
      {% endif %}

      {% if section.settings.falling_prod_3 != blank %}
        <img src="{{ section.settings.falling_prod_3 | image_url: width: 350 }}" class="why-time-falling-prod why-time-prod-3" alt="Falling Product 3" loading="lazy" width="145" height="160">
      {% else %}
        <img src="{{ 'why-choose-time-prod-3.png' | asset_url }}" class="why-time-falling-prod why-time-prod-3" alt="TIME Ultra Cuddle Pads" loading="lazy" width="145" height="160">
      {% endif %}

      {% if section.settings.falling_prod_4 != blank %}
        <img src="{{ section.settings.falling_prod_4 | image_url: width: 350 }}" class="why-time-falling-prod why-time-prod-4" alt="Falling Product 4" loading="lazy" width="135" height="160">
      {% else %}
        <img src="{{ 'why-choose-time-prod-4.png' | asset_url }}" class="why-time-falling-prod why-time-prod-4" alt="TIME Menstrual Cup" loading="lazy" width="135" height="160">
      {% endif %}

      {% if section.settings.falling_prod_5 != blank %}
        <img src="{{ section.settings.falling_prod_5 | image_url: width: 450 }}" class="why-time-falling-prod why-time-prod-5" alt="Falling Product 5" loading="lazy" width="225" height="200">
      {% else %}
        <img src="{{ 'why-choose-time-prod-5.png' | asset_url }}" class="why-time-falling-prod why-time-prod-5" alt="TIME Ultra Feather Pads" loading="lazy" width="225" height="200">
      {% endif %}
    </div>

    <div class="why-time-container">
      
      <!-- Header Section -->
      <div class="why-time-header">
        <span class="why-time-eyebrow">{{ section.settings.eyebrow_text | default: "MORE THAN A PAD, A BETTER PERIOD" }}</span>
        <h2 class="why-time-headline">
          {{ section.settings.headline_prefix | default: "Why Choose " }}<span class="why-time-accent">{{ section.settings.headline_accent | default: "TIME?" }}
    
           <?xml version="1.0" encoding="UTF-8"?>
