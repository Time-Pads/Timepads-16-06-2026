</svg>
          </span>
        </h2>
        <p class="why-time-subtitle">{{ section.settings.subtitle | default: "Period care designed around what women actually need." }}</p>
      </div>

      <!-- 4 Benefit Cards Grid -->
      <div class="why-time-cards-grid">
        {% for block in section.blocks %}
          <div class="why-time-card" {{ block.shopify_attributes }}>
            <div class="why-time-icon-wrapper">
              {% if block.settings.custom_icon_svg != blank %}
                {{ block.settings.custom_icon_svg }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}
                    <!-- Feather Icon -->
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L3 13.5V21h7.5z"></path>
                      <line x1="16" y1="8" x2="2" y2="22"></line>
                      <line x1="17.5" y1="15" x2="9" y2="15"></line>
                    </svg>
                  {% when 2 %}
                    <!-- Droplet with Shield Icon -->
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                      <path d="M12 9v4"></path>
                      <path d="M10 11.5l2 2 3.5-3.5"></path>
                    </svg>
                  {% when 3 %}
                    <!-- Moon & Stars Icon -->
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                      <path d="M19 4h.01M17 2h.01"></path>
                    </svg>
                  {% when 4 %}
                    <!-- Heart Icon -->
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="why-time-card-title">{{ block.settings.title }}</h3>
            <p class="why-time-card-desc">{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>

      <!-- CTA Button -->
      <div class="why-time-cta-wrapper">
        <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="why-time-cta-btn">
          {{ section.settings.cta_text | default: "Find Your TIME →" }}
        </a>
      </div>

      <!-- Bottom Brand Line -->
      <div class="why-time-footer-line">
        <div class="why-time-divider-line"></div>
        <div class="why-time-footer-text">
          <span>REAL CARE</span>
          <span class="why-time-pipe">|</span>
          <span>REAL COMFORT</span>
          <span class="why-time-pipe">|</span>
          <span>A BRIGHTER YOU</span>
        </div>
        <div class="why-time-divider-line"></div>
      </div>

    </div>
  </div>
</div>

