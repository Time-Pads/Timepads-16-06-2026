{%- comment -%}
  TIMEPADS - Ultra-Fast Auto-Rotating Image Hero Banner
  Target: Lighthouse 95+ Mobile | LCP < 2.0s | CLS = 0 | JS < 1 KB
{%- endcomment -%}

{%- liquid
  assign blocks = section.blocks

  if blocks.size > 0
    assign first_block = blocks.first
    assign desktop_aspect = first_block.settings.image.aspect_ratio | default: section.settings.desktop_image.aspect_ratio | default: 2.35
    assign mobile_target_first = first_block.settings.mobile_image | default: first_block.settings.image | default: section.settings.mobile_image | default: section.settings.desktop_image
    assign mobile_aspect = mobile_target_first.aspect_ratio | default: 1.2
  else
    assign desktop_aspect = section.settings.desktop_image.aspect_ratio | default: 2.35
    assign mobile_target_first = section.settings.mobile_image | default: section.settings.desktop_image
    assign mobile_aspect = mobile_target_first.aspect_ratio | default: 1.2
  endif

  assign pad_top = section.settings.padding_top | default: 0
  assign pad_bottom = section.settings.padding_bottom | default: 0
  assign desktop_radius = section.settings.desktop_border_radius | default: 0
  assign mobile_radius = section.settings.mobile_border_radius | default: 0
  assign interval = section.settings.autoplay_interval | default: 2000
-%}

{%- style -%}
  .tp-rotator-{{ section.id }} {
    --tp-hero-pt: {{ pad_top }}px;
    --tp-hero-pb: {{ pad_bottom }}px;
    --tp-hero-radius-desktop: {{ desktop_radius }}px;
    --tp-hero-radius-mobile: {{ mobile_radius }}px;
    --tp-hero-aspect-desktop: {{ desktop_aspect }};
    --tp-hero-aspect-mobile: {{ mobile_aspect }};
  }
{%- endstyle -%}

<section
  id="shopify-section-hero-{{ section.id }}"
  class="tp-rotator tp-rotator-{{ section.id }}"
  aria-label="Hero Banner Rotator"
  data-interval="{{ interval }}"
>
  <div class="tp-rotator__container">
    {%- if blocks.size > 0 -%}
      {%- for block in blocks -%}
        {%- liquid
          assign d_img = block.settings.image | default: section.settings.desktop_image
          assign m_img = block.settings.mobile_image | default: d_img
          assign b_link = block.settings.link | default: section.settings.banner_link
          assign is_first = forloop.first
        -%}

        <div
          class="tp-rotator__slide{% if is_first %} is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          aria-hidden="{% if is_first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if b_link != blank -%}
            <a href="{{ b_link }}" class="tp-rotator__link" aria-label="{{ d_img.alt | default: shop.name | escape }}">
          {%- endif -%}

          {%- if d_img != blank -%}
            <picture class="tp-rotator__picture">
              <!-- Mobile WebP -->
              <source
                media="(max-width: 767px)"
                type="image/webp"
                srcset="
                  {{ m_img | image_url: width: 480, format: 'webp' }} 480w,
                  {{ m_img | image_url: width: 640, format: 'webp' }} 640w,
                  {{ m_img | image_url: width: 750, format: 'webp' }} 750w,
                  {{ m_img | image_url: width: 960, format: 'webp' }} 960w
                "
                sizes="100vw"
              >
              <!-- Desktop WebP -->
              <source
                media="(min-width: 768px)"
                type="image/webp"
                srcset="
                  {{ d_img | image_url: width: 1100, format: 'webp' }} 1100w,
                  {{ d_img | image_url: width: 1440, format: 'webp' }} 1440w,
                  {{ d_img | image_url: width: 1920, format: 'webp' }} 1920w,
                  {{ d_img | image_url: width: 2560, format: 'webp' }} 2560w
                "
                sizes="100vw"
              >
              <!-- Fallback Img (Eager for First Only, Lazy for Remaining) -->
              <img
                src="{{ m_img | default: d_img | image_url: width: 750, format: 'webp' }}"
                alt="{{ d_img.alt | default: shop.name | escape }}"
                class="tp-rotator__img"
                width="{{ m_img.width | default: d_img.width | default: 750 }}"
                height="{{ m_img.height | default: d_img.height | default: 920 }}"
                loading="{% if is_first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if is_first %}high{% else %}low{% endif %}"
                decoding="{% if is_first %}sync{% else %}async{% endif %}"
              >
            </picture>
          {%- else -%}
            <div class="tp-rotator__placeholder"></div>
          {%- endif -%}

          {%- if b_link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Fallback Single Slide if No Blocks -->
      {%- assign d_img = section.settings.desktop_image -%}
      {%- assign m_img = section.settings.mobile_image | default: d_img -%}
      {%- assign b_link = section.settings.banner_link -%}

      <div class="tp-rotator__slide is-active" data-slide-index="0" aria-hidden="false">
        {%- if b_link != blank -%}
          <a href="{{ b_link }}" class="tp-rotator__link" aria-label="{{ d_img.alt | default: shop.name | escape }}">
        {%- endif -%}

        {%- if d_img != blank -%}
          <picture class="tp-rotator__picture">
            <source
              media="(max-width: 767px)"
              type="image/webp"
              srcset="
                {{ m_img | image_url: width: 480, format: 'webp' }} 480w,
                {{ m_img | image_url: width: 640, format: 'webp' }} 640w,
                {{ m_img | image_url: width: 750, format: 'webp' }} 750w
              "
              sizes="100vw"
            >
            <source
              media="(min-width: 768px)"
              type="image/webp"
              srcset="
                {{ d_img | image_url: width: 1100, format: 'webp' }} 1100w,
                {{ d_img | image_url: width: 1440, format: 'webp' }} 1440w,
                {{ d_img | image_url: width: 1920, format: 'webp' }} 1920w
              "
              sizes="100vw"
            >
            <img
              src="{{ d_img | image_url: width: 1440 }}"
              alt="{{ d_img.alt | default: shop.name | escape }}"
              class="tp-rotator__img"
              width="{{ d_img.width | default: 1440 }}"
              height="{{ d_img.height | default: 612 }}"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >
          </picture>
        {%- else -%}
          <div class="tp-rotator__placeholder"></div>
        {%- endif -%}

        {%- if b_link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .tp-rotator-{{ section.id }} {
    width: 100%;
    padding-top: var(--tp-hero-pt);
    padding-bottom: var(--tp-hero-pb);
    display: block;
  }
  .tp-rotator-{{ section.id }} .tp-rotator__container {
    position: relative;
    width: 100%;
    aspect-ratio: var(--tp-hero-aspect-mobile);
    overflow: hidden;
    border-radius: var(--tp-hero-radius-mobile);
  }
  .tp-rotator-{{ section.id }} .tp-rotator__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .tp-rotator-{{ section.id }} .tp-rotator__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .tp-rotator-{{ section.id }} .tp-rotator__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }
  .tp-rotator-{{ section.id }} .tp-rotator__picture,
  .tp-rotator-{{ section.id }} .tp-rotator__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tp-rotator-{{ section.id }} .tp-rotator__placeholder {
    width: 100%;
    height: 100%;
    background-color: #F8F0E7;
  }
  @media (min-width: 768px) {
    .tp-rotator-{{ section.id }} .tp-rotator__container {
      aspect-ratio: var(--tp-hero-aspect-desktop);
      border-radius: var(--tp-hero-radius-desktop);
    }
  }
</style>

<script>
  (function() {
    var el = document.getElementById('shopify-section-hero-{{ section.id }}');
    if (!el) return;
    var slides = el.querySelectorAll('.tp-rotator__slide');
    if (slides.length <= 1) return;
    var count = slides.length;
    var current = 0;
    var interval = parseInt(el.getAttribute('data-interval') || '2000', 10);

    setTimeout(function() {
      setInterval(function() {
        slides[current].classList.remove('is-active');
        slides[current].setAttribute('aria-hidden', 'true');
        current = (current + 1) % count;
        slides[current].classList.add('is-active');
        slides[current].setAttribute('aria-hidden', 'false');
      }, interval);
    }, 5000);
  })();
</script>

{% schema %}
{
  "name": "Auto-Rotating Banner",
  "tag": "section",
  "class": "tp-hero-rotator-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Fallback Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Fallback Mobile Image"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Fallback Banner Link"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 1000,
      "max": 5000,
      "step": 500,
      "unit": "ms",
      "label": "Rotation Speed (ms)",
      "default": 2000
    },
    {
      "type": "range",
      "id": "desktop_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Desktop Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Banner Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Banner Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Auto-Rotating Banner"
    }
  ]
}
{% endschema %}
