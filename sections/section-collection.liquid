{%- comment -%}
  TIMEPADS - Featured Product Grid Section
  Rendering Store Native Collection Product Cards (with Variants & Split Add to Cart Button)
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign heading = section.settings.title | default: section.settings.heading | default: collection.title
  assign limit = section.settings.maximum_products | default: section.settings.limit | default: 8
  
  assign cols_desktop = section.settings.products_per_row_desktop | default: section.settings.grid | default: 4
  assign cols_mobile = section.settings.products_per_row_mobile | default: section.settings.grid_mobile | default: 2
  
  assign enable_view_all = section.settings.enable_view_all | default: section.settings.show_view_all
  assign view_all_text = section.settings.button_text | default: 'View All Products'
  
  assign pad_top = section.settings.padding_top | default: 40
  assign pad_bottom = section.settings.padding_bottom | default: 40
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
-%}

{%- style -%}
  .tp-grid-{{ section.id }} {
    --tp-grid-bg: {{ bg_color }};
    --tp-grid-cols-desktop: {{ cols_desktop }};
    --tp-grid-cols-mobile: {{ cols_mobile }};
    --tp-grid-pt: {{ pad_top }}px;
    --tp-grid-pb: {{ pad_bottom }}px;
  }
{%- endstyle -%}

<section
  id="shopify-section-grid-{{ section.id }}"
  class="tp-grid-section tp-grid-{{ section.id }}"
  aria-label="{{ heading | default: 'Featured Products' | escape }}"
>
  <div class="tp-grid__container">
    
    {%- if heading != blank -%}
      <div class="tp-grid__header">
        <h2 class="tp-grid__heading">{{ heading }}</h2>
      </div>
    {%- endif -%}

    <div class="tp-grid__products">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {%- render 'collection-product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Onboarding Placeholder Cards -->
        {%- for i in (1..4) -%}
          <div class="tp-product-card-placeholder">Sample Product {{ i }}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if enable_view_all and collection.url != blank -%}
      <div class="tp-grid__footer">
        <a href="{{ collection.url }}" class="tp-grid__view-all-btn">
          <span>{{ view_all_text }}</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .tp-grid-{{ section.id }} {
    background-color: var(--tp-grid-bg);
    padding-top: var(--tp-grid-pt);
    padding-bottom: var(--tp-grid-pb);
    width: 100%;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .tp-grid-{{ section.id }} .tp-grid__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .tp-grid-{{ section.id }} .tp-grid__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 36px auto;
  }

  .tp-grid-{{ section.id }} .tp-grid__heading {
    font-size: 28px;
    font-weight: 700;
    color: #2D2D2D;
    margin: 0;
    line-height: 1.25;
  }
  @media (min-width: 768px) {
    .tp-grid-{{ section.id }} .tp-grid__heading {
      font-size: 34px;
    }
  }
  @media (min-width: 1024px) {
    .tp-grid-{{ section.id }} .tp-grid__heading {
      font-size: 40px;
    }
  }

  /* Grid Layout (2 cols mobile, 3 cols tablet, 4 cols desktop) */
  .tp-grid-{{ section.id }} .tp-grid__products {
    display: grid;
    grid-template-columns: repeat(var(--tp-grid-cols-mobile), 1fr);
    gap: 18px;
  }
  @media (min-width: 768px) {
    .tp-grid-{{ section.id }} .tp-grid__products {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  @media (min-width: 1024px) {
    .tp-grid-{{ section.id }} .tp-grid__products {
      grid-template-columns: repeat(var(--tp-grid-cols-desktop), 1fr);
      gap: 28px;
    }
  }

  /* View All Button Footer */
  .tp-grid-{{ section.id }} .tp-grid__footer {
    text-align: center;
    margin-top: 36px;
  }

  .tp-grid-{{ section.id }} .tp-grid__view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    border-radius: 12px;
    border: 1.5px solid #46543E;
    color: #46543E;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  @media (min-width: 768px) {
    .tp-grid-{{ section.id }} .tp-grid__view-all-btn {
      font-size: 16px;
    }
  }
  .tp-grid-{{ section.id }} .tp-grid__view-all-btn:hover {
    background-color: #46543E;
    color: #FFFFFF;
  }
</style>

{% schema %}
{
  "name": "Featured Product Grid",
  "tag": "section",
  "class": "tp-featured-product-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Products Per Row Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_row_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Products Per Row Mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "maximum_products",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Maximum Products",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_view_all",
      "label": "Enable View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "View All Button Text",
      "default": "View All Products"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Featured Product Grid"
    }
  ]
}
{% endschema %}
