{%- if section.settings.enable_announcement -%}
  {%- style -%}
    .announcement-bar-{{ section.id }} {
      --ann-bg: {{ section.settings.bg_color | default: '#46543E' }};
      --ann-text: {{ section.settings.text_color | default: '#FFFFFF' }};
      --ann-hover: {{ section.settings.link_hover_color | default: '#C8D8C0' }};
      --ann-desktop-size: {{ section.settings.desktop_font_size | default: 14 }}px;
      --ann-mobile-size: {{ section.settings.mobile_font_size | default: 13 }}px;
      --ann-pt: {{ section.settings.padding_top | default: 0 }}px;
      --ann-pb: {{ section.settings.padding_bottom | default: 0 }}px;
    }
  {%- endstyle -%}

  <aside
    id="shopify-section-announcement-bar-{{ section.id }}"
    class="announcement-bar-{{ section.id }} announcement-bar-root"
    role="banner"
    aria-label="Announcement Bar"
  >
    <div class="announcement-bar__container">
      <div class="announcement-bar__content">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign message_text = block.settings.text | default: block.settings.message | default: section.settings.announcement_text -%}
            {%- if message_text != blank -%}
              <span class="announcement-bar__text" {{ block.shopify_attributes }}>{{ message_text }}</span>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- if section.settings.announcement_text != blank -%}
            <span class="announcement-bar__text">{{ section.settings.announcement_text }}</span>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.enable_link and section.settings.announcement_link != blank -%}
          <a
            href="{{ section.settings.announcement_link }}"
            class="announcement-bar__link"
            aria-label="{{ section.settings.link_text | default: 'Shop Now' | escape }}"
          >
            <span>{{ section.settings.link_text | default: 'Shop Now →' }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </aside>

  <style>
    .announcement-bar-{{ section.id }} {
      background-color: #b7a487 !important;
      color: var(--ann-text);
      padding-top: var(--ann-pt);
      padding-bottom: var(--ann-pb);
      width: 100%;
      min-height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 50;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-weight: 500;
      line-height: 1.4;
      letter-spacing: 0.2px;
      text-align: center;
    }

    .announcement-bar-{{ section.id }} .announcement-bar__container {
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .announcement-bar-{{ section.id }} .announcement-bar__content {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: var(--ann-desktop-size);
      color: var(--ann-text);
      white-space: nowrap;
    }

    .announcement-bar-{{ section.id }} .announcement-bar__text {
      color: inherit;
    }

    .announcement-bar-{{ section.id }} .announcement-bar__text p {
      margin: 0;
      display: inline;
    }

    .announcement-bar-{{ section.id }} .announcement-bar__link {
      color: inherit;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease, text-decoration 0.2s ease;
    }

    .announcement-bar-{{ section.id }} .announcement-bar__link:hover,
    .announcement-bar-{{ section.id }} .announcement-bar__link:focus-visible {
      color: var(--ann-hover);
      text-decoration: underline;
      outline: none;
    }

    @media (max-width: 767px) {
      .announcement-bar-{{ section.id }} {
        min-height: 36px;
      }
      .announcement-bar-{{ section.id }} .announcement-bar__content {
        font-size: var(--ann-mobile-size);
        gap: 6px;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "🚚 Free Shipping on Orders Above ₹699"
    },
    {
      "type": "checkbox",
      "id": "enable_link",
      "label": "Enable Link",
      "default": true
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Shop Now →"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#46543E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link Hover Color",
      "default": "#C8D8C0"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "message",
          "label": "Message",
          "default": "🚚 Free Shipping on Orders Above ₹699"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "🌸 Flat 10% OFF on Your First Order | Use Code TIME10"
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "icon_block",
      "name": "Icon Block",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
