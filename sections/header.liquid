<!-- /sections/header.liquid -->

{%- liquid
  if section.settings.main_menu_linklist
    assign main_menu_linklist = section.settings.main_menu_linklist
  else
    assign main_menu_linklist = 'main-menu'
  endif
-%}

{% style %}
/* Google Fonts - Caveat / Playfair / Plus Jakarta loaded async via theme.liquid (single request, non-render-blocking) */
/* ─── TIME MASTER MULTI-ROW HEADER SYSTEM (IMAGE 1 TARGET MATCH) ─── */
#shopify-section-header,
.shopify-section-group-header-group,
header.theme__header,
.tp-header-master-wrapper {
  width: 100% !important;
  max-width: 100% !important;
  position: relative;
  z-index: 100;
  font-family: 'Poppins', var(--FONT-STACK-BODY), sans-serif;
  background-color: var(--time-background) !important;
  box-shadow: 0 4px 20px rgba(123, 63, 109, 0.08);
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important;
}

/* ── ROW 1: TOP ANNOUNCEMENT BAR ── */
.tp-header-announcement-bar {
  width: 100% !important;
  max-width: 100% !important;
  background-color: var(--time-text) !important; /* Deep dark plum #241D25 */
  color: var(--time-white) !important;
  font-size: 12px;
  font-weight: 500;
  padding: 8px 32px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box !important;
}

.tp-announcement-container {
  width: 100% !important;
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-sizing: border-box !important;
}

.tp-announcement-item {
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.tp-announcement-center {
  font-weight: 600;
  color: var(--time-primary-light);
}

.tp-announcement-heart {
  color: var(--time-primary-light);
  font-size: 13px;
}

/* ── ROW 2: MAIN HEADER (LOGO, SEARCH, USER ACTIONS) ── */
.tp-main-header-bar {
  width: 100% !important;
  max-width: 100% !important;
  background-color: var(--time-background) !important;
  padding: 14px 32px;
  border-bottom: 1px solid var(--time-border);
  box-sizing: border-box !important;
}

.tp-main-header-container {
  width: 100% !important;
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  box-sizing: border-box !important;
}

/* Logo Column */
.tp-header-logo-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.tp-header-logo-link {
  text-decoration: none !important;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
}

.tp-header-logo-serif {
  font-family: 'Playfair Display', Didot, serif;
  font-size: 34px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--time-text);
  line-height: 1;
}

.tp-trademark {
  font-size: 12px;
  font-weight: 600;
  margin-left: 2px;
  top: -4px;
  position: relative;
}

.tp-header-logo-sub {
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: 0.42em;
  color: var(--time-primary);
  margin-top: 3px;
  text-transform: uppercase;
}

/* Search Column */
.tp-header-search-wrap {
  flex: 1;
  max-width: 560px;
  margin: 0 16px;
}

.tp-header-search-form {
  width: 100%;
  margin: 0;
}

.tp-search-pill-box {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  background: var(--time-surface) !important; /* White */
  border: 1.5px solid var(--time-border) !important;
  border-radius: 999px !important;
  padding: 3px 3px 3px 12px !important;
  height: 38px !important;
  box-sizing: border-box !important;
  transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
}

.tp-search-pill-box:focus-within {
  border-color: var(--time-primary) !important;
  box-shadow: 0 0 0 3px rgba(123, 63, 109, 0.12) !important;
}

.tp-search-icon-left {
  width: 16px !important;
  height: 16px !important;
  stroke: var(--time-text-secondary) !important;
  flex-shrink: 0 !important;
  margin-right: 6px !important;
  display: block !important;
  align-self: center !important;
}

.tp-search-input-field {
  flex: 1 !important;
  border: none !important;
  outline: none !important;
  box-shadow: none !important;
  background: transparent !important;
  color: var(--time-text) !important;
  font-size: 12.5px !important;
  font-family: inherit !important;
  padding: 0 4px !important;
  margin: 0 !important;
  height: 100% !important;
  line-height: 32px !important;
  display: flex !important;
  align-items: center !important;
  align-self: center !important;
  -webkit-appearance: none !important;
  appearance: none !important;
}

.tp-search-input-field::placeholder {
  color: var(--time-text-secondary) !important;
  opacity: 0.75 !important;
  line-height: normal !important;
}

.tp-search-btn-submit {
  background: var(--time-primary-dark) !important; /* Plum button */
  color: var(--time-white) !important;
  border: none !important;
  border-radius: 999px !important;
  padding: 0 18px !important;
  height: 32px !important;
  line-height: 32px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
  white-space: nowrap !important;
  align-self: center !important;
  margin: 0 !important;
}

.tp-search-btn-submit:hover {
  background: var(--time-primary) !important;
  transform: scale(1.02) !important;
}

/* User Actions Column (Account, Wishlist, Cart) */
.tp-header-actions-wrap {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-shrink: 0;
}

.tp-user-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none !important;
  color: var(--time-text) !important;
  transition: transform 0.2s ease;
  position: relative;
}

.tp-user-action-item:hover {
  transform: translateY(-2px);
}

.tp-action-icon-box {
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 2px;
}

.tp-action-icon-box svg {
  width: 22px;
  height: 22px;
  stroke: var(--time-text);
  fill: none;
}

.tp-action-text-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--time-text);
  line-height: 1.1;
}

/* Cart Badge Count */
.tp-cart-count-badge {
  position: absolute;
  top: -6px;
  right: -8px;
  background: var(--time-primary-dark) !important;
  color: var(--time-white) !important;
  font-size: 10px;
  font-weight: 800;
  min-width: 18px;
  height: 18px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
  border: 1.5px solid var(--time-background);
}

/* ── ROW 3: NAVIGATION / CATEGORY BAR ── */
.tp-category-nav-bar {
  width: 100% !important;
  max-width: 100% !important;
  background-color: var(--time-background) !important;
  padding: 10px 32px;
  border-bottom: 1px solid var(--time-border);
  box-sizing: border-box !important;
}

.tp-category-nav-container {
  width: 100% !important;
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  flex-wrap: wrap;
  box-sizing: border-box !important;
}

.tp-cat-nav-list {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.tp-cat-item-link {
  color: var(--time-text) !important;
  font-size: 13.5px !important;
  font-weight: 600 !important;
  text-decoration: none !important;
  transition: color 0.2s ease !important;
  white-space: nowrap;
}

.tp-cat-item-link:hover {
  color: var(--time-primary) !important;
}

/* New Arrivals Pill Badge */
.tp-new-arrivals-pill-btn {
  background: rgba(123, 63, 109, 0.08) !important;
  border: 1.2px solid var(--time-primary-light) !important;
  border-radius: 999px !important;
  padding: 4px 14px 4px 6px !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  text-decoration: none !important;
  transition: all 0.2s ease !important;
}

.tp-new-arrivals-pill-btn:hover {
  background: rgba(123, 63, 109, 0.15) !important;
  transform: scale(1.02);
}

.tp-red-new-tag {
  background: #FF3B30 !important;
  color: #FFFFFF !important;
  font-size: 9px !important;
  font-weight: 800 !important;
  padding: 2px 7px !important;
  border-radius: 999px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
}

.tp-new-title-text {
  color: var(--time-text) !important;
  font-size: 13px !important;
  font-weight: 700 !important;
}

/* Right Secondary Links (Period Tips, Blogs) */
.tp-cat-nav-divider {
  width: 1px;
  height: 18px;
  background: var(--time-border);
}

.tp-secondary-nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
}

.tp-sec-nav-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--time-text) !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  text-decoration: none !important;
  transition: color 0.2s ease !important;
}

.tp-sec-nav-item:hover {
  color: var(--time-primary) !important;
}

.tp-sec-nav-item svg {
  width: 16px;
  height: 16px;
  stroke: var(--time-primary);
  fill: none;
}

/* Mobile Adjustments */
.tp-mobile-header-bar {
  display: none;
}

@media (max-width: 1024px) {
  #shopify-section-header,
  .shopify-section-group-header-group,
  .shopify-section-group-header,
  header.theme__header,
  .tp-header-master-wrapper {
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    left: 0 !important;
    right: 0 !important;
    box-sizing: border-box !important;
  }
  .tp-header-announcement-bar {
    width: 100% !important;
    max-width: 100% !important;
    padding: 5px 12px !important;
    font-size: 11px !important;
    box-sizing: border-box !important;
  }
  .tp-announcement-left, .tp-announcement-right {
    display: none !important;
  }
  .tp-announcement-container {
    width: 100% !important;
    justify-content: center !important;
    padding: 0 8px !important;
    box-sizing: border-box !important;
  }
  .tp-main-header-bar, .tp-category-nav-bar {
    display: none !important;
  }
  .tp-mobile-header-bar {
    display: block !important;
    width: 100% !important;
    background: var(--time-background) !important;
    padding: 6px 12px !important;
    border-bottom: 1px solid var(--time-border) !important;
    box-sizing: border-box !important;
  }
  .tp-mobile-header-inner {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  .tp-mobile-header-inner img {
    max-height: 54px !important;
    height: 54px !important;
    width: auto !important;
  }
  .tp-mobile-header-inner .tp-header-logo-serif {
    font-size: 42px !important;
  }
  .tp-mobile-header-inner svg {
    width: 20px !important;
    height: 20px !important;
  }
  .tp-mobile-search-row {
    margin-top: 4px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  .tp-mobile-search-row .tp-search-pill-box {
    padding: 2px 2px 2px 12px !important;
  }
  .tp-mobile-search-row .tp-search-input-field {
    font-size: 12px !important;
    padding: 4px 0 !important;
  }
  .tp-mobile-search-row .tp-search-btn-submit {
    padding: 4px 14px !important;
    font-size: 11.5px !important;
  }
}
{% endstyle %}

<div class="tp-header-master-wrapper" data-header-wrapper data-section-id="{{ section.id }}" data-section-type="header">
  <header class="theme__header">

    <!-- ── ROW 1: TOP ANNOUNCEMENT BAR ── -->
    <div class="tp-header-announcement-bar">
      <div class="tp-announcement-container">
        <div class="tp-announcement-item tp-announcement-left">
          <span>🚚</span>
          <span>Free Shipping on Orders above ₹499</span>
        </div>
        <div class="tp-announcement-item tp-announcement-center">
          <span class="tp-announcement-heart">♡</span>
          <span>Thoughtful Period Care for a Kinder You</span>
          <span class="tp-announcement-heart">♡</span>
        </div>
        <div class="tp-announcement-item tp-announcement-right">
          <span>🏷</span>
          <span>Use Code <strong>TIME10</strong> for 10% Off</span>
        </div>
      </div>
    </div>

    <!-- ── ROW 2: MAIN HEADER (DESKTOP) ── -->
    <div class="tp-main-header-bar">
      <div class="tp-main-header-container">
        <!-- Logo Column -->
        <div class="tp-header-logo-wrap">
          <a href="{{ routes.root_url }}" class="tp-header-logo-link">
            {% if section.settings.logo != blank %}
              <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="320" height="{{ 320 | divided_by: section.settings.logo.aspect_ratio | round }}" style="max-height: 64px; width: auto;" loading="eager" fetchpriority="high" decoding="async">
            {% else %}
              <div class="tp-header-logo-serif" style="font-size: 42px;">TIME<span class="tp-trademark">™</span></div>
              <div class="tp-header-logo-sub">SANITARY PADS</div>
            {% endif %}
          </a>
        </div>

        <!-- Search Column -->
        <div class="tp-header-search-wrap">
          <form action="{{ routes.search_url }}" method="get" role="search" class="tp-header-search-form">
            <div class="tp-search-pill-box" data-popdown-toggle="search-popdown" style="cursor: pointer;">
              <svg class="tp-search-icon-left" viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"></line>
              </svg>
              <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for pads, menstrual cups, pain relief cream..." class="tp-search-input-field" aria-label="Search" data-popdown-toggle="search-popdown">
              <button type="button" class="tp-search-btn-submit" data-popdown-toggle="search-popdown">Search</button>
            </div>
          </form>
        </div>

        <!-- User Actions Column -->
        <div class="tp-header-actions-wrap">
          <!-- Account -->
          <a href="{{ routes.account_url }}" class="tp-user-action-item" aria-label="Account">
            <div class="tp-action-icon-box">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <span class="tp-action-text-label">Account</span>
          </a>

          <!-- Wishlist -->
          <a href="/pages/wishlist" class="tp-user-action-item" aria-label="Wishlist">
            <div class="tp-action-icon-box">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>
            <span class="tp-action-text-label">Wishlist</span>
          </a>

          <!-- Cart -->
          <a href="{{ routes.cart_url }}" class="tp-user-action-item" data-drawer-toggle="drawer-cart" aria-label="Cart" aria-expanded="false" aria-controls="drawer-cart">
            <div class="tp-action-icon-box">
              <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span class="tp-cart-count-badge" data-header-cart-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
            </div>
            <span class="tp-action-text-label">Cart</span>
          </a>
        </div>
      </div>
    </div>

    <!-- ── ROW 3: NAVIGATION / CATEGORY BAR (DESKTOP) ── -->
    <div class="tp-category-nav-bar">
      <div class="tp-category-nav-container">
        <ul class="tp-cat-nav-list">
          {% assign menu_links = linklists[main_menu_linklist].links %}
          {% if menu_links and menu_links.size > 0 %}
            {% for link in menu_links %}
              {% assign title_dc = link.title | downcase %}
              {% if title_dc contains 'new arrival' %}
                <li>
                  <a href="{{ link.url }}" class="tp-new-arrivals-pill-btn">
                    <span class="tp-red-new-tag">NEW</span>
                    <span class="tp-new-title-text">{{ link.title }}</span>
                  </a>
                </li>
              {% else %}
                <li><a href="{{ link.url }}" class="tp-cat-item-link">{{ link.title }}</a></li>
              {% endif %}
            {% endfor %}
          {% else %}
            <li><a href="/collections/all" class="tp-cat-item-link">Period Pain Relief Cream</a></li>
            <li><a href="/collections/all" class="tp-cat-item-link">Menstrual Cup</a></li>
            <li><a href="/collections/all" class="tp-cat-item-link">Best Sellers</a></li>
            <li>
              <a href="/collections/all" class="tp-new-arrivals-pill-btn">
                <span class="tp-red-new-tag">NEW</span>
                <span class="tp-new-title-text">New Arrivals</span>
              </a>
            </li>
            <li><a href="/collections/all" class="tp-cat-item-link">Shop All</a></li>
          {% endif %}
        </ul>

        <div class="tp-cat-nav-divider"></div>

        <div class="tp-secondary-nav-links">
          <a href="/pages/period-tips" class="tp-sec-nav-item">
            <!-- Leaf SVG -->
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.4 19 2c1 2 2 4.1 2 9a9 9 0 0 1-10 9Z"></path>
              <path d="M11 20v-8"></path>
            </svg>
            <span>Period Tips</span>
          </a>

          <div class="tp-cat-nav-divider"></div>

          <a href="/blogs/news" class="tp-sec-nav-item">
            <!-- Book SVG -->
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>Blogs</span>
          </a>
        </div>
      </div>
    </div>

    <!-- ── MOBILE HEADER BAR ── -->
    <div class="tp-mobile-header-bar">
      <div class="tp-mobile-header-inner">
        <!-- Hamburger -->
        <button type="button" class="header__mobile__button" data-drawer-toggle="hamburger" aria-label="Open Menu" aria-expanded="false" aria-controls="header-menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--time-text)" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <!-- Logo -->
        <a href="{{ routes.root_url }}" class="tp-header-logo-link">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 280 }}" alt="{{ shop.name }}" width="280" height="{{ 280 | divided_by: section.settings.logo.aspect_ratio | round }}" style="max-height: 54px; height: 54px; width: auto;" loading="eager" fetchpriority="high" decoding="async">
          {% else %}
            <div class="tp-header-logo-serif" style="font-size: 42px;">TIME<span class="tp-trademark">™</span></div>
          {% endif %}
        </a>

        <!-- Actions -->
        <div style="display: flex; align-items: center; gap: 12px;">
          <a href="{{ routes.account_url }}" aria-label="Account" style="color: var(--time-text);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>

          <a href="/pages/wishlist" aria-label="Wishlist" style="color: var(--time-text);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </a>

          <a href="{{ routes.cart_url }}" data-drawer-toggle="drawer-cart" aria-label="Cart" aria-expanded="false" aria-controls="drawer-cart" style="color: var(--time-text); position: relative;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
