<!-- /sections/header.liquid -->

{%- liquid
  if section.settings.main_menu_linklist
    assign main_menu_linklist = section.settings.main_menu_linklist
  else
    assign main_menu_linklist = 'main-menu'
  endif
-%}

{% style %}
  /* Google Fonts - Caveat / Playfair / Plus Jakarta loaded async via theme.liquid (single request, non-render-blocking) */
  /* ─── TIME MASTER MULTI-ROW HEADER SYSTEM (IMAGE 1 TARGET MATCH) ─── */
  #shopify-section-header,
  .shopify-section-group-header-group,
  header.theme__header,
  .tp-header-master-wrapper {
    width: 100% !important;
    max-width: 100% !important;
    position: relative;
    z-index: 100;
    font-family: 'Poppins', var(--FONT-STACK-BODY), sans-serif;
    background-color: #FAF8F5 !important;
    box-shadow: 0 4px 20px rgba(123, 63, 109, 0.08);
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  /* ── ROW 1: TOP ANNOUNCEMENT BAR (AUTO-SCROLLING MARQUEE) ── */
  .tp-header-announcement-bar {
    width: 100% !important;
    max-width: 100% !important;
    background-color: #2B2117 !important; /* Rich espresso dark brown */
    color: #F5EFE6 !important;
    font-size: 12.5px !important;
    font-weight: 600 !important;
    padding: 8px 0 !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-sizing: border-box !important;
    line-height: 1.3 !important;
    overflow: hidden !important;
    position: relative !important;
    cursor: default !important;
  }

  .tp-announcement-marquee {
    width: 100% !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
  }

  .tp-announcement-track {
    display: flex !important;
    flex-wrap: nowrap !important;
    width: max-content !important;
    align-items: center !important;
    will-change: transform !important;
    animation: tpAnnouncementMarquee 32s linear infinite !important;
  }

  .tp-header-announcement-bar:hover .tp-announcement-track {
    animation-play-state: paused !important;
  }

  .tp-announcement-group {
    display: flex !important;
    align-items: center !important;
    flex-shrink: 0 !important;
    gap: clamp(24px, 3.5vw, 44px) !important;
    padding-right: clamp(24px, 3.5vw, 44px) !important;
  }

  .tp-announcement-item {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    white-space: nowrap !important;
    font-size: 12.5px !important;
    font-weight: 600 !important;
    color: #F5EFE6 !important;
    letter-spacing: 0.2px !important;
  }

  .tp-announcement-item strong {
    font-weight: 700 !important;
    color: #F5EFE6 !important;
  }

  .tp-announcement-icon {
    display: inline-block !important;
    vertical-align: middle !important;
    stroke: #F5EFE6 !important;
    flex-shrink: 0 !important;
  }

  .tp-announcement-divider {
    color: rgba(245, 239, 230, 0.45) !important;
    font-size: 13px !important;
    font-weight: 300 !important;
    user-select: none !important;
  }

  @keyframes tpAnnouncementMarquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-announcement-track {
      animation: none !important;
    }
  }

  /* ── ROW 2: MAIN HEADER (ONE HORIZONTAL LINE: LOGO + NAV ON LEFT, SEARCH + ACTIONS ON RIGHT) ── */
  .tp-main-header-bar {
    width: 100% !important;
    max-width: 100% !important;
    background-color: #FAF8F5 !important;
    padding: 10px clamp(16px, 2.5vw, 40px) !important;
    border-bottom: 1px solid #ece4dc !important;
    box-sizing: border-box !important;
  }

  .tp-main-header-container {
    width: 100% !important;
    max-width: 1560px !important;
    margin: 0 auto !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    flex-wrap: nowrap !important;
    gap: clamp(14px, 1.8vw, 28px) !important;
    box-sizing: border-box !important;
  }

  /* Left Group: Logo + Category Navigation */
  .tp-header-left-group {
    display: flex !important;
    align-items: center !important;
    gap: clamp(18px, 2.4vw, 36px) !important;
    flex-shrink: 0 !important;
  }

  .tp-header-logo-wrap {
    display: flex !important;
    align-items: center !important;
    flex-shrink: 0 !important;
  }

  .tp-header-logo-link {
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  .tp-header-logo-link img {
    max-height: 44px !important;
    height: 44px !important;
    width: auto !important;
    display: block !important;
    object-fit: contain !important;
  }

  .tp-header-logo-serif {
    font-family: 'Playfair Display', Didot, serif;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #2d2319;
    line-height: 1;
  }

  .tp-trademark {
    font-size: 11px;
    font-weight: 600;
    margin-left: 2px;
    top: -4px;
    position: relative;
  }

  .tp-header-logo-sub {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.38em;
    color: #987959;
    margin-top: 3px;
    text-transform: uppercase;
  }

  /* Category Navigation (Next to Logo) */
  .tp-header-nav-wrap {
    display: flex !important;
    align-items: center !important;
    white-space: nowrap !important;
  }

  .tp-cat-nav-list {
    display: flex !important;
    align-items: center !important;
    gap: clamp(12px, 1.6vw, 24px) !important;
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    flex-wrap: nowrap !important;
  }

  .tp-cat-nav-list li {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  .tp-cat-item-link {
    color: #2d2319 !important;
    font-size: clamp(12.5px, 0.92vw, 13.5px) !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
    white-space: nowrap !important;
    display: inline-block !important;
    letter-spacing: -0.1px !important;
  }

  .tp-cat-item-link:hover {
    color: #6E5233 !important;
  }

  /* Right Group: Search Pill + Divider + User Actions */
  .tp-header-right-wrap {
    display: flex !important;
    align-items: center !important;
    gap: clamp(10px, 1.2vw, 18px) !important;
    flex-shrink: 0 !important;
  }

  /* Search Column */
  .tp-header-search-wrap {
    width: clamp(230px, 20vw, 320px) !important;
    flex-shrink: 0 !important;
  }

  .tp-header-search-form {
    width: 100% !important;
    margin: 0 !important;
  }

  .tp-search-pill-box {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    background: #ffffff !important;
    border: 1.5px solid #ddd4ca !important;
    border-radius: 999px !important;
    padding: 3px 3px 3px 14px !important;
    height: 38px !important;
    box-sizing: border-box !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  }

  .tp-search-pill-box:focus-within {
    border-color: #6E5233 !important;
    box-shadow: 0 0 0 3px rgba(152, 121, 89, 0.15) !important;
  }

  .tp-search-icon-left {
    width: 16px !important;
    height: 16px !important;
    stroke: #5c5247 !important;
    flex-shrink: 0 !important;
    margin-right: 8px !important;
    display: block !important;
  }

  .tp-search-input-field {
    flex: 1 !important;
    min-width: 60px !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    color: #2d2319 !important;
    font-size: 12px !important;
    font-family: inherit !important;
    padding: 0 4px !important;
    margin: 0 !important;
    height: 100% !important;
    -webkit-appearance: none !important;
    appearance: none !important;
  }

  .tp-search-input-field::placeholder {
    color: #8c8074 !important;
    font-size: 11.5px !important;
  }

  .tp-search-btn-submit {
    background: #6E5233 !important; /* Brushed Bronze */
    color: #ffffff !important;
    border: none !important;
    border-radius: 999px !important;
    padding: 0 16px !important;
    height: 32px !important;
    line-height: 32px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: opacity 0.2s ease, transform 0.15s ease !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }

  .tp-search-btn-submit:hover {
    opacity: 0.92 !important;
    transform: scale(1.02) !important;
  }

  /* Vertical Divider between Search and User Actions */
  .tp-header-vdivider {
    width: 1px !important;
    height: 26px !important;
    background-color: #e2d7cc !important;
    margin: 0 4px !important;
    flex-shrink: 0 !important;
  }

  /* User Actions Column (Account, Wishlist, Cart) */
  .tp-header-actions-wrap {
    display: flex !important;
    align-items: center !important;
    gap: clamp(14px, 1.4vw, 22px) !important;
    flex-shrink: 0 !important;
  }

  .tp-user-action-item {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    color: #2d2319 !important;
    transition: transform 0.2s ease !important;
    position: relative !important;
    flex-shrink: 0 !important;
  }

  .tp-user-action-item:hover {
    transform: translateY(-2px) !important;
  }

  .tp-action-icon-box {
    width: 24px !important;
    height: 24px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    margin-bottom: 2px !important;
  }

  .tp-action-icon-box svg {
    width: 20px !important;
    height: 20px !important;
    stroke: #2d2319 !important;
    fill: none !important;
  }

  .tp-action-text-label {
    font-size: 11px !important;
    font-weight: 700 !important;
    color: #2d2319 !important;
    line-height: 1.1 !important;
  }

  .tp-cart-count-badge {
    position: absolute !important;
    top: -5px !important;
    right: -7px !important;
    background: #6E5233 !important;
    color: #ffffff !important;
    font-size: 9.5px !important;
    font-weight: 800 !important;
    min-width: 17px !important;
    height: 17px !important;
    border-radius: 999px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 3px !important;
    border: 1.5px solid #ffffff !important;
  }
  /* Responsive reduction for compact desktops */
  @media (min-width: 1025px) and (max-width: 1320px) {
    .tp-main-header-bar {
      padding: 8px 14px !important;
    }
    .tp-main-header-container {
      gap: 10px !important;
    }
    .tp-header-search-wrap {
      min-width: 120px !important;
      max-width: 200px !important;
    }
    .tp-search-pill-box {
      height: 36px !important;
      padding: 2px 2px 2px 8px !important;
    }
    .tp-search-btn-submit {
      padding: 0 10px !important;
      height: 28px !important;
      line-height: 28px !important;
      font-size: 11px !important;
    }
    .tp-header-nav-wrap {
      gap: 8px !important;
      margin: 0 8px !important;
    }
    .tp-cat-nav-list {
      gap: 8px !important;
    }
    .tp-cat-item-link,
    .tp-sec-nav-item {
      font-size: 11px !important;
    }
    .tp-header-actions-wrap {
      gap: 10px !important;
    }
    .tp-header-right-wrap {
      gap: 10px !important;
    }
  }

  /* Mobile adjustments */
  .tp-mobile-header-bar {
    display: none;
  }

  @media (max-width: 1024px) {
    #shopify-section-header,
    .shopify-section-group-header-group,
    .shopify-section-group-header,
    header.theme__header,
    .tp-header-master-wrapper {
      width: 100vw !important;
      max-width: 100vw !important;
      margin-left: calc(-50vw + 50%) !important;
      margin-right: calc(-50vw + 50%) !important;
      left: 0 !important;
      right: 0 !important;
      box-sizing: border-box !important;
    }
    .tp-header-announcement-bar {
      width: 100% !important;
      max-width: 100% !important;
      padding: 6.5px 0 !important;
      font-size: 11.5px !important;
      box-sizing: border-box !important;
      overflow: hidden !important;
    }
    .tp-main-header-bar,
    .tp-category-nav-bar {
      display: none !important;
    }
    .tp-mobile-header-bar {
      display: block !important;
      width: 100% !important;
      background: #FAF8F5 !important;
      padding: 6px 12px !important;
      border-bottom: 1px solid var(--time-border) !important;
      box-sizing: border-box !important;
    }
    .tp-mobile-header-inner {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 8px !important;
      width: 100% !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    }
    .tp-mobile-header-inner img {
      max-height: 54px !important;
      height: 54px !important;
      width: auto !important;
    }
    .tp-mobile-header-inner .tp-header-logo-serif {
      font-size: 42px !important;
    }
    .tp-mobile-header-inner svg {
      width: 20px !important;
      height: 20px !important;
    }
    .tp-mobile-search-row {
      margin-top: 4px !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .tp-mobile-search-row .tp-search-pill-box {
      padding: 2px 2px 2px 12px !important;
    }
    .tp-mobile-search-row .tp-search-input-field {
      font-size: 12px !important;
      padding: 4px 0 !important;
    }
    .tp-mobile-search-row .tp-search-btn-submit {
      padding: 4px 14px !important;
      font-size: 11.5px !important;
    }
  }
{% endstyle %}

