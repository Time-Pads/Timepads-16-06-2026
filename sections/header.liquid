    <!-- ── SINGLE ROW MAIN HEADER (DESKTOP) ── -->
    <div class="tp-main-header-bar">
      <div class="tp-main-header-container">
        <!-- Left Group: Logo + Category Navigation -->
        <div class="tp-header-left-group">
          <!-- 1. Logo Column -->
          <div class="tp-header-logo-wrap">
            <a href="{{ routes.root_url }}" class="tp-header-logo-link">
              {% if section.settings.logo != blank %}
                <img
                  src="{{ section.settings.logo | image_url: width: 320 }}"
                  alt="{{ shop.name }}"
                  width="320"
                  height="{{ 320 | divided_by: section.settings.logo.aspect_ratio | round }}"
                  style="max-height: 44px; width: auto;"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                >
              {% else %}
                <div class="tp-header-logo-serif" style="font-size: 32px;">TIME<span class="tp-trademark">™</span></div>
                <div class="tp-header-logo-sub">SANITARY PADS</div>
              {% endif %}
            </a>
          </div>

          <!-- 2. Navigation Links Directly Next to Logo -->
          <nav class="tp-header-nav-wrap" aria-label="Main Navigation">
            <ul class="tp-cat-nav-list">
              {% assign menu_links = linklists[main_menu_linklist].links %}
              {% if menu_links and menu_links.size > 0 %}
                {% for link in menu_links %}
                  {% assign title_dc = link.title | downcase %}
                  {% unless title_dc contains 'blog'
                    or title_dc contains 'period tip'
                    or title_dc contains 'new arrival'
                  %}
                    {% assign link_title = link.title %}
                    {% if link_title == 'Sanitary pads' %}
                      {% assign link_title = 'Sanitary Pads' %}
                    {% endif %}
                    <li>
                      <a href="{{ link.url }}" class="tp-cat-item-link">{{ link_title }}</a>
                    </li>
                  {% endunless %}
                {% endfor %}
              {% else %}
                <li><a href="/collections/all" class="tp-cat-item-link">Period Pain Relief Cream</a></li>
                <li><a href="/collections/all" class="tp-cat-item-link">Menstrual Cup</a></li>
                <li><a href="/collections/all" class="tp-cat-item-link">Sanitary Pads</a></li>
                <li><a href="/collections/all" class="tp-cat-item-link">Best Sellers</a></li>
                <li><a href="/collections/all" class="tp-cat-item-link">Shop All</a></li>
              {% endif %}
            </ul>
          </nav>
        </div>

        <!-- 3. Right Group (Search + Divider + Actions: Account, Wishlist, Cart) -->
        <div class="tp-header-right-wrap">
          <!-- Search Column -->
          <div class="tp-header-search-wrap">
            <form action="{{ routes.search_url }}" method="get" role="search" class="tp-header-search-form">
              <div class="tp-search-pill-box" data-popdown-toggle="search-popdown" style="cursor: pointer;">
                <svg class="tp-search-icon-left" viewBox="0 0 24 24" fill="none">
                  <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"></line>
                </svg>
                <input
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="Search for pads, menstrual cups, pain relief cream..."
                  class="tp-search-input-field"
                  aria-label="Search"
                  data-popdown-toggle="search-popdown"
                >
                <button type="button" class="tp-search-btn-submit" data-popdown-toggle="search-popdown">Search</button>
              </div>
            </form>
          </div>

          <!-- Vertical Divider -->
          <div class="tp-header-vdivider" aria-hidden="true"></div>

          <!-- User Actions Column (Account, Wishlist, Cart) -->
          <div class="tp-header-actions-wrap">
            <!-- Account -->
            <a href="{{ routes.account_url }}" class="tp-user-action-item" aria-label="Account">
              <div class="tp-action-icon-box">
                <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <span class="tp-action-text-label">Account</span>
            </a>

            <!-- Cart -->
            <a
              href="{{ routes.cart_url }}"
              class="tp-user-action-item"
              data-drawer-toggle="drawer-cart"
              aria-label="Cart"
              aria-expanded="false"
              aria-controls="drawer-cart"
            >
              <div class="tp-action-icon-box">
                <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span class="tp-cart-count-badge" data-header-cart-count="{{ cart.item_count }}">
                  {{- cart.item_count -}}
                </span>
              </div>
              <span class="tp-action-text-label">Cart</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <!-- ── MOBILE HEADER BAR ── -->
    <div class="tp-mobile-header-bar">
      <div class="tp-mobile-header-inner">
        <!-- Hamburger -->
        <button
          type="button"
          class="header__mobile__button"
          data-drawer-toggle="hamburger"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="header-menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--time-text)" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <!-- Logo -->
        <a href="{{ routes.root_url }}" class="tp-header-logo-link">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 280 }}"
              alt="{{ shop.name }}"
              width="280"
              height="{{ 280 | divided_by: section.settings.logo.aspect_ratio | round }}"
              style="max-height: 54px; height: 54px; width: auto;"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >
          {% else %}
            <div class="tp-header-logo-serif" style="font-size: 42px;">TIME<span class="tp-trademark">™</span></div>
          {% endif %}
        </a>

        <!-- Actions -->
        <div style="display: flex; align-items: center; gap: 12px;">
          <a href="{{ routes.account_url }}" aria-label="Account" style="color: var(--time-text);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>

          <a
            href="{{ routes.cart_url }}"
            data-drawer-toggle="drawer-cart"
            aria-label="Cart"
            aria-expanded="false"
            aria-controls="drawer-cart"
            style="color: var(--time-text); position: relative;"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="tp-cart-count-badge" data-header-cart-count="{{ cart.item_count }}">
              {{- cart.item_count -}}
            </span>
          </a>
        </div>
      </div>

      <!-- Mobile Search Field -->
      <div class="tp-mobile-search-row">
        <form action="{{ routes.search_url }}" method="get" role="search" class="tp-header-search-form">
          <div class="tp-search-pill-box" data-popdown-toggle="search-popdown" style="cursor: pointer;">
            <svg class="tp-search-icon-left" viewBox="0 0 24 24" fill="none">
              <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"></line>
            </svg>
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search for pads, cups, relief..."
              class="tp-search-input-field"
              aria-label="Search"
              data-popdown-toggle="search-popdown"
            >
            <button
              type="button"
              class="tp-search-btn-submit"
              style="padding: 6px 16px;"
              data-popdown-toggle="search-popdown"
            >
              Search
            </button>
          </div>
        </form>
      </div>
    </div>
  </header>

  <!-- ── MOBILE SLIDING DRAWER MENU ── -->
  <nav
    class="drawer header__drawer display-none"
    data-drawer="hamburger"
    id="header-menu"
    aria-hidden="true"
    inert
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation menu"
  >
    <div class="drawer__content">
      <!-- Drawer Top Bar -->
      <div class="tp-drawer-header">
        <div class="tp-drawer-header-left">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 180 }}"
              alt="{{ shop.name }}"
              width="180"
              height="{{ 180 | divided_by: section.settings.logo.aspect_ratio | round }}"
              style="max-height: 38px; width: auto;"
              loading="eager"
              fetchpriority="high"
            >
          {% else %}
            <div class="tp-drawer-header-text">
              <span
                class="tp-drawer-header-title"
                style="font-family: 'Playfair Display', serif !important; font-size: 20px !important;"
                >TIME<span style="font-size: 10px; vertical-align: super;">™</span></span
              >
              <span class="tp-drawer-header-subtitle">SANITARY PADS &amp; CARE</span>
            </div>
          {% endif %}
        </div>
        <button type="button" class="tp-drawer-close-btn" data-drawer-close="hamburger" data-first-focus aria-label="Close menu">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="drawer__inner" data-drawer-scrolls>
        <!-- Search Pill Bar inside Drawer -->
        <div style="padding: 14px 14px 4px;">
          <form action="{{ routes.search_url }}" method="get" role="search" class="tp-header-search-form">
            <div
              class="tp-search-pill-box"
              style="box-shadow: 0 2px 8px rgba(123, 63, 109, 0.06); background: #FAF7FB !important; border: 1.5px solid var(--time-border) !important;"
            > 
            
              <svg
                class="tp-search-icon-left"
                viewBox="0 0 24 24"
                fill="none"
                style="width: 16px; height: 16px; stroke: var(--time-primary);"
              >   
                <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2"></line>
              </svg>
              <input
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="Search pads, cups, pain relief..."
                class="tp-search-input-field"
                aria-label="Search"
                style="font-size: 12px;"
              >
              <button type="submit" class="tp-search-btn-submit" style="padding: 4px 14px; font-size: 11.5px;">
                Search
              </button>
            </div>
          </form>
        </div>

        <!-- ── QUICK ESSENTIALS CATEGORY HORIZONTAL TRACK ── -->
        <div class="tp-drawer-essentials-card">
          <div class="tp-drawer-essentials-head">
            <span class="tp-drawer-essentials-title">
              <span style="color: var(--time-primary);">✦</span> EXPLORE PRODUCTS
            </span>
            <a href="/collections/all" class="tp-drawer-view-all"> View All <span>›</span> </a>
          </div>
          <div class="tp-drawer-quick-products-wrapper">
            <div class="tp-drawer-quick-products__track">
              {% assign rendered_product_ids = '' %}
              {% assign quick_count = 0 %}

              {% comment %} 1. If a custom collection is specified in settings {% endcomment %}
              {% if section.settings.drawer_collection != blank and collections[section.settings.drawer_collection].products.size > 0 %}
                {% for prod in collections[section.settings.drawer_collection].products limit: 12 %}
                  {% assign pid_str = prod.id | append: ',' %}
                  {% unless rendered_product_ids contains pid_str %}
                    {% assign rendered_product_ids = rendered_product_ids | append: pid_str %}
                    {% assign quick_count = quick_count | plus: 1 %}
                    <a href="{{ prod.url }}" class="tp-drawer-product-card">
                      <div class="tp-drawer-product-card__img-wrap">
                        {% if prod.featured_image != blank %}
                          <img
                            src="{{ prod.featured_image | image_url: width: 120, height: 120, crop: 'center' }}"
                            alt="{{ prod.title | escape }}"
                            class="tp-drawer-product-card__img"
                            width="60"
                            height="60"
                            loading="lazy"
                          >
                        {% endif %}
                      </div>
                      <span class="tp-drawer-product-card__title">{{ prod.title }}</span>
                    </a>
                  {% endunless %}
                {% endfor %}
              {% else %}
                {% comment %} 2. Extract products from main_links: direct products + products from collections {% endcomment %}
                {% assign main_links = linklists[main_menu_linklist].links %}
                {% if main_links.size > 0 %}
                  {% for link in main_links %}
                    {% if quick_count >= 10 %}{% break %}{% endif %}
                    {% assign link_dc = link.title | downcase %}

                    {% if link.type == 'product_link' or link.url contains '/products/' %}
                      {% assign p_obj = link.object %}
                      {% if p_obj == blank or p_obj.title == blank %}
                        {% assign p_h = link.url | split: '/products/' | last | split: '?' | first | split: '#' | first %}
                        {% assign p_obj = all_products[p_h] %}
                      {% endif %}
                      {% if p_obj != blank and p_obj.title != blank %}
                        {% assign pid_str = p_obj.id | append: ',' %}
                        {% unless rendered_product_ids contains pid_str %}
                          {% assign rendered_product_ids = rendered_product_ids | append: pid_str %}
                          {% assign quick_count = quick_count | plus: 1 %}
                          <a href="{{ p_obj.url }}" class="tp-drawer-product-card">
                            <div class="tp-drawer-product-card__img-wrap">
                              {% if p_obj.featured_image != blank %}
                                <img
                                  src="{{ p_obj.featured_image | image_url: width: 120, height: 120, crop: 'center' }}"
                                  alt="{{ p_obj.title | escape }}"
                                  class="tp-drawer-product-card__img"
                                  width="60"
                                  height="60"
                                  loading="lazy"
                                >
                              {% endif %}
                            </div>
                            <span class="tp-drawer-product-card__title">{{ p_obj.title }}</span>
                          </a>
                        {% endunless %}
                      {% endif %}
                    {% elsif link.type == 'collection_link' or link.url contains '/collections/' %}
                      {% comment %} Instead of printing the collection card, print the products of this collection! {% endcomment %}
                      {% unless link_dc contains 'all' or link.url contains '/all' %}
                        {% assign c_obj = link.object %}
                        {% if c_obj == blank or c_obj.products == blank %}
                          {% assign c_h = link.url | split: '/collections/' | last | split: '?' | first | split: '#' | first %}
                          {% assign c_obj = collections[c_h] %}
                        {% endif %}
                        {% if c_obj != blank and c_obj.products.size > 0 %}
                          {% for prod in c_obj.products limit: 3 %}
                            {% if quick_count >= 10 %}{% break %}{% endif %}
                            {% assign pid_str = prod.id | append: ',' %}
                            {% unless rendered_product_ids contains pid_str %}
                              {% assign rendered_product_ids = rendered_product_ids | append: pid_str %}
                              {% assign quick_count = quick_count | plus: 1 %}
                              <a href="{{ prod.url }}" class="tp-drawer-product-card">
                                <div class="tp-drawer-product-card__img-wrap">
                                  {% if prod.featured_image != blank %}
                                    <img
                                      src="{{ prod.featured_image | image_url: width: 120, height: 120, crop: 'center' }}"
                                      alt="{{ prod.title | escape }}"
                                      class="tp-drawer-product-card__img"
                                      width="60"
                                      height="60"
                                      loading="lazy"
                                    >
                                  {% endif %}
                                </div>
                                <span class="tp-drawer-product-card__title">{{ prod.title }}</span>
                              </a>
                            {% endunless %}
                          {% endfor %}
                        {% endif %}
                      {% endunless %}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% comment %} 3. If under 4 products, fill with store's all products {% endcomment %}
                {% if quick_count < 4 %}
                  {% assign store_products = collections['all'].products | default: collections['good-quality-sanitary-pads'].products %}
                  {% for prod in store_products limit: 10 %}
                    {% if quick_count >= 8 %}{% break %}{% endif %}
                    {% assign pid_str = prod.id | append: ',' %}
                    {% unless rendered_product_ids contains pid_str %}
                      {% assign rendered_product_ids = rendered_product_ids | append: pid_str %}
                      {% assign quick_count = quick_count | plus: 1 %}
                      <a href="{{ prod.url }}" class="tp-drawer-product-card">
                        <div class="tp-drawer-product-card__img-wrap">
                          {% if prod.featured_image != blank %}
                            <img
                              src="{{ prod.featured_image | image_url: width: 120, height: 120, crop: 'center' }}"
                              alt="{{ prod.title | escape }}"
                              class="tp-drawer-product-card__img"
                              width="60"
                              height="60"
                              loading="lazy"
                            >
                          {% endif %}
                        </div>
                        <span class="tp-drawer-product-card__title">{{ prod.title }}</span>
                      </a>
                    {% endunless %}
                  {% endfor %}
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>

        <!-- ── MAIN MENU CATEGORY ROWS WITH IMAGES ── -->
        <div style="padding: 10px 14px 4px;">
          <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--time-text-secondary); margin-bottom: 8px;">
            MAIN CATEGORIES
          </div>
        </div>

        <div class="drawer__menu" style="display: flex; flex-direction: column; gap: 2px;">
          {% if main_links.size > 0 %}
            {% for link in main_links %}
              {% assign link_dc = link.title | downcase %}
              {% assign nav_img = link.object.featured_image
                | default: link.object.featured_media.preview_image
                | default: link.object.image
                | default: link.object.products.first.featured_media.preview_image
                | default: link.object.products.first.featured_image
              %}

              {% if nav_img == blank and link.url contains '/products/' %}
                {% assign p_h = link.url | split: '/products/' | last | split: '?' | first | split: '#' | first %}
                {% assign nav_img = all_products[p_h].featured_image %}
              {% elsif nav_img == blank and link.url contains '/collections/' %}
                {% assign c_h = link.url | split: '/collections/' | last | split: '?' | first | split: '#' | first %}
                {% assign nav_img = collections[c_h].image | default: collections[c_h].products.first.featured_image %}
              {% endif %}

              {% if nav_img == blank %}
