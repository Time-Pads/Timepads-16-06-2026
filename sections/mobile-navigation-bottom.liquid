{% # Kwikpass changes - [Starts] %}
<script>
  (function () {
    function autoLogin() {
      var accountText = document.getElementById('kwik-pass-text');
      if (accountText) {
        accountText.textContent = 'Account';
      }
    }

    window.addEventListener('user-loggedin', function (event) {
      var token = event && event.detail ? event.detail.token : '';
      if (token) {
        autoLogin();
      }
    });

    function syncLoginState() {
      var userToken = localStorage.getItem('KWIKSESSIONTOKEN');
      if (userToken) {
        autoLogin();
      }
    }

    if (document.readyState === 'complete') {
      syncLoginState();
    } else {
      window.addEventListener('load', syncLoginState, { once: true });
    }
  }());
</script>
{% # Kwikpass changes - [Ends] %}







<div class="page-width desktop-hide">
  <div class="mobile-navigation-bottom is-deferred" data-mobile-sticky-nav>
    <div class="mobile-navigation-menu">

      <!-- Home Link -->
      <p>
        <a href="/" class="mobile-menu__link">
          {% render 'home-svg' %}
          <span class="mobile-menu__title">Home</span>
        </a>
      </p>

      <!-- Search Link -->
      <p class="search-icon-opening-menu" id="search-icon">
        <a href="{{ routes.search_url }}" class="mobile-menu__link" aria-label="Search">
          {% render 'search-icon' %}
          <span class="mobile-menu__title">Search</span>
        </a>
      </p>

      <!-- Center Cart Icon -->
      <div class="mobile-center-cart">
        <a class="header__mobile__button" data-drawer-toggle="drawer-cart" href="{{ routes.cart_url }}" aria-label="Cart">
          <div class="cart-circle">
            {% render 'icon-set-mod-cart' %}
          
          </div>
        </a>
      </div>

      <!-- Offers Link -->
      <p>
        <a href="https://timepads.in/collections/all" class="mobile-menu__link">
          {% render 'offers-svg' %}
          <span class="mobile-menu__title">Shop all</span>
        </a>
      </p>

      <!-- Track Order Link -->
      <p>
        <a href="https://timepads.in/apps/trackingmore" class="mobile-menu__link" aria-label="Track Order">
          {% render 'tacking-icon' %}
          <span class="mobile-menu__title">Track</span>
        </a>
      </p>

    </div>
  </div>
</div>

{% style %}
.mobile-navigation-bottom {
  background: white;
  color: black;
  position: fixed;
  bottom: 0;
  width: 100%;
  z-index: 9999;
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  transition: transform 0.3s ease-in-out, visibility 0.3s ease-in-out;
  box-shadow: rgba(0, 0, 0, 0.25) 0px 54px 55px, rgba(0, 0, 0, 0.12) 0px -12px 30px, rgba(0, 0, 0, 0.12) 0px 4px 6px, rgba(0, 0, 0, 0.17) 0px 12px 13px, rgba(0, 0, 0, 0.09) 0px -3px 5px;
}

.mobile-navigation-bottom.is-deferred {
  transform: translateY(100%);
  visibility: hidden;
}

.mobile-navigation-menu {
  display: flex;
  width: 95%;
  justify-content: space-between;
  align-items: center;
  position: relative;
  margin: auto;
}

.mobile-menu__link {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: black;
  text-decoration: none;
  font-size: 12px;
}

.mobile-menu__title {
  margin-top: 4px;
}

.mobile-center-cart {
  position: relative;
}

.cart-circle {
    background: white;
    box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;
  border-radius: 50%;
  width: 60px;
  height: 60px;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
}

.cart-circle svg {
  fill: #fff;
  width: 30px;
  height: 30px;
}
.mobile-navigation-menu svg{
    width: 20px;
    height: 17px;
}
.mobile-center-cart .header__mobile__button{
    position: absolute;
    top: -31px;
    left: -32px;
}
@media only screen and (min-width: 768px){
    .desktop-hide{
       display: none;
    }
}

{% endstyle %}

<script>
  (function () {
    function initMobileStickyNav() {
      var bottomNav = document.querySelector('[data-mobile-sticky-nav]');
      var searchIcon = document.getElementById('search-icon');
      if (!bottomNav) return;

      var lastScrollTop = window.scrollY || document.documentElement.scrollTop || 0;
      var ticking = false;

      bottomNav.classList.remove('is-deferred');

      function updateNav() {
        var scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
        bottomNav.style.transform = scrollTop > lastScrollTop ? 'translateY(0)' : 'translateY(100%)';
        bottomNav.style.visibility = 'visible';
        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        ticking = false;
      }

      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateNav);
      }, { passive: true });

      if (searchIcon) {
        searchIcon.addEventListener('click', function () {
          var navElement = document.getElementById('header-menu');
          if (!navElement) return;
          navElement.classList.toggle('drawer--visible');
          navElement.classList.toggle('display-none');
        });
      }
    }

    if (document.readyState === 'complete') {
      initMobileStickyNav();
    } else {
      window.addEventListener('load', initMobileStickyNav, { once: true });
    }
  }());
</script>


