{% # Kwikpass changes - [Starts] %}
<script>
  (function () {
    function autoLogin() {
      var accountText = document.getElementById('kwik-pass-text');
      if (accountText) {
        accountText.textContent = 'Account';
      }
    }

    window.addEventListener('user-loggedin', function (event) {
      var token = event && event.detail ? event.detail.token : '';
      if (token) {
        autoLogin();
      }
    });

    function syncLoginState() {
      var userToken = localStorage.getItem('KWIKSESSIONTOKEN');
      if (userToken) {
        autoLogin();
      }
    }

    if (document.readyState === 'complete') {
      syncLoginState();
    } else {
      window.addEventListener('load', syncLoginState, { once: true });
    }
  }());
</script>
{% # Kwikpass changes - [Ends] %}







<div class="page-width desktop-hide">
  <div class="mobile-navigation-bottom is-deferred" data-mobile-sticky-nav>
    <div class="mobile-navigation-menu">

      <!-- Home Link -->
      <p>
        <a href="/" class="mobile-menu__link">
          {% render 'home-svg' %}
          <span class="mobile-menu__title">Home</span>
        </a>
      </p>

      <!-- Search Link (Opens Mobile Menu) -->
      <p class="search-icon-opening-menu" id="search-icon">
        <button type="button" class="mobile-menu__link mobile-menu__btn-trigger" data-drawer-toggle="hamburger" aria-label="Open menu">
          {% render 'search-icon' %}
          <span class="mobile-menu__title">Search</span>
        </button>
      </p>

      <!-- Center Cart Icon -->
      <div class="mobile-center-cart">
        <a class="header__mobile__button" data-drawer-toggle="drawer-cart" href="{{ routes.cart_url }}" aria-label="Cart">
          <div class="cart-circle">
            {% render 'icon-set-mod-cart' %}
          
          </div>
        </a>
      </div>

      <!-- Offers Link -->
      <p>
        <a href="https://timepads.in/collections/all" class="mobile-menu__link">
          {% render 'offers-svg' %}
          <span class="mobile-menu__title">Shop all</span>
        </a>
      </p>

      <!-- Account Link -->
      <p>
        <a href="{{ routes.account_url }}" class="mobile-menu__link" onclick="if(window.kpHandleLogin){kpHandleLogin('/account');}" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span class="mobile-menu__title" id="kwik-pass-text">Account</span>
        </a>
      </p>

    </div>
  </div>
</div>

{% style %}
.mobile-navigation-bottom {
  background: #ffffff;
  color: #2B2117;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 6px 0 8px;
  border-top: 1px solid #ECE4DC;
  transition: transform 0.3s ease-in-out, visibility 0.3s ease-in-out;
  box-shadow: 0 -3px 16px rgba(43, 33, 23, 0.08);
  box-sizing: border-box;
}

.mobile-navigation-bottom.is-deferred {
  transform: translateY(100%);
  visibility: hidden;
}

.mobile-navigation-menu {
  display: flex;
  width: 100%;
  max-width: 480px;
  justify-content: space-around;
  align-items: center;
  position: relative;
  margin: 0 auto;
  padding: 0 8px;
  box-sizing: border-box;
}

.mobile-navigation-menu p {
  margin: 0 !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mobile-menu__link {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #2B2117;
  text-decoration: none;
  font-size: 11px;
  font-weight: 600;
  background: none;
  border: none;
  padding: 2px 6px;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.mobile-menu__link.mobile-menu__btn-trigger {
  font-family: inherit;
  outline: none;
}

.mobile-menu__title {
  margin-top: 3px;
  font-size: 11px;
  line-height: 1.1;
  color: #2B2117;
}

.mobile-center-cart {
  position: relative;
  width: 52px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mobile-center-cart .header__mobile__button {
  position: absolute;
  top: -18px;
  left: 50%;
  transform: translateX(-50%);
  text-decoration: none;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.cart-circle {
  background: #FAF8F5 !important;
  border-radius: 50% !important;
  width: 50px !important;
  height: 50px !important;
  min-width: 50px !important;
  min-height: 50px !important;
  max-width: 50px !important;
  max-height: 50px !important;
  aspect-ratio: 1 / 1 !important;
  flex-shrink: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: 0 4px 14px rgba(43, 33, 23, 0.18) !important;
  border: 2px solid #6E5233 !important;
  box-sizing: border-box !important;
}

.cart-circle svg {
  fill: none !important;
  stroke: #2B2117 !important;
  color: #2B2117 !important;
  width: 22px !important;
  height: 22px !important;
}

.mobile-navigation-menu svg {
  width: 20px;
  height: 20px;
}

@media only screen and (min-width: 768px) {
  .desktop-hide {
    display: none;
  }
}
{% endstyle %}

<script>
  (function () {
    function initMobileStickyNav() {
      var bottomNav = document.querySelector('[data-mobile-sticky-nav]');
      var searchIcon = document.getElementById('search-icon');
      if (!bottomNav) return;

      var lastScrollTop = window.scrollY || document.documentElement.scrollTop || 0;
      var ticking = false;

      bottomNav.classList.remove('is-deferred');

      function updateNav() {
        var scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
        bottomNav.style.transform = scrollTop > lastScrollTop ? 'translateY(0)' : 'translateY(100%)';
        bottomNav.style.visibility = 'visible';
        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        ticking = false;
      }

      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateNav);
      }, { passive: true });

      if (searchIcon) {
        searchIcon.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var hamburger = document.querySelector('button.header__mobile__button[data-drawer-toggle="hamburger"]');
          if (hamburger) {
            hamburger.click();
          } else {
            var drawer = document.querySelector('[data-drawer="hamburger"]') || document.getElementById('header-menu');
            if (drawer) {
              drawer.classList.add('drawer--visible');
              drawer.classList.remove('display-none');
              var underlay = drawer.querySelector('.drawer__underlay') || document.querySelector('.drawer__underlay');
              if (underlay) underlay.classList.add('underlay--visible');
              document.dispatchEvent(new CustomEvent('theme:scroll:lock', { bubbles: true }));
            }
          }
        });
      }
    }

    if (document.readyState === 'complete') {
      initMobileStickyNav();
    } else {
      window.addEventListener('load', initMobileStickyNav, { once: true });
    }
  }());
</script>


