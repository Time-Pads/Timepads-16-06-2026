{%- comment -%}
  TIMEPADS - Ultra-Fast Collection Categories Section
  Target: Lighthouse 95+ Mobile | CLS = 0 | LCP Unaffected | 0 KB JS | HTML < 4 KB | CSS < 3 KB
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign cols_desktop = section.settings.columns_desktop | default: 6
  assign cols_mobile = section.settings.columns_mobile | default: 2
  assign gap_desktop = section.settings.gap_desktop | default: 28
  assign gap_mobile = section.settings.gap_mobile | default: 18
  assign pad_top = section.settings.padding_top | default: 40
  assign pad_bottom = section.settings.padding_bottom | default: 40
  assign bg_color = section.settings.bg_color | default: '#FAF7FB'

  assign categories = section.blocks
-%}

{%- style -%}
  .tp-categories-{{ section.id }} {
    --tp-cat-bg: {{ bg_color }};
    --tp-cat-cols-desktop: {{ cols_desktop }};
    --tp-cat-cols-mobile: {{ cols_mobile }};
    --tp-cat-gap-desktop: {{ gap_desktop }}px;
    --tp-cat-gap-mobile: {{ gap_mobile }}px;
    --tp-cat-pt: {{ pad_top }}px;
    --tp-cat-pb: {{ pad_bottom }}px;
  }
{%- endstyle -%}

<section
  id="shopify-section-categories-{{ section.id }}"
  class="tp-categories tp-categories-{{ section.id }}"
  aria-label="Collection Categories"
>
  <div class="tp-categories__container">
    
    {%- if heading != blank or subheading != blank -%}
      <div class="tp-categories__header">
        {%- if heading != blank -%}
          {%- assign heading_words = heading | split: ' ' -%}
          <h2 class="tp-categories__heading">
            {%- for word in heading_words -%}
              {%- if forloop.last -%}
                <span style="color: #7B3F6D;">{{ word }}</span>
              {%- else -%}
                {{ word }} 
              {%- endif -%}
            {%- endfor -%}
          </h2>
        {%- endif -%}

      </div>
    {%- endif -%}

    <ul class="tp-categories__grid" role="list">
      {%- if categories.size > 0 -%}
        {%- for block in categories -%}
          {%- liquid
            assign cat_collection = collections[block.settings.collection]
            
            assign cat_img = block.settings.header_image | default: block.settings.collection_image | default: block.settings.image | default: cat_collection.featured_image
            assign cat_title = block.settings.header_title | default: block.settings.tab_label | default: block.settings.collection_name | default: block.settings.title | default: cat_collection.title
            
            assign cat_url = block.settings.collection_url | default: block.settings.url | default: cat_collection.url | default: '#'
            assign badge_text = block.settings.coming_soon_text | default: block.settings.badge_text
            assign badge_color = block.settings.badge_color | default: '#FF4A4A'

            assign is_eager = false
            if forloop.index <= 2
              assign is_eager = true
            endif
          -%}

          {%- if cat_title != blank or cat_img != blank -%}
            <li class="tp-categories__item" {{ block.shopify_attributes }}>
              <a href="{{ cat_url }}" class="tp-categories__card" aria-label="{{ cat_title | escape }}">
                
                <div class="tp-categories__image-wrapper">
                  {%- if badge_text != blank -%}
                    {% comment %} <span class="tp-categories__badge" style="background-color: {{ badge_color }};">
                      {{ badge_text }}
                    </span> {% endcomment %}
                  {%- endif -%}

                  {%- if cat_img != blank -%}
                    <picture class="tp-categories__picture">
                      <source
                        type="image/webp"
                        srcset="
                          {{ cat_img | image_url: width: 110, height: 110, crop: 'center', format: 'webp' }} 110w,
                          {{ cat_img | image_url: width: 160, height: 160, crop: 'center', format: 'webp' }} 160w,
                          {{ cat_img | image_url: width: 320, height: 320, crop: 'center', format: 'webp' }} 320w
                        "
                        sizes="(max-width: 767px) 110px, 160px"
                      >
                      <img
                        src="{{ cat_img | image_url: width: 160, height: 160, crop: 'center' }}"
                        alt="{{ cat_img.alt | default: cat_title | escape }}"
                        class="tp-categories__img"
                        width="160"
                        height="160"
                        loading="{% if is_eager %}eager{% else %}lazy{% endif %}"
                        fetchpriority="{% if is_eager %}high{% else %}low{% endif %}"
                        decoding="async"
                      >
                    </picture>
                  {%- else -%}
                    <div class="tp-categories__placeholder"></div>
                  {%- endif -%}
                </div>

         
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Default Items -->
        {%- for i in (1..6) -%}
          <li class="tp-categories__item">
            <a href="#" class="tp-categories__card">
              <div class="tp-categories__image-wrapper">
                <div class="tp-categories__placeholder"></div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

  </div>
</section>

<style>
  .tp-categories,
  .tp-categories-{{ section.id }} {
    background-color: var(--tp-cat-bg, #ffffff);
    padding-top: var(--tp-cat-pt, 30px);
    padding-bottom: var(--tp-cat-pb, 30px);
    width: 100%;
    font-family: 'Poppins', sans-serif;
    box-sizing: border-box;
  }

  .tp-categories .tp-categories__container,
  .tp-categories-{{ section.id }} .tp-categories__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .tp-categories .tp-categories__header,
  .tp-categories-{{ section.id }} .tp-categories__header {
    text-align: center;
    margin-bottom: 20px;
  }

  .tp-categories .tp-categories__heading,
  .tp-categories-{{ section.id }} .tp-categories__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 700;
    color: #241D25;
    margin: 0 0 12px 0;
    line-height: 1.2;
    text-align: center;
  }
  @media (min-width: 768px) {
    .tp-categories .tp-categories__heading,
    .tp-categories-{{ section.id }} .tp-categories__heading {
      font-size: 38px;
    }
  }

  /* Grid Styling */
  .tp-categories .tp-categories__grid,
  .tp-categories-{{ section.id }} .tp-categories__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    box-sizing: border-box;
  }

  .tp-categories .tp-categories__item,
  .tp-categories-{{ section.id }} .tp-categories__item {
    flex: 0 0 auto;
    width: 140px;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }

  .tp-categories .tp-categories__card,
  .tp-categories-{{ section.id }} .tp-categories__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    text-align: center;
    width: 100%;
  }

  .tp-categories .tp-categories__image-wrapper,
  .tp-categories-{{ section.id }} .tp-categories__image-wrapper {
    position: relative;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    box-sizing: border-box;
    transition: transform 0.2s ease;
  }

  .tp-categories .tp-categories__picture,
  .tp-categories .tp-categories__img,
  .tp-categories-{{ section.id }} .tp-categories__picture,
  .tp-categories-{{ section.id }} .tp-categories__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .tp-categories .tp-categories__placeholder,
  .tp-categories-{{ section.id }} .tp-categories__placeholder {
    width: 100%;
    height: 100%;
    background-color: #F3F4F6;
    border-radius: 50%;
  }

  @media (min-width: 1024px) {
    .tp-categories .tp-categories__card:hover .tp-categories__image-wrapper,
    .tp-categories-{{ section.id }} .tp-categories__card:hover .tp-categories__image-wrapper {
      transform: scale(1.04);
    }
  }

  /* ── Mobile Rules (max-width: 767px) ── */
  @media screen and (max-width: 767px) {
    .tp-categories,
    .tp-categories-{{ section.id }} {
      padding-top: 14px !important;
      padding-bottom: 0px !important;
    }
    .tp-categories .tp-categories__container,
    .tp-categories-{{ section.id }} .tp-categories__container {
      padding: 0 !important;
      max-width: 100% !important;
    }
    .tp-categories .tp-categories__header,
    .tp-categories-{{ section.id }} .tp-categories__header {
      padding: 0 16px !important;
      margin-bottom: 12px !important;
    }
    .tp-categories .tp-categories__heading,
    .tp-categories-{{ section.id }} .tp-categories__heading {
      font-size: 20px !important;
      font-weight: 700 !important;
      letter-spacing: -0.01em !important;
      margin: 0 !important;
      line-height: 1.2 !important;
    }
    .tp-categories .tp-categories__grid,
    .tp-categories-{{ section.id }} .tp-categories__grid {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: flex-start !important;
      align-items: center !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      padding: 4px 16px 8px 16px !important;
      gap: 14px !important;
      scrollbar-width: none !important;
      scroll-padding: 0 16px !important;
    }
    .tp-categories .tp-categories__grid::-webkit-scrollbar,
    .tp-categories-{{ section.id }} .tp-categories__grid::-webkit-scrollbar {
      display: none !important;
      height: 0 !important;
      width: 0 !important;
    }
    .tp-categories .tp-categories__item,
    .tp-categories-{{ section.id }} .tp-categories__item {
      flex: 0 0 100px !important;
      width: 100px !important;
      scroll-snap-align: start !important;
      display: flex !important;
      justify-content: center !important;
    }
    .tp-categories .tp-categories__image-wrapper,
    .tp-categories-{{ section.id }} .tp-categories__image-wrapper {
      width: 96px !important;
      height: 96px !important;
      margin: 0 auto !important;
    }
  }

  /* Badge Styling */
  /* .tp-categories-{{ section.id }} .tp-categories__badge {
    position: absolute;
    top: 4px;
    right: 4px;
    background-color: #FF4A4A;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    line-height: 1.2;
    z-index: 2;
    white-space: nowrap;
  } */

  /* Category Title */


</style>

{% schema %}
{
  "name": "Collection Categories",
  "tag": "section",
  "class": "tp-collection-categories-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our clinically tested women's wellness essentials"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Desktop Columns",
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Mobile Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Desktop Gap",
      "default": 28
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 18
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7FB"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "header_image",
          "label": "Collection Circular Image"
        },
        {
          "type": "text",
          "id": "header_title",
          "label": "Category Name"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Category Link (Overrides Collection URL)"
        },
        {
          "type": "text",
          "id": "coming_soon_text",
          "label": "Badge Text (e.g. New, Best Seller)"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Color",
          "default": "#FF4A4A"
        }
      ]
    },
    {
      "type": "category",
      "name": "Category Item (Alt)",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Category Link"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Categories"
    }
  ]
}
{% endschema %}
