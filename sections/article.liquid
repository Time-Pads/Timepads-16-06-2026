        document.addEventListener("DOMContentLoaded", () => {
          const content = document.querySelector(".blog__article__content.rte");
          const toc = document.getElementById("tp-article-toc");
          const grid = document.getElementById("tp-toc-grid");
          if (!content || !toc || !grid) return;
          
          const h2s = Array.from(content.querySelectorAll("h2"));
          if (h2s.length < 2) {
            toc.style.display = "none";
            return;
          }
          
          const headingsData = [];
          h2s.forEach((h2, index) => {
            let nextH2 = h2s[index + 1];
            const subheadings = [];
            let sib = h2.nextElementSibling;
            while (sib && sib !== nextH2) {
              if (sib.tagName.toLowerCase() === 'h3') {
                subheadings.push(sib);
              } else {
                const innerH3s = sib.querySelectorAll("h3");
                innerH3s.forEach(inner => subheadings.push(inner));
              }
              sib = sib.nextElementSibling;
            }
            
            headingsData.push({
              element: h2,
              subheadings: subheadings
            });
          });

          headingsData.forEach((item, index) => {
            const heading = item.element;
            const number = index + 1;
            
            let id = heading.id;
            if (!id) {
              id = "toc-heading-" + index;
              heading.id = id;
            }
            
            const itemDiv = document.createElement("div");
            itemDiv.className = "tp-toc-item";
            
            const iconSvg = getIconForHeading(heading.textContent);
            
            const cardLink = document.createElement("a");
            cardLink.href = "#" + id;
            cardLink.className = "tp-toc-card";
            cardLink.addEventListener("click", (e) => {
              e.preventDefault();
              heading.scrollIntoView({ behavior: "smooth" });
              history.pushState(null, null, "#" + id);
            });
            
            cardLink.innerHTML = `
              <div class="tp-toc-number">${number}</div>
              <div class="tp-toc-icon-wrapper">${iconSvg}</div>
              <span class="tp-toc-title">${heading.textContent}</span>
              <span class="tp-toc-chevron">&rsaquo;</span>
            `;
            
            itemDiv.appendChild(cardLink);
            
            if (item.subheadings.length > 0) {
              const timelineDiv = document.createElement("div");
              timelineDiv.className = "tp-toc-subitems-timeline";
              
              item.subheadings.forEach((sub, subIndex) => {
                const subNumber = `${number}.${subIndex + 1}`;
                let subId = sub.id;
                if (!subId) {
                  subId = `toc-subheading-${index}-${subIndex}`;
                  sub.id = subId;
                }
                
                const subItemDiv = document.createElement("div");
                subItemDiv.className = "tp-toc-subitem";
                
                const subLink = document.createElement("a");
                subLink.href = "#" + subId;
                subLink.className = "tp-toc-subitem-link";
                subLink.textContent = sub.textContent;
                subLink.addEventListener("click", (e) => {
                  e.preventDefault();
                  sub.scrollIntoView({ behavior: "smooth" });
                  history.pushState(null, null, "#" + subId);
                });
                
                subItemDiv.innerHTML = `<span class="tp-toc-subitem-num">${subNumber}</span>`;
                subItemDiv.appendChild(subLink);
                timelineDiv.appendChild(subItemDiv);
              });
              
              itemDiv.appendChild(timelineDiv);
            }
            
            grid.appendChild(itemDiv);
          });
          
          toc.style.display = "block";
        });
        </script>

        {% if blog.next_article or blog.previous_article %}
          <p class="clearfix">
            {% if blog.previous_article %}
              <span class="left">
                <a href="{{ blog.previous_article }}" class="btn--soft">
                  &larr; {{ 'blogs.article.older_post' | t }}
                </a>
              </span>
            {% endif %}
            {% if blog.next_article %}
              <span class="right">
                <a href="{{ blog.next_article }}" class="btn--soft">
                  {{ 'blogs.article.newer_post' | t }} &rarr;
                </a>
              </span>
            {% endif %}
          </p>
        {% endif %}

        {% if blog.comments_enabled? %}
          {% paginate article.comments by 10 %}
            {% comment %}
              #Comments is required, it is used as an anchor link by Shopify.
            {% endcomment %}
            <div class="blog__comments mt-r11" id="Comments">

              {% if article.comments_count > 0 %}
                <p class="kicker-flourished text-left">{{ 'blogs.comments.comments_with_count' | t: count: number_of_comments }}</p>
              {% endif %}

              {% if comment and comment.created_at %}
                <p class="note form-success">
                  {% if blog.moderated? %}
                    {{ 'blogs.comments.success_moderated' | t }}
                  {% else %}
                    {{ 'blogs.comments.success' | t }}
                  {% endif %}
                </p>
              {% endif %}

              {% if number_of_comments > 0 %}
                <ul>
                  {% comment %}
                    If a comment was just submitted with no blank field, show it.
                  {% endcomment %}
                  {% if comment and comment.created_at and blog.moderated? %}
                    <li id="{{ comment.id }}" class="comment first{% if article.comments_count == 0 %} last{% endif %}">
                        {% render 'comment', comment: comment %}
                    </li>
                  {% endif %}

                  {% comment %}
                    Showing the rest of the comments.
                  {% endcomment %}
                  {% for comment in article.comments %}
                    <li id="{{ comment.id }}" class="comment{% unless number_of_comments > article.comments_count %}{% if forloop.first %} first{% endif %}{% endunless %}{% if forloop.last %} last {% endif %}">
                        {% render 'comment', comment: comment %}
                    </li>
                  {% endfor %}
                </ul>

                {% if paginate.pages > 1 %}
                  <hr class="hr--clear">
                  <div class="text-center">
                    {% render 'pagination-custom', paginate: paginate %}
                  </div>
                {% endif %}

              {% endif %}


